DB_PASSWORD=123
DB_DSN=postgresql://postgres:[YOUR-PASSWORD]@db.foo.supabase.co:5432/postgres
# Публичные ключи сайта (тикет 09): видны всем в JS, вписывает человек.
# Реальные значения — только в локальный .env (в gitignore), сюда — лишь плейсхолдеры.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
