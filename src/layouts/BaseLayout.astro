---
import '../styles/global.css';
import GambaModal from '../components/GambaModal.astro';
import AuthButton from '../components/AuthButton.astro';

interface Props {
  title?: string;
}

const { title = 'AlysQueZone — БИРЖА ПРИВЕТОВ' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-void text-milk min-h-screen antialiased">
    <!-- Фон-арт F1 (тикет 37): широкий webp cover center + кремовая вуаль 0.88, контент поверх. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}bg/sunflowers.webp')`}
    >
    </div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-[rgba(255,246,191,0.88)]">
    </div>
    <header class="sticky top-0 z-10 border-b border-black/10 bg-bar/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3">
        <a href={`${base}`} class="text-lg font-black tracking-tight uppercase">
          Alys<span class="text-stream">Que</span>Zone<span class="text-blush">.</span>
        </a>
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-gamba-button
            class="cursor-pointer rounded-full border border-stream/50 px-5 py-2 text-sm font-extrabold text-stream uppercase hover:bg-stream/10"
          >
            гамба на пивкойны
          </button>
          <div class="flex items-center gap-2 rounded-full border border-pivko/50 bg-void px-3 py-1 text-sm font-bold">
            <span class="text-melon">◉</span>
            <span data-wallet-balance>1000</span>
            <span class="text-mist/70">Пивкойнов</span>
          </div>
        </div>
        <div id="topbar-right" class="flex flex-wrap items-center gap-2">
          <AuthButton />
        </div>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <!-- Гамба-рулетка (тикет 32): кнопка в шапке открывает модалку-колесо. -->
    <GambaModal />
    <script>
      import { getBalance, BALANCE_KEY } from '../lib/wallet.ts';
      import { getSupabase } from '../lib/supabase.ts';
      import { fetchMyBalance, getBalanceUid, subscribeMyBalance } from '../lib/balance.ts';
      import { initOutbidNotice } from '../lib/outbid-notice.ts';
      initOutbidNotice();
      // Баланс в шапке (тикет 07, expand): у вошедшего Чатерса — из БД
      // (таблица profiles, live-подписка), у гостя — локальный кошелёк.
      // Локальный wallet.ts пока жив и умрёт в тикете 11.
      let unsubscribeDb: (() => void) | null = null;
      const paint = (value: number) => {
        document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
          el.textContent = String(value);
        });
      };
      const renderLocal = () => paint(getBalance());
      async function renderDbOrLocal(): Promise<void> {
        const db = await fetchMyBalance();
        if (db !== null) {
          paint(db);
          return;
        }
        // Гость / счёт ещё не создан триггером / офлайн — деньги целы,
        // показываем локальную косметику как раньше.
        renderLocal();
      }
      async function resubscribe(): Promise<void> {
        unsubscribeDb?.();
        unsubscribeDb = null;
        await renderDbOrLocal();
        const uid = await getBalanceUid();
        if (!uid || !getSupabase()) return;
        unsubscribeDb = subscribeMyBalance(uid, (balance) => paint(balance));
      }
      void resubscribe();
      getSupabase()?.auth.onAuthStateChange(() => {
        void resubscribe();
      });
      window.addEventListener('storage', (e) => {
        if (e.key === BALANCE_KEY) void renderDbOrLocal();
      });

    </script>
  </body>
</html>
