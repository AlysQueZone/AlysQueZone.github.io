---
import '../styles/global.css';
// Gamba-стиль C: шрифты self-hosted через Fontsource (CDN в песочнице
// не грузится, а так пиксели доедут и в офлайне). Press Start 2P —
// только 400 (других кеглей у шрифта нет), Rubik — рабочие 400–900.
import '@fontsource/press-start-2p/latin-400.css';
import '@fontsource/press-start-2p/cyrillic-400.css';
import '@fontsource/rubik/latin-400.css';
import '@fontsource/rubik/latin-700.css';
import '@fontsource/rubik/latin-800.css';
import '@fontsource/rubik/latin-900.css';
import '@fontsource/rubik/cyrillic-400.css';
import '@fontsource/rubik/cyrillic-700.css';
import '@fontsource/rubik/cyrillic-800.css';
import '@fontsource/rubik/cyrillic-900.css';
import GambaModal from '@/components/GambaModal.astro';
import DailyLogin from '@/components/DailyLogin.astro';
import AuthButton from '@/components/AuthButton.astro';
import { assertSupabaseConfigured } from '@/lib/supabase';
import { GAMBA_EMOTE_URL } from '@/lib/emotes';
import { COMMISSION_RATE, ROYALTY_PURCHASES, ROYALTY_RATE, SUBMISSION_BONUS } from '@/lib/prices';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AlysQueZone — БИРЖА ПРИВЕТОВ',
  description = 'Шуточная биржа приветов Twitch-канала alysque: выбирай привет, забирай за Пивкойны и качай лот в гамбе.',
} = Astro.props;
const base = import.meta.env.BASE_URL;

// Скелетон бегущей строки: бары, одинаковые в обеих половинах дорожки —
// иначе рвётся бесшовный цикл. Скрипт подменяет их логом сделок или правилами.
const MQ_SKELETON = Array.from(
  { length: 16 },
  () =>
    '<span class="skeleton-block skeleton-block-cream mr-3 inline-block h-2 w-40 align-middle"></span>'
).join('');

// Правила для бегущей строки (когда сделок нет): те же ставки, что в окне
// «Правила биржи», из зеркал lib/prices.ts — витрина не врёт про математику.
const MQ_COMMISSION_PCT = Math.round(COMMISSION_RATE * 100);
const MQ_ROYALTY_PCT = Math.round(ROYALTY_RATE * 100);
const MQ_BURN_PCT = MQ_COMMISSION_PCT - MQ_ROYALTY_PCT;
const MQ_RULES =
  `Комиссия биржи ${MQ_COMMISSION_PCT}% (${MQ_BURN_PCT}% сгорает + ${MQ_ROYALTY_PCT}% автору) ★ ` +
  `перекуп +10% ×15, дальше +1 ★ за принятый привет +${SUBMISSION_BONUS} и ${MQ_ROYALTY_PCT}% ` +
  `с первых ${ROYALTY_PURCHASES} перекупов ★ гамба до x10 · 20 спинов в день ★ вход 200/200/250 ★`;

// Билд-гейт: без PUBLIC_SUPABASE_* сайт нерабочий (витрина — проекция БД).
assertSupabaseConfigured();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <!-- Превью для чата: ссылку кидают в Twitch, без OG она выглядит пустой. -->
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AlysQueZone" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? '')} />
    <meta property="og:image" content={new URL(`${base}bg/sunflowers.webp`, Astro.site ?? '')} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-void text-milk min-h-screen antialiased">
    <!-- Skip-link: шапка липкая и кнопок в ней много — с клавиатуры к контенту
         можно прыгнуть сразу. Виден только на фокусе. -->
    <a
      href={`${base}#main`}
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:border-[3px] focus:border-milk focus:bg-panel focus:px-4 focus:py-2 focus:font-bold"
    >
      К содержимому
    </a>
    <!-- Фон-арт F1 (тикет 37): широкий webp cover center + кремовая вуаль 0.88, контент поверх. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}bg/sunflowers.webp')`}
    ></div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-void/88"></div>
    <header class="sticky top-0 z-10 border-b-4 border-milk bg-bar/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3">
        <a href={`${base}`} class="flex min-h-11 items-center">
          <span class="font-display text-base tracking-wide uppercase sm:text-lg">
            Alys<span class="text-stream">Que</span>Zone<span class="text-blush">.</span>
          </span>
        </a>
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-gamba-button
            class="btn-arcade btn-arcade-ghost animate-blink px-4 py-2 text-sm"
          >
            <!-- Эмоут декоративный: текстом рядом сказано то же самое.
                 -my-1 держит внешнюю высоту в строке текста: эмоут крупнее
                 (28px), а кнопка остаётся 44px. -->
            <img
              src={GAMBA_EMOTE_URL}
              alt=""
              width="28"
              height="28"
              loading="eager"
              class="h-7 w-7 -my-1 object-contain"
            />
            гамба на пивкойны
          </button>
          <div data-wallet-chip class="hidden chip-arcade bg-void px-4 py-2 text-sm font-black">
            <span aria-hidden="true">🍺</span>
            <span data-wallet-balance>—</span>
            <span class="text-mist">Пивкойнов</span>
          </div>
          <!-- Ежедневный вход (тикет 13): автовыдача без кнопок — только всплывающее уведомление о факте. -->
          <DailyLogin />
        </div>
        <div id="topbar-right" class="flex flex-wrap items-center gap-2">
          <AuthButton />
        </div>
      </div>
      <!-- Бегущая строка-лог (ребаланс): живой хвост ~10 последних сделок
        из purchases через realtime-подписку. До первого ответа — скелетон;
        сделок нет/БД недоступна — честная строка живых правил (те же цифры,
        что в окне «Правила биржи»). Подмена идёт под fade, см. скрипт. -->
      <div class="marquee border-t-2 border-milk/20 bg-milk py-1" aria-hidden="true">
        <p class="marquee-track font-display text-[9px] text-cream uppercase" data-deal-log-track>
          <span class="mx-4" data-deal-log-a set:html={MQ_SKELETON} />
          <span class="mx-4" data-deal-log-b set:html={MQ_SKELETON} />
        </p>
      </div>
      <template data-deal-log-rules>{MQ_RULES}</template>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <!-- Гамба-рулетка (тикет 32): кнопка в шапке открывает модалку-колесо. -->
    <GambaModal />
    <!-- Инфо-плашка: звук + VPN, снизу на всех страницах, только крестик, память в localStorage. -->
    <div
      id="info-plaska"
      class="fixed inset-x-0 bottom-0 z-50 hidden border-t-4 border-milk bg-bar pb-[env(safe-area-inset-bottom)]"
      role="note"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
        <p class="text-sm font-bold text-milk">
          🔊 Включи звук
          <br class="sm:hidden" />
          <span class="sm:ml-3">🛡️ Без VPN часть штук может не грузиться</span>
        </p>
        <button
          type="button"
          id="info-plaska-close"
          aria-label="Закрыть подсказку"
          class="btn-arcade btn-arcade-ghost min-w-11 shrink-0 px-3 py-1 text-sm"
        >
          ✕
        </button>
      </div>
    </div>
    <script>
      const PLASKA_KEY = 'alysque:info-plaska-dismissed';
      const plaska = document.getElementById('info-plaska');
      const plaskaClose = document.getElementById('info-plaska-close');
      try {
        if (plaska && !localStorage.getItem(PLASKA_KEY)) {
          plaska.classList.remove('hidden');
          document.documentElement.dataset.plaska = 'on';
        }
      } catch {
        plaska?.classList.remove('hidden');
        document.documentElement.dataset.plaska = 'on';
      }
      plaskaClose?.addEventListener('click', () => {
        plaska?.classList.add('hidden');
        delete document.documentElement.dataset.plaska;
        try {
          localStorage.setItem(PLASKA_KEY, '1');
        } catch {
          // приватный режим — просто скрыли до перезагрузки
        }
      });
    </script>
    <script>
      import { getSupabase, getSessionUid, isSupabaseConfigured } from '@/lib/supabase';
      import { fetchMyBalance, subscribeMyBalance } from '@/lib/balance';
      import { initOutbidNotice } from '@/lib/outbid-notice';
      initOutbidNotice();
      // Бегущая строка-лог (ребаланс, тикет 06): последние ~10 сделок из
      // purchases (публичный SELECT) через realtime-подписку на INSERT.
      // В разметке — скелетон; лог (или правила, если сделок нет) приходит
      // подменой через fade, чтобы смена ширины дорожки не давала рывка.
      const dealTrack = document.querySelector('[data-deal-log-track]');
      const dealA = document.querySelector('[data-deal-log-a]');
      const dealB = document.querySelector('[data-deal-log-b]');
      const rulesTpl = document.querySelector('[data-deal-log-rules]');
      const RULES_TEXT = (() => {
        const raw = rulesTpl instanceof HTMLTemplateElement ? rulesTpl.content.textContent : '';
        return (raw ?? '').replace(/\s+/g, ' ').trim() || 'Биржа приветов';
      })();

      let lastDealText = '';
      let swapToken = 0;
      let refreshingDeals = false;

      // Половина дорожки набирается копиями строки так, чтобы перекрыть
      // вьюпорт: иначе на широком экране (или при 1–2 сделках) в конце цикла
      // виден провал `bg-milk`.
      const copyOf = (text: string): string => `${text} ★ `;
      const copiesFor = (one: number): number =>
        one > 0 ? Math.max(1, Math.ceil((window.innerWidth + 32) / one)) : 1;

      // Скорость в px/с не зависит от длины контента: длительность цикла
      // считаем от измеренной половины дорожки, иначе длинный лог «убегает»,
      // а короткие правила еле ползут. ~100 px/с — прежний темп лога.
      const SPEED = 100;
      function applyTrackSpeed(): void {
        if (!(dealTrack instanceof HTMLElement)) return;
        const half = dealTrack.scrollWidth / 2;
        if (half > 0) dealTrack.style.animationDuration = `${half / SPEED}s`;
      }

      /**
       * Перерисовать обе половины: измерить одну копию и добить её до ширины
       * вьюпорта. Контент — только `textContent`: ник из JWT-метаданных правит
       * сам пользователь, в `innerHTML` ему нельзя.
       */
      function paintTrack(text: string): void {
        if (
          !(dealTrack instanceof HTMLElement) ||
          !(dealA instanceof HTMLElement) ||
          !(dealB instanceof HTMLElement)
        ) {
          return;
        }
        const one = copyOf(text);
        dealA.textContent = one;
        dealB.textContent = one;
        // Перезапуск под нулевой прозрачностью: ширина сменилась — рывка нет.
        dealTrack.style.animation = 'none';
        void dealTrack.offsetWidth;
        const half = one.repeat(copiesFor(dealTrack.scrollWidth / 2));
        dealA.textContent = half;
        dealB.textContent = half;
        dealTrack.style.animation = '';
        // Длительность — после возврата shorthand: `animation = ''` сбрасывает
        // и inline-duration, если поставить её раньше.
        applyTrackSpeed();
      }

      function swapTrack(text: string): void {
        if (text === lastDealText) return;
        if (!(dealTrack instanceof HTMLElement)) return;
        lastDealText = text;
        const token = (swapToken += 1);
        dealTrack.style.opacity = '0';
        window.setTimeout(() => {
          if (token !== swapToken) return;
          paintTrack(text);
          window.requestAnimationFrame(() => {
            dealTrack.style.opacity = '1';
          });
        }, 260);
      }

      async function refreshDealLog(): Promise<void> {
        if (!(dealTrack instanceof HTMLElement) || refreshingDeals) return;
        refreshingDeals = true;
        try {
          let line = '';
          if (isSupabaseConfigured()) {
            try {
              const sb = getSupabase();
              if (sb) {
                const { data, error } = await sb
                  .from('purchases')
                  .select('price_paid,buyer_login,created_at,lots(slug,title)')
                  .order('created_at', { ascending: false })
                  .order('id', { ascending: false })
                  .limit(10);
                if (!error && Array.isArray(data)) {
                  line = (data as unknown as Record<string, unknown>[])
                    .flatMap((row) => {
                      const price = Number(row['price_paid']);
                      const by = row['buyer_login'];
                      const lot = row['lots'] as unknown as Record<string, unknown> | null;
                      const title = lot && typeof lot['title'] === 'string' ? lot['title'] : null;
                      if (!Number.isFinite(price) || typeof by !== 'string' || !title) return [];
                      return [`${by} забрал «${title}» за ${price} 🍺`];
                    })
                    .join(' ★ ');
                }
              }
            } catch {
              // лог — best effort, падаем в правила
            }
          }
          // Пустой лог — честный пустой стейт: живые правила биржи.
          swapTrack(line || RULES_TEXT);
        } finally {
          refreshingDeals = false;
        }
      }

      if (isSupabaseConfigured()) {
        void refreshDealLog();
        try {
          getSupabase()
            ?.channel('alysque:deal-log')
            .on(
              'postgres_changes',
              { event: 'INSERT', schema: 'public', table: 'purchases' },
              () => void refreshDealLog()
            )
            .subscribe();
        } catch {
          // Realtime недоступен — виден последний подтянутый хвост
        }
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) void refreshDealLog();
        });
      } else {
        // Без ключей БД нет: сразу правила, скелетон не оставляем.
        swapTrack(RULES_TEXT);
      }
      // Скелетон тоже должен идти с той же скоростью, что и контент.
      applyTrackSpeed();
      // Ширина дорожки зависит от Press Start 2P: до загрузки шрифта замер врёт.
      void document.fonts?.ready.then(() => applyTrackSpeed());
      // Вьюпорт изменился — пересобрать половину под новую ширину и скорость.
      let speedRaf = 0;
      window.addEventListener('resize', () => {
        if (speedRaf) return;
        speedRaf = window.requestAnimationFrame(() => {
          speedRaf = 0;
          if (lastDealText) paintTrack(lastDealText);
          else applyTrackSpeed();
        });
      });
      // Баланс в шапке (тикет 11, contract): только из БД (таблица profiles,
      // live-подписка). Гостю чип не показываем вообще; залогиненному без
      // строки (счёт ещё не создан триггером / офлайн) — прочерк, деньги целы.
      // Локальный кошелёк удалён, межвкладочного storage-синка больше нет —
      // тик даёт Realtime.
      let unsubscribeDb: (() => void) | null = null;
      const setChipVisible = (visible: boolean): void => {
        document.querySelectorAll('[data-wallet-chip]').forEach((el) => {
          el.classList.toggle('hidden', !visible);
          el.classList.toggle('flex', visible);
        });
      };
      const paint = (value: string) => {
        document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
          el.textContent = value;
          el.removeAttribute('title');
        });
      };
      async function renderDbOrGuest(): Promise<void> {
        const db = await fetchMyBalance();
        if (db !== null) {
          paint(String(db));
          setChipVisible(true);
          return;
        }
        // Различаем гостя и залогиненного без строки: гостю чип прячем,
        // своему — показываем прочерк (деньги целы, строка подъедет).
        const uid = await getSessionUid();
        if (!uid) {
          setChipVisible(false);
          return;
        }
        paint('—');
        setChipVisible(true);
      }
      async function resubscribe(): Promise<void> {
        unsubscribeDb?.();
        unsubscribeDb = null;
        await renderDbOrGuest();
        const uid = await getSessionUid();
        if (!uid || !getSupabase()) return;
        unsubscribeDb = subscribeMyBalance(uid, (balance) => paint(String(balance)));
      }
      void resubscribe();
      getSupabase()?.auth.onAuthStateChange(() => {
        void resubscribe();
      });
    </script>
  </body>
</html>
