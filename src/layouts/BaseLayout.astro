---
import '../styles/global.css';
// Gamba-стиль C: шрифты self-hosted через Fontsource (CDN в песочнице
// не грузится, а так пиксели доедут и в офлайне). Press Start 2P —
// только 400 (других кеглей у шрифта нет), Rubik — рабочие 400–900.
import '@fontsource/press-start-2p/latin-400.css';
import '@fontsource/press-start-2p/cyrillic-400.css';
import '@fontsource/rubik/latin-400.css';
import '@fontsource/rubik/latin-700.css';
import '@fontsource/rubik/latin-800.css';
import '@fontsource/rubik/latin-900.css';
import '@fontsource/rubik/cyrillic-400.css';
import '@fontsource/rubik/cyrillic-700.css';
import '@fontsource/rubik/cyrillic-800.css';
import '@fontsource/rubik/cyrillic-900.css';
import GambaModal from '../components/GambaModal.astro';
import DailyLogin from '../components/DailyLogin.astro';
import AuthButton from '../components/AuthButton.astro';

interface Props {
  title?: string;
}

const { title = 'AlysQueZone — БИРЖА ПРИВЕТОВ' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-void text-milk min-h-screen antialiased">
    <!-- Фон-арт F1 (тикет 37): широкий webp cover center + кремовая вуаль 0.88, контент поверх. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}bg/sunflowers.webp')`}
    >
    </div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-[rgba(255,246,191,0.88)]">
    </div>
    <header class="sticky top-0 z-10 border-b-4 border-milk bg-bar/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-3">
        <a href={`${base}`} class="font-display text-xs tracking-wide uppercase">
          Alys<span class="text-stream">Que</span>Zone<span class="text-blush">.</span>
        </a>
        <div class="flex flex-wrap items-center gap-2">
          <button
            type="button"
            data-gamba-button
            class="btn-arcade btn-arcade-ghost animate-blink px-4 py-2 text-xs"
          >
            🎰 гамба на пивкойны
          </button>
          <div data-wallet-chip class="hidden items-center gap-2 border-[3px] border-milk bg-void px-3 py-1 text-sm font-black shadow-[3px_3px_0_rgb(66_32_6/0.9)]">
            <span class="text-melon">◉</span>
            <span data-wallet-balance>—</span>
            <span class="text-mist/70">Пивкойнов</span>
          </div>
          <!-- Ежедневный вход (тикет 13): автовыдача без кнопок — только всплывающее уведомление о факте. -->
          <DailyLogin />
        </div>
        <div id="topbar-right" class="flex flex-wrap items-center gap-2">
          <AuthButton />
        </div>
      </div>
      <!-- Бегущая строка-казино (стиль C): бесшовный луп, дорожка продублирована. -->
      <div class="marquee border-t-2 border-milk/20 bg-milk py-1" aria-hidden="true">
        <p class="marquee-track font-display text-[9px] text-cream uppercase">
          <span class="mx-4">Жоско &#43; мощно &#9733; гамба на пивкойны &#9733; привет стримера — это ценность &#9733; чат в шоке &#9733; пойжем &#9733;&nbsp;</span><span class="mx-4">Жоско &#43; мощно &#9733; гамба на пивкойны &#9733; привет стримера — это ценность &#9733; чат в шоке &#9733; пойжем &#9733;&nbsp;</span>
        </p>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <!-- Гамба-рулетка (тикет 32): кнопка в шапке открывает модалку-колесо. -->
    <GambaModal />
    <!-- Инфо-плашка: звук + VPN, снизу на всех страницах, только крестик, память в localStorage. -->
    <div
      id="info-plaska"
      class="fixed inset-x-0 bottom-0 z-50 hidden border-t-4 border-milk bg-bar"
      role="note"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
        <p class="text-sm font-bold text-milk">
          🔊 Включи звук<br class="sm:hidden" />
          <span class="sm:ml-3">🛡️ Без VPN часть штук может не грузиться</span>
        </p>
        <button
          type="button"
          id="info-plaska-close"
          aria-label="Закрыть подсказку"
          class="btn-arcade btn-arcade-ghost shrink-0 px-3 py-1 text-sm"
        >
          ✕
        </button>
      </div>
    </div>
    <script>
      const PLASKA_KEY = 'alysque:info-plaska-dismissed';
      const plaska = document.getElementById('info-plaska');
      const plaskaClose = document.getElementById('info-plaska-close');
      try {
        if (plaska && !localStorage.getItem(PLASKA_KEY)) {
          plaska.classList.remove('hidden');
        }
      } catch {
        plaska?.classList.remove('hidden');
      }
      plaskaClose?.addEventListener('click', () => {
        plaska?.classList.add('hidden');
        try {
          localStorage.setItem(PLASKA_KEY, '1');
        } catch {
          // приватный режим — просто скрыли до перезагрузки
        }
      });
    </script>
    <script>
      import { getSupabase, getSessionUid } from '../lib/supabase.ts';
      import { fetchMyBalance, subscribeMyBalance } from '../lib/balance.ts';
      import { initOutbidNotice } from '../lib/outbid-notice.ts';
      initOutbidNotice();
      // Баланс в шапке (тикет 11, contract): только из БД (таблица profiles,
      // live-подписка). Гостю чип не показываем вообще; залогиненному без
      // строки (счёт ещё не создан триггером / офлайн) — прочерк, деньги целы.
      // Локальный кошелёк удалён, межвкладочного storage-синка больше нет —
      // тик даёт Realtime.
      let unsubscribeDb: (() => void) | null = null;
      const setChipVisible = (visible: boolean): void => {
        document.querySelectorAll('[data-wallet-chip]').forEach((el) => {
          el.classList.toggle('hidden', !visible);
          el.classList.toggle('flex', visible);
        });
      };
      const paint = (value: string) => {
        document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
          el.textContent = value;
          el.removeAttribute('title');
        });
      };
      async function renderDbOrGuest(): Promise<void> {
        const db = await fetchMyBalance();
        if (db !== null) {
          paint(String(db));
          setChipVisible(true);
          return;
        }
        // Различаем гостя и залогиненного без строки: гостю чип прячем,
        // своему — показываем прочерк (деньги целы, строка подъедет).
        const uid = await getSessionUid();
        if (!uid) {
          setChipVisible(false);
          return;
        }
        paint('—');
        setChipVisible(true);
      }
      async function resubscribe(): Promise<void> {
        unsubscribeDb?.();
        unsubscribeDb = null;
        await renderDbOrGuest();
        const uid = await getSessionUid();
        if (!uid || !getSupabase()) return;
        unsubscribeDb = subscribeMyBalance(uid, (balance) => paint(String(balance)));
      }
      void resubscribe();
      getSupabase()?.auth.onAuthStateChange(() => {
        void resubscribe();
      });

    </script>
  </body>
</html>
