---
import '../styles/global.css';
import GambaModal from '../components/GambaModal.astro';

interface Props {
  title?: string;
}

const { title = 'AlysQueZone — БИРЖА ПРИВЕТОВ' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-void text-milk min-h-screen antialiased">
    <!-- Фон-арт F1 (тикет 37): широкий webp cover center + кремовая вуаль 0.88, контент поверх. -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-20 bg-cover bg-center bg-no-repeat"
      style={`background-image: url('${base}bg/sunflowers.webp')`}
    >
    </div>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-[rgba(255,246,191,0.88)]">
    </div>
    <header class="sticky top-0 z-10 border-b border-black/10 bg-bar/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href={`${base}`} class="text-lg font-black tracking-tight uppercase">
          Alys<span class="text-stream">Que</span>Zone<span class="text-blush">.</span>
        </a>
        <div class="flex items-center gap-2 rounded-full border border-pivko/50 bg-void px-3 py-1 text-sm font-bold">
          <span class="text-melon">◉</span>
          <span data-wallet-balance>1000</span>
          <span class="text-mist/70">Пивкойнов</span>
        </div>
        <button
          type="button"
          data-gamba-button
          class="cursor-pointer rounded-full border border-stream/50 px-5 py-2 text-sm font-extrabold text-stream uppercase hover:bg-stream/10"
        >
          гамба на пивкойны
        </button>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <!-- Гамба-рулетка (тикет 32): кнопка в шапке открывает модалку-колесо. -->
    <GambaModal />
    <script>
      import { getBalance, BALANCE_KEY } from '../lib/wallet.ts';
      const render = () => {
        document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
          el.textContent = String(getBalance());
        });
      };
      render();
      window.addEventListener('storage', (e) => {
        if (e.key === BALANCE_KEY) render();
      });

      // Кнопка «слушать» мем-лота (тикет 17): делегированная, play/stop-тоггл.
      let listenAudio: HTMLAudioElement | null = null;
      let listenBtn: HTMLElement | null = null;
      function resetListenLabel(): void {
        if (listenBtn) listenBtn.textContent = '▶ слушать';
        listenBtn = null;
      }
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest?.('[data-lot-listen]');
        if (!(btn instanceof HTMLElement)) return;
        const src = btn.dataset.lotListen;
        if (!src) return;
        try {
          if (listenAudio && listenBtn === btn && !listenAudio.paused) {
            listenAudio.pause();
            resetListenLabel();
            return;
          }
          listenAudio?.pause();
          resetListenLabel();
          listenAudio = new Audio(src);
          listenBtn = btn;
          btn.textContent = '⏸ стоп';
          listenAudio.addEventListener('ended', resetListenLabel);
          const p = listenAudio.play();
          if (p && typeof p.catch === 'function') p.catch(resetListenLabel);
        } catch {
          resetListenLabel();
        }
      });

    </script>
  </body>
</html>
