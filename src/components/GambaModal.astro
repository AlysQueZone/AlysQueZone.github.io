---
// Рулетка «гамба на пивкойны»: исход считает
// сервер одним вызовом spin_gamba (ставка 100, дебет + кредит + возврат
// исхода в одной транзакции), клиент лишь рисует присланное.
// Клиентского RNG и локальных грантов нет; локальный кошелёк удалён.
//
// Использование: положить <GambaModal /> в layout; кнопка в шапке с
// атрибутом data-gamba-button сама откроет модалку (скрипт делегированный).
// Цикл окна (Escape / клик по затемнению / фокус) — общий lib/modal.ts;
// крутка отменяется в onClose, показ — в onOpen.
//
// Стадии, эффекты, выбор сегмента и стадия → пул — чистый lib/gamba-ceremony.ts;
// здесь — canvas, rAF, Audio, сеть, таймеры, attemptKey, тексты и разметка.
//
// Звуки — публичный бакет media: абсолютные S3-URL без ${base}.
// Пулы в разметку печёт сборка (фолбэк из манифеста content/sounds.toml), а
// при открытии окна клиент подменяет их списком из БД — lib/gamba-sounds.ts.
import { GAMBA_EMOTE_URL } from '@/lib/emotes';
import { GAMBA_DAILY_LIMIT, GAMBA_STAKE } from '@/lib/rules';
import { encodePools, fallbackSoundPools } from '@/lib/gamba-sounds';
/** Фолбэк пулов на момент билда — играет, пока БД не ответила. */
const FALLBACK_POOLS = fallbackSoundPools();
const POOL_ATTRS = encodePools(FALLBACK_POOLS);
---

<div
  id="gamba-modal"
  data-limit={GAMBA_DAILY_LIMIT}
  data-spin-pool={POOL_ATTRS.spinPool}
  data-win-pool={POOL_ATTRS.winPool}
  data-jackpot-pool={POOL_ATTRS.jackpotPool}
  data-lose-pool={POOL_ATTRS.losePool}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gamba-title"
  tabindex="-1"
>
  <div class="card-pixel w-full max-w-md p-5 text-center">
    <h3
      id="gamba-title"
      class="font-display flex items-center justify-center gap-2 text-xs leading-relaxed uppercase"
    >
      <!-- Эмоут декоративный: заголовок текстом говорит то же самое.
           -my-1 держит внешнюю высоту в строке заголовка: эмоут крупнее
           (24px), а h3 не растёт. -->
      <img
        src={GAMBA_EMOTE_URL}
        alt=""
        width="24"
        height="24"
        loading="eager"
        class="h-6 w-6 -my-1 shrink-0 object-contain"
      />
      Гамба на пивкойны
    </h3>
    <div class="relative mx-auto mt-3 h-72 w-72 max-w-full">
      <!-- Колесо декоративно: исход объявляет #gamba-result (role=status). -->
      <canvas
        id="gamba-wheel"
        width="560"
        height="560"
        class="h-72 w-72 max-w-full"
        aria-hidden="true"
      ></canvas>
      <div
        aria-hidden="true"
        class="absolute top-0 left-1/2 -translate-x-1/2 border-x-12 border-t-20 border-x-transparent border-t-milk"
      ></div>
    </div>
    <p id="gamba-result" class="mt-3 min-h-6 text-sm font-black" role="status"></p>
    <div class="mt-3 flex flex-wrap justify-center gap-3">
      <button
        id="gamba-spin"
        type="button"
        class="btn-arcade btn-arcade-primary min-w-56 px-6 py-3 text-sm"
      >
        Крутить за {GAMBA_STAKE}
        <img
          src={GAMBA_EMOTE_URL}
          alt=""
          title="GAMBA"
          width="28"
          height="28"
          loading="eager"
          class="ml-1 -my-1 h-7 w-7 object-contain align-middle"
        />
      </button>
      <button
        id="gamba-close"
        type="button"
        data-modal-close
        class="btn-arcade btn-arcade-ghost min-w-56 px-4 py-3 text-sm text-mist"
      >
        Не, пойду на стрим
      </button>
    </div>
    <p class="mt-2 text-xs font-bold text-mist">
      {GAMBA_DAILY_LIMIT} спинов в день · без проигрыша 🙂
    </p>
  </div>
</div>

<script>
  import { getSupabase, signInWithTwitch } from '@/lib/session';
  import { live } from '@/lib/live';
  import {
    mapGambaError,
    newGambaAttemptKey,
    spinGambaWithRetry,
    type GambaOutcome,
  } from '@/lib/gamba';
  import {
    POOL_NAMES,
    decodePool,
    encodePools,
    fetchSoundPools,
    poolDataKey,
    readPools,
    type SoundPool,
    type SoundPools,
  } from '@/lib/gamba-sounds';
  import {
    SEGMENTS,
    SPIN_MS,
    createGambaCeremony,
    targetSegment,
    type GambaCeremonyEffect,
  } from '@/lib/gamba-ceremony';
  import { createModal } from '@/lib/modal';
  import { GAMBA_STAKE } from '@/lib/rules';

  /** Токены палитры (DESIGN.md) — canvas их не видит,
      поэтому читаем значения из :root один раз. */
  const cssVar = (name: string): string =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const INK = cssVar('--color-milk');
  const CREAM = cssVar('--color-cream');

  // Цвета сегментов: токены палитры разрешаются из :root, локальные hex
  // колеса живут в декоративном наборе gamba-ceremony (DESIGN.md).
  const SEGMENT_COLORS = SEGMENTS.map((segment) =>
    'token' in segment.color ? cssVar(segment.color.token) : segment.color.hex
  );
  const SEG = (Math.PI * 2) / SEGMENTS.length;

  /** 7TV-эмоут aga канала (ID проверен 2026-09-09 через 7TV API сета). */
  const AGA_URL = 'https://cdn.7tv.app/emote/01HMBMJPV0000D32KQCYBK4S1D/2x.webp';
  /** 7TV-эмоут SCAMBA канала (ID из src/lib/emotes.ts). */
  const SCAMBA_URL = 'https://cdn.7tv.app/emote/01GWACFXSG0002CCPRV6KPX2XA/2x.webp';
  /** 7TV-эмоут suda канала (ID проверен 2026-09-09 через 7TV API сета). */
  const SUDA_URL = 'https://cdn.7tv.app/emote/01JRQF9CBSHN8MBST3TX1W6DY7/2x.webp';

  const RESULT_TEXT: Record<GambaOutcome, string> = {
    // legacy 'miss' (эпохи F–H): новых таких спинов сервер не выдаёт (таблица I
    // без мимо), ключ оставлен ради типа и истории.
    miss: `МИМО! −${GAMBA_STAKE} Пивкойнов 🍺`,
    return: 'ВОЗВРАТ! При своих — крути ещё',
    // 'small' — штатный исход таблицы H (мелкий выигрыш +50), свой сегмент есть.
    small: '+50 Пивкойнов',
    big: 'ЖОСКО! +150 Пивкойнов — чат уважает 🍺',
    jackpot: 'ДЖЕКПОТ! +1000 Пивкойнов — чат в шоке 🍺',
  };
  // DOM-lookup — выше всех текстов и функций: LIMIT_TEXT читает modal.dataset
  // на верхнем уровне, позже — TDZ ReferenceError и мёртвый скрипт (кейс 2026-09-11,
  // в прод-бандле const→var молча прятал, в dev кнопка ничего не открывала).
  const modal = document.getElementById('gamba-modal');
  const canvas = document.getElementById('gamba-wheel');
  const result = document.getElementById('gamba-result');
  const spinBtn = document.getElementById('gamba-spin');

  const GATE_TEXT = `На ставку не хватает — нужно ${GAMBA_STAKE} Пивкойнов 🍺`;
  const GUEST_TEXT = 'Гамба только для своих — войди через Twitch, и пойжем вместе 🍺';
  const RATE_TEXT = 'Не жми так жоско — дай колесу отдышаться пару секунд 🙂';
  const limitN = modal?.dataset.limit ?? '20';
  const LIMIT_TEXT = `Спины на сегодня кончились (${limitN} в день) — возвращайся завтра 🙂`;
  const OFFLINE_TEXT = 'Офлайн: спин не записан, Пивкойны целы. Вернись с сетью.';
  const ERROR_TEXT = 'Не крутанулось — Пивкойны целы, попробуй ещё.';

  /**
   * Ключ текущей попытки: генерируется на спин, переживает ретрай и
   * офлайн-повтор той же попытки (повтор шлёт ТОТ ЖЕ ключ — сервер
   * идемпотентен, дублей нет), истекает только после показанного исхода.
   */
  let attemptKey: string | null = null;

  let spinning = false;
  // Запрос уже в полёте: синхронный лок от повторных кликов/зажатого Enter
  // (кнопку гасим сразу, до первого await — иначе пачка параллельных спинов).
  let pending = false;
  // Церемония держит баланс: release — функция из live.deferBalance;
  // ядро гарантирует ровно один release на терминале.
  let releaseBalance: (() => void) | null = null;
  const ceremony = createGambaCeremony({ now: () => performance.now() });
  // Пауза после rate-limit: кнопка остаётся disabled, пока таймер не истечёт.
  let lockTimer: ReturnType<typeof setTimeout> | undefined;
  let raf = 0;
  let bgAudio: HTMLAudioElement | null = null;
  let outcomeAudio: HTMLAudioElement | null = null;
  let tickCtx: AudioContext | null = null;

  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;

  /** Рисует колесо, повёрнутое на angle (стрелка сверху). */
  function draw(angle: number): void {
    if (!ctx || !(canvas instanceof HTMLCanvasElement)) return;
    const r = canvas.width / 2;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.translate(r, r);
    ctx.rotate(angle);
    for (let i = 0; i < SEGMENTS.length; i++) {
      const s = SEGMENTS[i];
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, r - 4, i * SEG, (i + 1) * SEG);
      ctx.closePath();
      ctx.fillStyle = SEGMENT_COLORS[i];
      ctx.fill();
      ctx.strokeStyle = INK;
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.save();
      ctx.rotate(i * SEG + SEG / 2);
      ctx.textAlign = 'right';
      // Тёмный текст — на жёлтом возврате, белый — дальше по нарастанию.
      ctx.fillStyle = s.outcome === 'return' ? INK : CREAM;
      // Пиксельные подписи сегментов (стиль C); без загруженного шрифта —
      // честный monospace-фолбэк.
      ctx.font = `400 ${s.outcome === 'jackpot' ? 20 : 22}px "Press Start 2P", monospace`;
      ctx.fillText(s.label, r - 26, 12);
      ctx.restore();
    }
    ctx.beginPath();
    ctx.arc(0, 0, 34, 0, Math.PI * 2);
    ctx.fillStyle = INK;
    ctx.fill();
    ctx.restore();
  }

  /** Короткий щелчок барабана (WebAudio, без файлов). */
  function click(): void {
    try {
      tickCtx ??= new AudioContext();
      if (tickCtx.state === 'suspended') void tickCtx.resume();
      const osc = tickCtx.createOscillator();
      const gain = tickCtx.createGain();
      osc.type = 'square';
      osc.frequency.value = 2000;
      gain.gain.setValueAtTime(0.12, tickCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, tickCtx.currentTime + 0.03);
      osc.connect(gain).connect(tickCtx.destination);
      osc.start();
      osc.stop(tickCtx.currentTime + 0.035);
    } catch {
      // graceful-fallback: крутка идёт и без щелчков
    }
  }

  function pick<T>(list: T[]): T | undefined {
    if (list.length === 0) return undefined;
    return list[Math.floor(Math.random() * list.length)];
  }

  /** Файлы пула из data-атрибута; decode — в gamba-sounds. */
  function poolFiles(pool: SoundPool): string[] {
    return decodePool(modal?.dataset[poolDataKey(pool)]);
  }

  function preloadPools(): void {
    if (!modal) return;
    const pools = readPools(modal.dataset);
    try {
      for (const pool of POOL_NAMES) {
        for (const src of pools[pool]) {
          const a = new Audio(src);
          a.preload = 'auto';
          a.volume = 0.01;
        }
      }
    } catch {
      // предзагрузка — best effort
    }
  }

  /** Пулы из БД ложатся туда же, откуда их читает крутка, — в data-атрибуты. */
  function setPools(pools: SoundPools): void {
    if (!modal) return;
    Object.assign(modal.dataset, encodePools(pools));
  }

  /**
   * Догрузка пулов из БД при открытии окна. Крутку не блокирует: пока едет,
   * звучит фолбэк сборки; приехало — подменяем и греем новые файлы. Список
   * меняется синком, а не жизнью пользователя, поэтому каждый заход читает
   * свежее (кэша нет) — релиз звука виден без перезагрузки страницы.
   */
  async function syncPools(): Promise<void> {
    const pools = await fetchSoundPools();
    if (!pools) return;
    setPools(pools);
    preloadPools();
  }

  /** Случайная фраза кручения — one-shot поверх щелчков (gamba-bg — один из вариантов пула, не луп). */
  function playSpin(): void {
    stopAll();
    const src = pick(poolFiles('spin'));
    if (!src) return;
    try {
      bgAudio = new Audio(src);
      bgAudio.loop = false;
      bgAudio.volume = 0.8;
      const p = bgAudio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      bgAudio = null;
    }
  }

  /** Стопит фон и исходник — звуки не наслаиваются. */
  function stopAll(): void {
    try {
      bgAudio?.pause();
      outcomeAudio?.pause();
    } catch {
      // уже остановлены — ок
    }
    bgAudio = null;
    outcomeAudio = null;
  }

  function playOutcome(src: string | undefined): void {
    if (bgAudio) {
      try {
        bgAudio.pause();
      } catch {
        // уже остановлен — ок
      }
      bgAudio = null;
    }
    if (!src) return;
    try {
      outcomeAudio = new Audio(src);
      outcomeAudio.volume = 0.8;
      const p = outcomeAudio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      outcomeAudio = null;
    }
  }

  /** Случайный исходник из пула категории. */
  function playOutcomePool(pool: SoundPool): void {
    playOutcome(pick(poolFiles(pool)));
  }

  function setBusy(busy: boolean): void {
    if (spinBtn instanceof HTMLButtonElement) spinBtn.disabled = busy;
  }

  /** Исполнение эффектов ядра: rAF, звук, сеть и придержанный баланс — здесь. */
  function applyEffects(effects: readonly GambaCeremonyEffect[]): void {
    for (const effect of effects) {
      switch (effect.type) {
        case 'holdBalance':
          releaseBalance = live.deferBalance();
          break;
        case 'releaseBalance':
          releaseBalance?.();
          releaseBalance = null;
          break;
        case 'animate':
          animateToOutcome(effect.outcome);
          break;
        case 'reveal':
          showOutcome(effect.outcome);
          break;
        case 'playPool':
          playOutcomePool(effect.pool);
          break;
      }
    }
  }

  /** Исход в строку результата: return/small — 7TV aga, miss — 7TV SCAMBA, jackpot — 7TV suda. */
  function showOutcome(outcome: GambaOutcome): void {
    if (!result) return;
    result.innerHTML = '';
    const span = document.createElement('span');
    span.textContent = RESULT_TEXT[outcome];
    result.appendChild(span);
    const emote =
      outcome === 'return' || outcome === 'small'
        ? { src: AGA_URL, name: 'aga' }
        : outcome === 'miss'
          ? { src: SCAMBA_URL, name: 'SCAMBA' }
          : outcome === 'jackpot'
            ? { src: SUDA_URL, name: 'suda' }
            : null;
    if (emote) {
      const img = document.createElement('img');
      img.src = emote.src;
      img.alt = emote.name;
      img.title = emote.name;
      img.width = 28;
      img.height = 28;
      img.loading = 'eager';
      img.className = 'ml-1 inline h-7 w-7 object-contain align-middle';
      result.appendChild(img);
    }
  }

  /** Докрутка колеса до сегмента присланного сервером исхода. */
  function animateToOutcome(outcome: GambaOutcome): void {
    // Исхода может не быть на колесе (legacy miss): targetSegment даёт
    // случайный сегмент — это лишь церемония, правду говорит строка результата.
    const target = targetSegment(outcome, Math.random);
    // Центр целевого сегмента под стрелку сверху (-PI/2).
    const targetAngle = -Math.PI / 2 - (target * SEG + SEG / 2);
    const start = 0;
    const turns = Math.PI * 2 * 5;
    let delta = (targetAngle - start) % (Math.PI * 2);
    if (delta < 0) delta += Math.PI * 2;
    const total = turns + delta;

    spinning = true;
    setBusy(true);
    if (result) result.textContent = 'Крутится…';
    playSpin();
    const t0 = performance.now();
    let lastTick = 0;

    const frame = (now: number): void => {
      if (!spinning) return;
      const t = Math.min((now - t0) / SPIN_MS, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      const angle = start + total * eased;
      draw(angle);
      // Щелчок при проходе границы сегмента — по мере ease-out редеют сами.
      const idx = Math.floor(
        ((((-Math.PI / 2 - angle) % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2)) / SEG
      );
      if (idx !== lastTick) {
        lastTick = idx;
        click();
      }
      if (t < 1) {
        raf = requestAnimationFrame(frame);
        return;
      }
      spinning = false;
      setBusy(false);
      // Исход показан — церемония кончилась: reveal, пул звука и раскрытие
      // баланса приходят одним терминальным переходом ядра; ключ попытки
      // истекает, следующий спин будет новым.
      applyEffects(ceremony.dispatch({ type: 'finish' }));
      attemptKey = null;
    };
    raf = requestAnimationFrame(frame);
  }

  const gamba = createModal(modal, {
    onOpen() {
      // Повторное открытие снимает лок дня и паузу rate-limit. Если запрос
      // ещё в полёте — кнопку не включаем (иначе клик молча проглотится).
      applyEffects(ceremony.dispatch({ type: 'reset' }));
      if (lockTimer) {
        clearTimeout(lockTimer);
        lockTimer = undefined;
      }
      setBusy(pending);
      if (result) result.textContent = '';
      draw(0);
      preloadPools();
      void syncPools();
      // Гейт заранее: при балансе меньше ставки — понятная подсказка,
      // а не ошибка после клика (свежесть — явная, это денежный гейт).
      void (async () => {
        if (!getSupabase()) return;
        try {
          const balance = await live.refreshBalance();
          if (balance !== null && balance < GAMBA_STAKE && result && result.textContent === '') {
            result.textContent = GATE_TEXT;
          }
        } catch {
          // гейт — best effort, правда придёт с сервера
        }
      })();
    },
    onClose() {
      // Окно закрыли — церемонии больше нет: анимацию гасим, придержанный
      // баланс раскрываем немедленно, ответ RPC в пустоту крутить не будем.
      applyEffects(ceremony.dispatch({ type: 'abort' }));
      if (spinning) {
        spinning = false;
        cancelAnimationFrame(raf);
        stopAll();
      }
      if (lockTimer) {
        clearTimeout(lockTimer);
        lockTimer = undefined;
      }
      setBusy(false);
    },
  });

  async function spin(): Promise<void> {
    // Синхронный лок: ни повторный клик, ни зажатый Enter не запустят второй
    // запрос, пока текущий в полёте. Кнопку гасим до первого await.
    if (spinning || pending || !modal) return;
    if (!getSupabase()) {
      if (result) result.textContent = ERROR_TEXT;
      return;
    }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      if (result) result.textContent = OFFLINE_TEXT;
      return;
    }
    pending = true;
    setBusy(true);
    try {
      const sb = getSupabase();
      const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
      if (!data.session) {
        if (result) result.textContent = GUEST_TEXT;
        setBusy(false);
        await signInWithTwitch(window.location.href.split('#')[0]);
        return;
      }
      // Предгейт по живому балансу — сервер всё равно перепроверит под локом.
      try {
        const balance = await live.refreshBalance();
        if (balance !== null && balance < GAMBA_STAKE) {
          if (result) result.textContent = GATE_TEXT;
          setBusy(false);
          return;
        }
      } catch {
        // баланс не прочитался — дальше правда сервера
      }
      // Церемония с этого момента держит баланс: и явный ответ спина, и
      // realtime-тик профиля копятся, чип раскроется в конце крутки.
      applyEffects(ceremony.dispatch({ type: 'start' }));
      if (result) result.textContent = 'Стучимся к серверу за исходом…';
      let spinOutcome: GambaOutcome;
      let spinBalance: number | null;
      // Ключ держится на попытку: генерируется на спин, повтор той же попытки
      // (ретрай/офлайн-повтор в spinGambaWithRetry, следующий клик после ошибки
      // без исхода) шлёт ТОТ ЖЕ ключ. Истекает только после показанного исхода
      // (см. конец animateToOutcome) — при ошибке ключ жив, дублей нет.
      attemptKey ??= newGambaAttemptKey();
      try {
        const done = await spinGambaWithRetry(attemptKey);
        spinOutcome = done.outcome;
        spinBalance = done.balance;
      } catch (err) {
        // Ошибка спина — церемонии нет: сбрасываем цикл и раскрываем
        // придержанный баланс; ключ попытки жив — следующий клик повторит
        // ту же попытку без дублей.
        applyEffects(ceremony.dispatch({ type: 'reset' }));
        const info = mapGambaError(err);
        if (!result) return;
        if (info.kind === 'insufficient-funds') {
          result.textContent = GATE_TEXT;
          setBusy(false);
          return;
        }
        if (info.kind === 'unauthenticated') {
          result.textContent = GUEST_TEXT;
          setBusy(false);
          await signInWithTwitch(window.location.href.split('#')[0]);
          return;
        }
        if (info.kind === 'rate-limit') {
          result.textContent = RATE_TEXT;
          // Кнопка уже disabled — включаем только по таймеру. «20 в минуту»
          // ждёт минуту, короткий «1/2с» — две секунды.
          if (lockTimer) clearTimeout(lockTimer);
          const waitMs = info.raw.includes('20 per minute') ? 60000 : 2000;
          lockTimer = setTimeout(() => setBusy(false), waitMs);
          return;
        }
        if (info.kind === 'daily-limit') {
          result.textContent = LIMIT_TEXT;
          return; // disabled до повторного открытия — держим кэп дня
        }
        if (info.kind === 'offline') {
          result.textContent = OFFLINE_TEXT;
          setBusy(false);
          return;
        }
        result.textContent = ERROR_TEXT;
        setBusy(false);
        return;
      }
      // Баланс из ответа сервера — в снапшот, но церемония его ещё держит:
      // чип раскроется тем же кадром, что и исход (realtime-тик тоже копится).
      if (spinBalance !== null) live.reportBalance(spinBalance);
      // Окно закрыли посреди RPC — result после abort ядро игнорирует:
      // колесо в пустоту не крутится, придержанное раскрыто в onClose.
      const effects = ceremony.dispatch({ type: 'result', outcome: spinOutcome });
      if (effects.length === 0) {
        attemptKey = null;
        setBusy(false);
      } else {
        applyEffects(effects);
      }
    } finally {
      pending = false;
    }
  }

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement | null)?.closest?.('[data-gamba-button]');
    if (trigger instanceof HTMLElement) gamba?.open(trigger);
  });
  spinBtn?.addEventListener('click', () => {
    void spin();
  });

  draw(0);
</script>
