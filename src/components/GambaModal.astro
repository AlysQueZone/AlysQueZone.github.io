---
 // Рулетка «гамба на пивкойны» (тикет 09, pivkoiny-backend): исход считает
 // сервер одним вызовом spin_gamba (ставка 100, дебет + кредит + возврат
 // исхода в одной транзакции), клиент лишь рисует присланное.
  // Клиентского RNG и локальных грантов нет; локальный кошелёк удалён (тикет 11).
 //
 // Использование: положить <GambaModal /> в layout; кнопка в шапке с
 // атрибутом data-gamba-button сама откроет модалку (скрипт делегированный).
 //
 // Звуки — публичный бакет media (тикет 10, §3 спеки): абсолютные S3-URL без ${base}.
import { S3_MEDIA_BASE } from '../lib/media.ts';
import { GAMBA_DAILY_LIMIT } from '../lib/gamba.ts';
const S3_SOUNDS = `${S3_MEDIA_BASE}/sounds`;
/** 7TV-эмоут GAMBA канала (ID проверен 2026-09-09 через 7TV API сета). */
const GAMBA_URL = 'https://cdn.7tv.app/emote/01FJT4HEXG000FZHS49NWQT5DZ/2x.webp';
---

<div
  id="gamba-modal"
  data-bg={`${S3_SOUNDS}/gamba-bg.mp3`}
  data-win={`${S3_SOUNDS}/gamba-win1k.mp3`}
  data-lose={`${S3_SOUNDS}/m4-scum.mp3`}
  data-jackpot={`${S3_SOUNDS}/gamba-win100k.mp3`}
  data-spin-pool={`${S3_SOUNDS}/gamba-spin-sova.mp3,${S3_SOUNDS}/gamba-spin-maknagens.mp3,${S3_SOUNDS}/gamba-spin-toptop.mp3,${S3_SOUNDS}/gamba-win-taktak.mp3`}
  data-win-pool={`${S3_SOUNDS}/gamba-win1k.mp3,${S3_SOUNDS}/gamba-win-ideal.mp3,${S3_SOUNDS}/gamba-win-oooo.mp3,${S3_SOUNDS}/gamba-win-pivo.mp3`}
  data-jackpot-pool={`${S3_SOUNDS}/gamba-win100k.mp3,${S3_SOUNDS}/gamba-super-vanna.mp3,${S3_SOUNDS}/gamba-super-snow.mp3`}
  data-lose-pool={`${S3_SOUNDS}/m4-scum.mp3,${S3_SOUNDS}/gamba-lose-higan.mp3`}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gamba-title"
>
  <div class="card-pixel w-full max-w-md p-5 text-center">
    <h3 id="gamba-title" class="font-display text-xs leading-relaxed uppercase">🎰 Гамба на пивкойны</h3>
    <div class="relative mx-auto mt-3 h-72 w-72 max-w-full">
      <canvas id="gamba-wheel" width="560" height="560" class="h-72 w-72 max-w-full"></canvas>
      <div
        aria-hidden="true"
        class="absolute top-0 left-1/2 -translate-x-1/2 border-x-12 border-t-20 border-x-transparent border-t-melon"
      >
      </div>
    </div>
    <p id="gamba-result" class="mt-3 min-h-6 text-sm font-black" role="status"></p>
    <div class="mt-3 flex flex-wrap justify-center gap-3">
      <button
        id="gamba-spin"
        type="button"
        class="btn-arcade btn-arcade-primary px-6 py-2 text-sm"
      >
        Крутить за 100
        <img
          src={GAMBA_URL}
          alt="GAMBA"
          title="GAMBA"
          width="28"
          height="28"
          loading="eager"
          class="ml-1 inline h-7 w-7 object-contain align-middle"
        />
      </button>
      <button
        id="gamba-close"
        type="button"
        class="btn-arcade btn-arcade-ghost px-4 py-2 text-sm text-mist"
      >
        Не, пойду на стрим
      </button>
    </div>
    <p class="mt-2 text-xs font-bold text-mist/60">
      {GAMBA_DAILY_LIMIT} счастливых спинов в день · минимум — при своих 🙂
    </p>
  </div>
</div>

<script>
  import { getSupabase, isSupabaseConfigured, signInWithTwitch } from '../lib/supabase.ts';
  import { fetchMyBalance } from '../lib/balance.ts';
  import {
    GAMBA_PAYTABLE,
    GAMBA_STAKE,
    fetchGambaPaytable,
    mapGambaError,
    newGambaAttemptKey,
    spinGambaWithRetry,
    type GambaOutcome,
    type GambaPayRow,
  } from '../lib/gamba.ts';

  // 20 сегментов — визуальная аппроксимация таблицы I (тикет 08)
  // (15 возвратов / 3 мелких / 1 крупный / 1 джекпот ≈ веса 75/17/7/1 —
  // джекпот визуально завышен 5% vs 1%: сегмент меньше не сделать, честные
  // шансы только в плакате/правилах);
  // точные веса живут в БД и плакате, исход решает сервер — колесо лишь
  // докручивается до сегмента присланного типа. Мимо нет вовсе (тикет 08).
  // Цвета по нарастанию выигрыша: возврат — жёлтый, +50 — оранжевый,
  // +150 — красный, x10 — маджента.
  type WheelSegment = { label: string; outcome: GambaOutcome; color: string };
  const SEGMENT_SPECS: Record<string, WheelSegment> = {
    R: { label: 'возврат', outcome: 'return', color: '#FFD93C' },
    S: { label: '+50', outcome: 'small', color: '#FF9E2C' },
    B: { label: '+150', outcome: 'big', color: '#FF5A3C' },
    J: { label: 'x10', outcome: 'jackpot', color: '#FF00BC' },
  };
  const WHEEL_PATTERN = 'RSRRBRSRRRRSRRRRJRRR';
  // Инвариант рядом с паттерном: 20 сегментов 15/3/1/1 (R/S/B/J) —
  // визуальная аппроксимация таблицы I, алфавит строго RBSJ — числа
  // не менять, при рассинхроне упасть громко.
  if (WHEEL_PATTERN.length !== 20 || /[^RBSJ]/.test(WHEEL_PATTERN)) {
    throw new Error(`bad WHEEL_PATTERN (len=${WHEEL_PATTERN.length}, alphabet=RBSJ)`);
  }
  const _counts = [...WHEEL_PATTERN].reduce<Record<string, number>>((acc, ch) => {
    acc[ch] = (acc[ch] ?? 0) + 1;
    return acc;
  }, {});
  if (_counts['R'] !== 15 || _counts['S'] !== 3 || _counts['B'] !== 1 || _counts['J'] !== 1) {
    throw new Error(`bad WHEEL_PATTERN counts (R/S/B/J=${_counts['R']}/${_counts['S']}/${_counts['B']}/${_counts['J']})`);
  }
  const SEGMENTS: WheelSegment[] = [...WHEEL_PATTERN].map((ch) => {
    const seg = SEGMENT_SPECS[ch];
    if (!seg) throw new Error(`bad WHEEL_PATTERN char: ${ch}`);
    return seg;
  });
  const SEG = (Math.PI * 2) / SEGMENTS.length;
  const SPIN_MS = 4200;

  /** 7TV-эмоут aga канала (ID проверен 2026-09-09 через 7TV API сета). */
  const AGA_URL = 'https://cdn.7tv.app/emote/01HMBMJPV0000D32KQCYBK4S1D/2x.webp';
  /** 7TV-эмоут SCAMBA канала (ID из src/lib/emotes.ts). */
  const SCAMBA_URL = 'https://cdn.7tv.app/emote/01GWACFXSG0002CCPRV6KPX2XA/2x.webp';
  /** 7TV-эмоут suda канала (ID проверен 2026-09-09 через 7TV API сета). */
  const SUDA_URL = 'https://cdn.7tv.app/emote/01JRQF9CBSHN8MBST3TX1W6DY7/2x.webp';

  const RESULT_TEXT: Record<GambaOutcome, string> = {
    // legacy 'miss' (эпохи F–H): новых таких спинов сервер не выдаёт (таблица I
    // без мимо), ключ оставлен ради типа и истории.
    miss: 'МИМО! −100 Пивкойнов 🍺',
    return: 'ВОЗВРАТ! При своих — крути ещё 🙂',
    // 'small' — штатный исход таблицы H (мелкий выигрыш +50), свой сегмент есть.
    small: '+50 Пивкойнов 🙂',
    big: 'ЖОСКО! +150 Пивкойнов — чат уважает 🍺',
    jackpot: 'ДЖЕКПОТ! +1000 Пивкойнов — чат в шоке 🍺',
  };
  const GATE_TEXT =
    'В котле меньше сотни — ставка 100 не влезла. Забери Ежедневный вход и возвращайся пойжемать 🙂';
  const GUEST_TEXT = 'Гамба только для своих — войди через Twitch, и пойжем вместе 🍺';
  const RATE_TEXT = 'Не жми так жоско — дай колесу отдышаться пару секунд 🙂';
  const LIMIT_TEXT = 'Счастливые спины на сегодня кончились (5 в день) — возвращайся завтра 🙂';
  const OFFLINE_TEXT = 'Офлайн: спин не записан, Пивкойны целы. Вернись с сетью.';
  const ERROR_TEXT = 'Не крутанулось — Пивкойны целы, попробуй ещё.';

  const modal = document.getElementById('gamba-modal');
  const canvas = document.getElementById('gamba-wheel');
  const result = document.getElementById('gamba-result');
  const spinBtn = document.getElementById('gamba-spin');
  const closeBtn = document.getElementById('gamba-close');
  const paytable = document.getElementById('gamba-paytable');

  /**
   * Ключ текущей попытки: генерируется на спин, переживает ретрай и
   * офлайн-повтор той же попытки (повтор шлёт ТОТ ЖЕ ключ — сервер
   * идемпотентен, дублей нет), истекает только после показанного исхода.
   */
  let attemptKey: string | null = null;

  /** Плакат из БД (public.gamba_payouts публична); молча — фолбэк GAMBA_PAYTABLE. */
  function paintPaytable(rows: GambaPayRow[]): void {
    if (!(paytable instanceof HTMLUListElement)) return;
    paytable.innerHTML = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.className = 'border-2 border-milk/60 bg-void px-1 py-1 font-bold';
      li.textContent = `${row.label} — ${row.chance}`;
      paytable.appendChild(li);
    }
  }

  async function refreshPaytable(): Promise<void> {
    try {
      const live = await fetchGambaPaytable();
      paintPaytable(live ?? GAMBA_PAYTABLE);
    } catch {
      paintPaytable(GAMBA_PAYTABLE);
    }
  }

  let spinning = false;
  let raf = 0;
  let bgAudio: HTMLAudioElement | null = null;
  let outcomeAudio: HTMLAudioElement | null = null;
  let tickCtx: AudioContext | null = null;

  const ctx =
    canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;

  /** Рисует колесо, повёрнутое на angle (стрелка сверху). */
  function draw(angle: number): void {
    if (!ctx || !(canvas instanceof HTMLCanvasElement)) return;
    const r = canvas.width / 2;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.translate(r, r);
    ctx.rotate(angle);
    for (let i = 0; i < SEGMENTS.length; i++) {
      const s = SEGMENTS[i];
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, r - 4, i * SEG, (i + 1) * SEG);
      ctx.closePath();
      ctx.fillStyle = s.color;
      ctx.fill();
      ctx.strokeStyle = '#422006';
      ctx.lineWidth = 3;
      ctx.stroke();
      ctx.save();
      ctx.rotate(i * SEG + SEG / 2);
      ctx.textAlign = 'right';
      // Тёмный текст — на жёлтом возврате, белый — дальше по нарастанию.
      ctx.fillStyle = s.outcome === 'return' ? '#422006' : '#FFFBEA';
      // Пиксельные подписи сегментов (стиль C); без загруженного шрифта —
      // честный monospace-фолбэк.
      ctx.font = `400 ${s.outcome === 'jackpot' ? 20 : 22}px "Press Start 2P", monospace`;
      ctx.fillText(s.label, r - 26, 12);
      ctx.restore();
    }
    ctx.beginPath();
    ctx.arc(0, 0, 34, 0, Math.PI * 2);
    ctx.fillStyle = '#422006';
    ctx.fill();
    ctx.restore();
  }

  /** Короткий щелчок барабана (WebAudio, без файлов). */
  function click(): void {
    try {
      tickCtx ??= new AudioContext();
      if (tickCtx.state === 'suspended') void tickCtx.resume();
      const osc = tickCtx.createOscillator();
      const gain = tickCtx.createGain();
      osc.type = 'square';
      osc.frequency.value = 2000;
      gain.gain.setValueAtTime(0.12, tickCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, tickCtx.currentTime + 0.03);
      osc.connect(gain).connect(tickCtx.destination);
      osc.start();
      osc.stop(tickCtx.currentTime + 0.035);
    } catch {
      // graceful-fallback: крутка идёт и без щелчков
    }
  }

  /** Рандом-пулы звуков гамбы (Q1–Q2): равномерный выбор внутри категории. */
  function pool(key: string, fallbackKey?: string): string[] {
    if (!modal) return [];
    const raw = modal.dataset[key] ?? '';
    const list = raw
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    if (list.length > 0) return list;
    const fb = fallbackKey ? modal.dataset[fallbackKey] : undefined;
    return fb ? [fb] : [];
  }

  function pick<T>(list: T[]): T | undefined {
    if (list.length === 0) return undefined;
    return list[Math.floor(Math.random() * list.length)];
  }

  function preloadPools(): void {
    try {
      for (const key of ['spinPool', 'winPool', 'jackpotPool', 'losePool']) {
        for (const src of pool(key)) {
          const a = new Audio(src);
          a.preload = 'auto';
          a.volume = 0.01;
        }
      }
    } catch {
      // предзагрузка — best effort
    }
  }

  function playBg(src: string | undefined): void {
    stopAll();
    if (!src) return;
    try {
      bgAudio = new Audio(src);
      bgAudio.loop = true;
      bgAudio.volume = 0.6;
      const p = bgAudio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      bgAudio = null;
    }
  }

  /** Случайная фраза кручения — one-shot поверх щелчков, без лупа gamba-bg. */
  function playSpin(): void {
    stopAll();
    const src = pick(pool('spinPool', 'bg'));
    if (!src) return;
    try {
      bgAudio = new Audio(src);
      bgAudio.loop = false;
      bgAudio.volume = 0.8;
      const p = bgAudio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      bgAudio = null;
    }
  }

  /** Стопит фон и исходник — звуки не наслаиваются. */
  function stopAll(): void {
    try {
      bgAudio?.pause();
      outcomeAudio?.pause();
    } catch {
      // уже остановлены — ок
    }
    bgAudio = null;
    outcomeAudio = null;
  }

  function playOutcome(src: string | undefined): void {
    if (bgAudio) {
      try {
        bgAudio.pause();
      } catch {
        // уже остановлен — ок
      }
      bgAudio = null;
    }
    if (!src) return;
    try {
      outcomeAudio = new Audio(src);
      outcomeAudio.volume = 0.8;
      const p = outcomeAudio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      outcomeAudio = null;
    }
  }

  /** Случайный исходник из пула категории (старые + новые равноправны). */
  function playOutcomePool(poolKey: string, fallbackKey: string): void {
    playOutcome(pick(pool(poolKey, fallbackKey)));
  }

  function setBusy(busy: boolean): void {
    if (spinBtn instanceof HTMLButtonElement) spinBtn.disabled = busy;
  }

  /** Исход в строку результата: return/small — 7TV aga, miss — 7TV SCAMBA, jackpot — 7TV suda. */
  function showOutcome(outcome: GambaOutcome): void {
    if (!result) return;
    result.innerHTML = '';
    const span = document.createElement('span');
    span.textContent = RESULT_TEXT[outcome];
    result.appendChild(span);
    const emote =
      outcome === 'return' || outcome === 'small'
        ? { src: AGA_URL, name: 'aga' }
        : outcome === 'miss'
          ? { src: SCAMBA_URL, name: 'SCAMBA' }
          : outcome === 'jackpot'
            ? { src: SUDA_URL, name: 'suda' }
            : null;
    if (emote) {
      const img = document.createElement('img');
      img.src = emote.src;
      img.alt = emote.name;
      img.title = emote.name;
      img.width = 28;
      img.height = 28;
      img.loading = 'eager';
      img.className = 'ml-1 inline h-7 w-7 object-contain align-middle';
      result.appendChild(img);
    }
  }

  function paintBalance(balance: number): void {
    document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
      el.textContent = String(balance);
    });
  }

  /** Докрутка колеса до сегмента присланного сервером исхода. */
  function animateToOutcome(outcome: GambaOutcome): void {
    // У каждого исхода таблицы H свой сегмент — маппинга не нужно.
    const wheelOutcome: GambaOutcome = outcome;
    // Исхода может не быть на колесе (рассыхание конфига БД и клиента
    // при раскатке, legacy miss): тогда крутим на случайный сегмент —
    // это лишь церемония, правду говорит только строка результата.
    const candidates = SEGMENTS.map((s, i) => (s.outcome === wheelOutcome ? i : -1)).filter(
      (i) => i >= 0,
    );
    const target =
      candidates.length > 0
        ? (candidates[Math.floor(Math.random() * candidates.length)] ?? 0)
        : Math.floor(Math.random() * SEGMENTS.length);
    // Центр целевого сегмента под стрелку сверху (-PI/2).
    const targetAngle = -Math.PI / 2 - (target * SEG + SEG / 2);
    const start = 0;
    const turns = Math.PI * 2 * 5;
    let delta = (targetAngle - start) % (Math.PI * 2);
    if (delta < 0) delta += Math.PI * 2;
    const total = turns + delta;

    spinning = true;
    setBusy(true);
    if (result) result.textContent = 'Крутится…';
    playSpin();
    const t0 = performance.now();
    let lastTick = 0;

    const frame = (now: number): void => {
      if (!spinning) return;
      const t = Math.min((now - t0) / SPIN_MS, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      const angle = start + total * eased;
      draw(angle);
      // Щелчок при проходе границы сегмента — по мере ease-out редеют сами.
      const idx = Math.floor(
        (((-Math.PI / 2 - angle) % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2) / SEG,
      );
      if (idx !== lastTick) {
        lastTick = idx;
        click();
      }
      if (t < 1) {
        raf = requestAnimationFrame(frame);
        return;
      }
      spinning = false;
      setBusy(false);
      if (!modal) return;
      // Церемония по исходам (тикет 08): возврат — нейтральная фраза
      // кручения (не win — при своих не победа), мелочь/крупно — win-пул,
      // джекпот — jackpot-пул. legacy miss — lose-пул, новых не бывает.
      if (outcome === 'return') {
        playOutcomePool('spinPool', 'bg');
      } else if (outcome === 'small' || outcome === 'big') {
        playOutcomePool('winPool', 'win');
      } else if (outcome === 'jackpot') {
        playOutcomePool('jackpotPool', 'jackpot');
      } else {
        playOutcomePool('losePool', 'lose');
      }
      if (result) showOutcome(outcome);
      // Исход показан — ключ попытки истекает, следующий спин будет новым.
      attemptKey = null;
    };
    raf = requestAnimationFrame(frame);
  }

  function open(): void {
    if (!modal || spinning) return;
    if (result) result.textContent = '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    draw(0);
    preloadPools();
    // Плакат всегда свежий из БД (фолбэк — зашитая таблица выше).
    void refreshPaytable();
    // Дружелюбный гейт заранее: при балансе меньше ставки — подсказка
    // про Ежедневный вход, а не ошибка после клика.
    void (async () => {
      if (!isSupabaseConfigured()) return;
      try {
        const balance = await fetchMyBalance();
        if (balance !== null && balance < GAMBA_STAKE && result && result.textContent === '') {
          result.textContent = GATE_TEXT;
        }
      } catch {
        // гейт — best effort, правда придёт с сервера
      }
    })();
  }

  function close(): void {
    if (spinning) {
      spinning = false;
      cancelAnimationFrame(raf);
      stopAll();
    }
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    setBusy(false);
  }

  async function spin(): Promise<void> {
    if (spinning || !modal) return;
    if (!isSupabaseConfigured()) {
      if (result) result.textContent = ERROR_TEXT;
      return;
    }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      if (result) result.textContent = OFFLINE_TEXT;
      return;
    }
    const sb = getSupabase();
    const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
    if (!data.session) {
      if (result) result.textContent = GUEST_TEXT;
      await signInWithTwitch(window.location.href.split('#')[0]);
      return;
    }
    // Предгейт по живому балансу — сервер всё равно перепроверит под локом.
    try {
      const balance = await fetchMyBalance();
      if (balance !== null && balance < GAMBA_STAKE) {
        if (result) result.textContent = GATE_TEXT;
        return;
      }
    } catch {
      // баланс не прочитался — дальше правда сервера
    }
    setBusy(true);
    if (result) result.textContent = 'Стучимся к серверу за исходом…';
    let spinOutcome: GambaOutcome;
    let spinBalance: number | null = null;
    // Ключ держится на попытку: генерируется на спин, повтор той же попытки
    // (ретрай/офлайн-повтор в spinGambaWithRetry, следующий клик после ошибки
    // без исхода) шлёт ТОТ ЖЕ ключ. Истекает только после показанного исхода
    // (см. конец animateToOutcome) — при ошибке ключ жив, дублей нет.
    attemptKey ??= newGambaAttemptKey();
    try {
      const done = await spinGambaWithRetry(attemptKey, { retries: 1 });
      spinOutcome = done.outcome;
      spinBalance = done.balance;
    } catch (err) {
      setBusy(false);
      const info = mapGambaError(err);
      if (!result) return;
      if (info.kind === 'insufficient-funds') {
        result.textContent = GATE_TEXT;
        return;
      }
      if (info.kind === 'unauthenticated') {
        result.textContent = GUEST_TEXT;
        await signInWithTwitch(window.location.href.split('#')[0]);
        return;
      }
      if (info.kind === 'rate-limit') {
        result.textContent = RATE_TEXT;
        return;
      }
      if (info.kind === 'daily-limit') {
        result.textContent = LIMIT_TEXT;
        return;
      }
      if (info.kind === 'offline') {
        result.textContent = OFFLINE_TEXT;
        return;
      }
      result.textContent = ERROR_TEXT;
      return;
    }
    // Баланс из ответа сервера — сразу в шапку (realtime дотянет остальных).
    if (spinBalance !== null) paintBalance(spinBalance);
    animateToOutcome(spinOutcome);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest?.('[data-gamba-button]')) {
      open();
      return;
    }
  });
  spinBtn?.addEventListener('click', () => {
    void spin();
  });
  closeBtn?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  draw(0);
</script>
