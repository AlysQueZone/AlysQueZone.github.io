---
// Заголовок лота с инлайн-эмоутами: токены (o7) → 7TV-картинки канала.
// Разбор — splitTitleEmotes из lib/emotes.ts; неизвестное остаётся текстом.
import { splitTitleEmotes } from '@/lib/emotes';

interface Props {
  title: string;
}

const { title } = Astro.props;
const segments = splitTitleEmotes(title);
---

{segments.map((segment) =>
  segment.type === 'emote' ? (
    <img
      src={segment.src}
      alt={segment.name}
      title={segment.name}
      loading="lazy"
      class="inline-block h-[1.1em] w-auto align-[-0.15em]"
    />
  ) : (
    segment.value
  )
)}
