---
// Компактная Карточка Лота (K1) для профиля чатерса: раскладка той же Карточки
// Лота, а не второе представление (docs/adr/0009). Слоты те же — ссылка,
// заголовок, кадр, цена и кнопка, — их заполняет lib/lot-view.ts (fillLot);
// кадр и бейджи приходят общими компонентами. Отличие: кадр 77:136 шириной
// 64px слева, справа название, отдельная строка цены и кнопка; строки
// владельца нет — все приветы на профиле принадлежат его хозяину.
// `data-lot-card` осознанно общий: карточка целиком — одна ссылка на Лот и
// кольцо фокуса (global.css), как на витрине.
import LotVideo from './LotVideo.astro';
import LotBadges from './LotBadges.astro';
import { LOT_CARD_ASPECT } from '@/lib/lot-video';

const base = import.meta.env.BASE_URL;
---

<article data-lot-card data-lot-compact class="card-pixel flex gap-3 p-3">
  <div class="w-16 shrink-0">
    <LotVideo videoUrl={null} title="" aspect={LOT_CARD_ASPECT}>
      <LotBadges />
    </LotVideo>
  </div>
  <div class="flex min-w-0 flex-1 flex-col">
    <h3 class="line-clamp-2 text-sm font-extrabold">
      <a data-lot-link href={`${base}lots/`} class="hover:text-ember">
        <span data-lot-title></span>
      </a>
    </h3>
    <p data-lot-price class="mt-1 font-black text-pivko">
      —
    </p>
    <button
      type="button"
      class="btn-arcade btn-arcade-primary mt-auto w-full px-3 py-1 text-xs"
      data-buy-intent
      disabled
    >
      ▶ Забрать
    </button>
  </div>
</article>
