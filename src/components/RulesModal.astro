---
// Окно «Правила биржи» (ребаланс, тикет 05): вся математика биржи в одном
// месте — комиссия, рост цены, гамба, вход. Цифры — зеркало спека
// scratch/pivkoin-economy/spec.md; гамба-строки живые из БД
// (public.gamba_payouts через fetchGambaPaytable), остальное — константы
// правил (фолбэк гамбы — GAMBA_PAYTABLE из lib/gamba.ts).
//
// Использование: положить <RulesModal /> на страницу с hero и повесить
// data-rules-button на кнопку открытия — скрипт ниже делегированный.
// Закрытие: «Понятно» / крестик / клик по затемнению / Escape.
import { GAMBA_DAILY_LIMIT, GAMBA_PAYTABLE } from '@/lib/gamba';
---

<div
  id="rules-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rules-title"
  tabindex="-1"
>
  <div class="card-pixel max-h-[85vh] w-full max-w-md overflow-y-auto p-5 text-left">
    <div class="flex items-start justify-between gap-3">
      <h3 id="rules-title" class="font-display text-[11px] leading-relaxed uppercase">
        Правила биржи
      </h3>
      <button
        type="button"
        data-rules-close
        aria-label="Закрыть правила"
        class="btn-arcade btn-arcade-ghost shrink-0 px-3 py-1 text-sm"
      >
        ✕
      </button>
    </div>
    <ul class="mt-4 flex flex-col gap-4 text-sm font-bold">
      <li>
        <p class="font-display text-[10px] uppercase text-ember">Комиссия биржи 7%</p>
        <p class="mt-1 text-mist/80">
          Платит продавец из выручки (округление вверх, минимум 1), комиссия сгорает. Покупатель
          платит ровно цену кнопки — без сюрпризов.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-stream">Рост цены</p>
        <p class="mt-1 text-mist/80">
          Первые 15 покупок лота поднимают цену на +10% (вверх, минимум +1), дальше — ровно на +1.
          Разгоняй первым — топы не улетают.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-pivko">
          Гамба · ставка 100 · {GAMBA_DAILY_LIMIT} спинов в день
        </p>
        <ul data-rules-gamba class="mt-1 flex flex-col gap-1 text-mist/80">
          {GAMBA_PAYTABLE.map((row) => (
            <li class="border-2 border-milk/60 bg-void px-2 py-1">
              {row.label} — {row.chance}
            </li>
          ))}
        </ul>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-rind">Ежедневный вход</p>
        <p class="mt-1 text-mist/80">
          Дни 1–3: 200 / 200 / 250. Дальше: 150 / 200 / 250 / 500 (7-й день), затем цикл заново.
          Старт — 1000. Пропуск streak не сбрасывает.
        </p>
      </li>
    </ul>
    <button
      type="button"
      data-rules-close
      class="btn-arcade btn-arcade-primary mt-5 w-full px-4 py-2 text-sm"
    >
      Понятно
    </button>
  </div>
</div>

<script>
  import { fetchGambaPaytable, type GambaPayRow } from '@/lib/gamba';
  import { trapFocus, releaseFocus } from '@/lib/modal-focus';

  const modal = document.getElementById('rules-modal');
  const gambaList = modal?.querySelector('[data-rules-gamba]');

  /** Живые строки гамбы из БД; молча — запечённый фолбэк выше. */
  function paintGamba(rows: GambaPayRow[]): void {
    if (!(gambaList instanceof HTMLUListElement)) return;
    gambaList.innerHTML = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.className = 'border-2 border-milk/60 bg-void px-2 py-1';
      li.textContent = `${row.label} — ${row.chance}`;
      gambaList.appendChild(li);
    }
  }

  function open(): void {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    trapFocus(modal);
    void (async () => {
      try {
        const live = await fetchGambaPaytable();
        if (live) paintGamba(live);
      } catch {
        // фолбэк уже запечён в разметке
      }
    })();
  }

  function close(): void {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    releaseFocus(modal);
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest?.('[data-rules-button]')) {
      open();
      return;
    }
    if (target?.closest?.('[data-rules-close]')) {
      close();
    }
  });
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
</script>
