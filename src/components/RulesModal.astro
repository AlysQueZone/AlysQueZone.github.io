---
// Окно «Правила биржи» (ребаланс, тикет 05): вся математика биржи в одном
// месте — комиссия, рост цены, гамба, вход. Гамба-строки живые из БД
// (public.gamba_payouts через fetchGambaPaytable), остальное — константы
// правил (фолбэк гамбы — GAMBA_PAYTABLE из lib/gamba.ts).
//
// Использование: положить <RulesModal /> на страницу с hero и повесить
// data-rules-button на кнопку открытия — скрипт ниже делегированный.
// Цикл (Escape / клик по затемнению / фокус) — общий lib/modal.ts; кнопки
// «Понятно» и крестик носят data-modal-close.
import { GAMBA_DAILY_LIMIT, GAMBA_PAYTABLE } from '@/lib/gamba';
import { commissionSplit, rewardLine, ROYALTY_PURCHASES } from '@/lib/prices';

// Цифры награды/комиссии — из зеркал lib/prices.ts (серверные ставки живут
// в public.commission_rate()/public.royalty_rate() и в pay_submission_reward).
const {
  commissionPct: COMMISSION_PCT,
  burnPct: BURN_PCT,
  royaltyPct: ROYALTY_PCT,
} = commissionSplit();
const REWARD_LINE = rewardLine();
---

<div
  id="rules-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="rules-title"
  tabindex="-1"
>
  <div class="card-pixel max-h-[85vh] w-full max-w-md overflow-y-auto p-5 text-left">
    <div class="flex items-start justify-between gap-3">
      <h3 id="rules-title" class="font-display text-[11px] leading-relaxed uppercase">
        Правила биржи
      </h3>
      <button
        type="button"
        data-modal-close
        aria-label="Закрыть правила"
        class="btn-arcade btn-arcade-ghost min-w-11 shrink-0 px-3 py-1 text-sm"
      >
        ✕
      </button>
    </div>
    <ul class="mt-4 flex flex-col gap-4 text-sm font-bold">
      <li>
        <p class="font-display text-[10px] uppercase text-ember">
          Комиссия биржи {COMMISSION_PCT}%
        </p>
        <p class="mt-1 text-mist">
          Платит продавец из выручки (округление вверх, минимум 1): {COMMISSION_PCT}%. {BURN_PCT}%
          сгорает, {ROYALTY_PCT}% уходит автору привета, принятого по заявке, за первые{' '}
          {ROYALTY_PURCHASES} перекупа; у лотов без автора сгорает вся комиссия. Покупатель платит
          ровно цену кнопки — без сюрпризов.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-melon">Награда за принятый привет</p>
        <p class="mt-1 text-mist">
          Прислал привет, который взяли на биржу, — {REWARD_LINE}. Бонус приходит один раз при
          принятии.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-stream">Рост цены</p>
        <p class="mt-1 text-mist">
          Первые 15 покупок лота поднимают цену на +10% (вверх, минимум +1), дальше — ровно на +1.
          Разгоняй первым — топы не улетают.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-blush">Владелец лота</p>
        <p class="mt-1 text-mist">
          Лот без владельца забирает первый покупатель. Дальше лот перекупают: выручку получает
          предыдущий владелец, минус комиссия.
        </p>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-pivko">
          Гамба · ставка 100 · {GAMBA_DAILY_LIMIT} спинов в день
        </p>
        <ul data-rules-gamba class="mt-1 flex flex-col gap-1 text-mist">
          {GAMBA_PAYTABLE.map((row) => (
            <li class="border-2 border-milk/60 bg-void px-2 py-1">
              {row.label} — {row.chance}
            </li>
          ))}
        </ul>
      </li>
      <li>
        <p class="font-display text-[10px] uppercase text-pivko">Ежедневный вход</p>
        <p class="mt-1 text-mist">
          Дни 1–3: 200 / 200 / 250. Дальше: 150 / 200 / 250 / 500 (7-й день), затем цикл заново.
          Старт — 1000. Пропуск streak не сбрасывает.
        </p>
      </li>
    </ul>
    <button
      type="button"
      data-modal-close
      class="btn-arcade btn-arcade-primary mt-5 w-full px-4 py-3 text-sm"
    >
      Понятно
    </button>
  </div>
</div>

<script>
  import { fetchGambaPaytable, type GambaPayRow } from '@/lib/gamba';
  import { createModal } from '@/lib/modal';

  const modal = document.getElementById('rules-modal');
  const gambaList = modal?.querySelector('[data-rules-gamba]');

  /** Живые строки гамбы из БД; молча — запечённый фолбэк выше. */
  function paintGamba(rows: GambaPayRow[]): void {
    if (!(gambaList instanceof HTMLUListElement)) return;
    gambaList.innerHTML = '';
    for (const row of rows) {
      const li = document.createElement('li');
      li.className = 'border-2 border-milk/60 bg-void px-2 py-1';
      li.textContent = `${row.label} — ${row.chance}`;
      gambaList.appendChild(li);
    }
  }

  const rules = createModal(modal, {
    onOpen() {
      void (async () => {
        try {
          const live = await fetchGambaPaytable();
          if (live) paintGamba(live);
        } catch {
          // фолбэк уже запечён в разметке
        }
      })();
    },
  });

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement | null)?.closest?.('[data-rules-button]');
    if (trigger instanceof HTMLElement) rules?.open(trigger);
  });
</script>
