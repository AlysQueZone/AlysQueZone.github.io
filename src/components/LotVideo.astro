---
// Инлайн-видео лота (прототип scratch/video-s3/prototype/inline-video.html):
// webp-постер + оверлей «▶ смотреть»; источники и клик — в lib/lot-video.ts.
// Корень рендерится всегда (шаблон карточки витрины заполняется клиентом);
// нет видео — корень скрыт. Один компонент на карточку и страницу лота.
import { videoSources } from '@/lib/lot-video';

interface Props {
  videoUrl?: string | null;
  title?: string;
}

const { videoUrl, title = '' } = Astro.props;
const { webm, mp4, poster } = videoSources(videoUrl);
const hasVideo = webm.length > 0;
---

<div
  data-lot-video-root
  data-video-webm={webm || undefined}
  data-video-mp4={mp4 || undefined}
  data-video-poster={poster || undefined}
  class:list={[
    'relative aspect-square w-full overflow-hidden border-2 border-milk bg-black',
    !hasVideo && 'hidden',
  ]}
>
  <img
    src={poster || undefined}
    alt={title}
    loading="lazy"
    class="h-full w-full object-cover"
    data-lot-video-poster
  />
  <button
    type="button"
    data-lot-video-play
    class="absolute inset-0 flex cursor-pointer items-center justify-center bg-black/35"
  >
    <span class="btn-arcade btn-arcade-primary px-4 py-3 text-xs">▶ смотреть</span>
  </button>
</div>

<script>
  import { initLotVideos } from '@/lib/lot-video';

  initLotVideos();
</script>
