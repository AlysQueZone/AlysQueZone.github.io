---
// Общий компонент покупки:
// модалка «Потратить N Пивкойнов?» + confetti + уведомления в тоне канала.
//
// Живёт в BaseLayout, а не на отдельной странице: кнопки возврата из колокола
// (перекуп) видны на любой странице, включая /deals/, и должны открывать ту же
// модалку. Кнопки покупки носят намерение в слоте data-buy-intent
// (lib/buy-intent.ts, writeBuyIntent: slug/title/price/owner/video); клик по
// кнопке с намерением сам откроет модалку — скрипт ниже делегированный.
// При покупке играет видео лота со звуком (видимо, в уведомлении); без video_url — clap с S3.
// Гость (нет сессии): модалка открывается в гостевом режиме — CTA «Войти через
// Twitch», без принудительного редиректа; после входа модалка вернётся к лоту.
// После покупки buyLot объявляет её модулю живых данных (lib/live.ts):
// шапку, витрину, страницу лота и колокол обновляют его события.
// Цикл окна (Escape / клик по затемнению / фокус) — общий lib/modal.ts:
// показ и живые проекции — в onOpen, снятие состояния — в onClose.
// Решения фаз и ошибок — в чистом lib/buy-core.ts; здесь разметка, тексты,
// таймер, сеть, live-подписки и pending-buy.
import { ALYSQUE_CLAP_DARK } from '@/lib/emotes';
import { s3Sound } from '@/lib/media';

// UI-звуки — публичный бакет media: абсолютный S3-URL без ${base}.
const clapSound = s3Sound('clap.mp3');
---

<div
  id="buy-modal"
  data-clap-sound={clapSound}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="buy-modal-title"
  tabindex="-1"
>
  <div class="card-pixel w-full max-w-sm p-5">
    <div class="flex items-center gap-3">
      <img
        src={ALYSQUE_CLAP_DARK}
        alt="alysqueCLAP"
        width="56"
        height="56"
        loading="lazy"
        class="h-14 w-14 shrink-0 border-2 border-milk object-contain"
      />
      <h3 id="buy-modal-title" class="font-display text-[11px] leading-relaxed uppercase">
        Купить привет?
      </h3>
    </div>
    <p id="buy-modal-text" class="mt-2 text-sm font-bold text-mist"></p>
    <p id="buy-note" class="mt-2 hidden text-xs font-bold text-mist">
      🔒 Войди через Twitch, чтобы забрать привет — вернёмся к нему после входа.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        id="buy-modal-yes"
        type="button"
        class="btn-arcade btn-arcade-primary px-4 py-3 text-sm"
      >
        Да, забираю
      </button>
      <button
        id="buy-modal-no"
        type="button"
        data-modal-close
        class="btn-arcade btn-arcade-ghost px-4 py-3 text-sm text-mist"
      >
        Не, пойду на стрим
      </button>
    </div>
  </div>
</div>

<script>
  // Денег в клиенте нет: гейт «хватит/не хватит» — серверный (`insufficient
  // funds`), итог — price_paid сервера, N — из живого каталога БД (lots.ts).
  // Локальный кошелёк удалён, фолбэка без настроенного хранилища нет:
  // подтверждать нечему — говорим честно.
  import { boom } from '@/lib/confetti';
  import { ALYSQUE_CLAP_DARK } from '@/lib/emotes';
  import { createModal } from '@/lib/modal';
  import { buyLot } from '@/lib/lots';
  import { live } from '@/lib/live';
  import {
    buyAvailability,
    findBuyButton,
    formatStaged,
    readBuyIntent,
    type BuyIntent,
  } from '@/lib/buy-intent';
  import {
    createBuyCore,
    pauseRemainingSec,
    type BuyEffect,
    type BuyErrorKind,
  } from '@/lib/buy-core';
  import { showSpotNotice } from '@/lib/notice';
  import { getSupabase, signInWithTwitch } from '@/lib/session';
  import {
    stashPendingBuy,
    peekPendingBuy,
    clearPendingBuy,
    returnUrlForLot,
  } from '@/lib/pending-buy';
  import { fetchSharedHistory } from '@/lib/purchases-read';

  const modal = document.getElementById('buy-modal');
  const modalText = document.getElementById('buy-modal-text');
  const modalTitle = document.getElementById('buy-modal-title');
  const noteEl = document.getElementById('buy-note');
  const yesBtn = document.getElementById('buy-modal-yes');
  const noBtn = document.getElementById('buy-modal-no');

  // Вся фазовая логика — в чистом ядре; здесь только его состояние и эффекты.
  const core = createBuyCore({ now: () => Date.now() });
  let pauseTimer: number | undefined;

  // display-mirror, source of truth — DB (c_cooldown/c_max_per_window/c_window в enforce_purchase_rules).
  const PAUSE_SEC = 30;
  // display-mirror, source of truth — DB (см. выше).
  const LIMIT_LABEL = 'Лимит: 10 покупок за 10 минут';

  // Цикл окна — общий модуль (Escape, клик-вне, фокус); здесь только показ
  // содержимого и живые проекции, а на закрытии — снятие своего состояния.
  const buyModal = createModal(modal, {
    onOpen() {
      const intent = core.state().intent;
      if (!intent) return;
      if (modalTitle) modalTitle.textContent = intent.title;
      render();
      // Баланс — зеркало серверного гейта: явная свежесть перед решением.
      void (async () => {
        applyEffects(core.dispatch({ type: 'refreshed', balance: await live.refreshBalance() }));
        render();
      })();
      // Живые проекции: пауза (моя последняя покупка этого лота) + цена (N
      // из снапшота; сюда же придёт событие явной свежести).
      const lotId = intent.slug;
      void live.refreshLot(lotId);
      void refreshPauseProjection(lotId);
    },
    onClose() {
      window.clearInterval(pauseTimer);
      pauseTimer = undefined;
      applyEffects(core.dispatch({ type: 'close' }));
      render();
    },
  });

  function buyLabel(price: number | null): string {
    return `Забрать за ${formatStaged(price)} 🍺`;
  }

  /** Текст окна: у гостя — «Цена: …» справочно, у своих — приглашение потратить. */
  function modalTextFor(price: number | null, owner: string, guest: boolean): string {
    const n = formatStaged(price);
    return guest
      ? `Цена: ${n} Пивкойнов. Владелец: ${owner}`
      : `Потратить ${n} Пивкойнов? Владелец: ${owner}`;
  }

  /** Оформление гостевого режима: твичевая CTA + пояснение про вход. */
  function applyGuestUi(guest: boolean): void {
    if (yesBtn instanceof HTMLButtonElement) {
      yesBtn.classList.toggle('btn-arcade-primary', !guest);
      yesBtn.classList.toggle('bg-twitch', guest);
      yesBtn.classList.toggle('text-white', guest);
    }
    noteEl?.classList.toggle('hidden', !guest);
  }

  function pauseLabel(left: number): string {
    return `Жди ${left} с`;
  }

  function playClapFallback(): void {
    try {
      const src = modal?.dataset.clapSound;
      if (!src) return;
      const audio = new Audio(src);
      audio.volume = 0.8;
      const p = audio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      // graceful-fallback: без звука, покупка всё равно засчитана
    }
  }

  /** Успех: деньги списал сервер (дебет/кредит + леджер в AFTER-триггере);
   *  покупку уже объявил buyLot модулю живых данных — шапка, витрина и
   *  колокол обновятся его событиями.
   *  Итог — фактически уплаченная серверная цена + confetti + видео лота
   *  в уведомлении (без video_url — clap с S3). */
  function celebrate(paid: number): void {
    const intent = core.state().intent;
    if (!intent) return;
    boom();
    const amount = paid > 0 ? paid : (intent.price ?? 0);
    const text = `ЗАБРАЛ! Привет твой: ${intent.title} — ушло ${amount} Пивкойнов`;
    if (intent.video) {
      showSpotNotice({
        text,
        tone: 'ok',
        video: { src: intent.video, onError: playClapFallback },
        dismissOnOutside: true,
      });
    } else {
      playClapFallback();
      showSpotNotice({
        text,
        tone: 'ok',
        image: { src: ALYSQUE_CLAP_DARK, alt: 'alysqueCLAP' },
      });
    }
  }

  /** Единая точка правды для кнопки: гость/транзит/лимит/пауза/нехватка/цена. */
  function render(): void {
    const st = core.state();
    const intent = st.intent;
    const guest = st.phase === 'guest';
    if (modalText && intent)
      modalText.textContent = modalTextFor(intent.price, intent.owner, guest);
    applyGuestUi(guest);
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    if (noBtn instanceof HTMLButtonElement) noBtn.disabled = st.phase === 'busy';
    if (st.phase === 'guest') {
      yesBtn.disabled = false;
      yesBtn.textContent = '▶ Войти через Twitch';
      return;
    }
    if (st.phase === 'busy') {
      yesBtn.disabled = true;
      yesBtn.textContent = 'Ждём сервер…';
      return;
    }
    if (st.phase === 'limit') {
      yesBtn.disabled = true;
      yesBtn.textContent = LIMIT_LABEL;
      return;
    }
    if (st.phase === 'pause') {
      yesBtn.disabled = true;
      yesBtn.textContent = pauseLabel(st.pauseLeft);
      return;
    }
    // Общее правило доступности (lib/buy-intent.ts): не хватает — кнопка
    // гаснет; N неизвестна — не гасим, сравнить не с чем (решает сервер).
    const availability = intent ? buyAvailability(intent, st.balance) : 'available';
    yesBtn.disabled = availability === 'short';
    yesBtn.textContent =
      availability === 'short'
        ? 'Не хватает Пивкойнов'
        : intent
          ? buyLabel(intent.price)
          : 'Забрать';
  }

  /** Тексты «вид ошибки → строка»: ядро отдаёт вид, копирайт остаётся здесь. */
  function showBuyNotice(kind: BuyErrorKind): void {
    switch (kind) {
      case 'insufficient-funds':
        showSpotNotice({
          text: 'Не хватает Пивкойнов — пойжем жоско в гамбу или забери Ежедневный вход, а этот привет подождёт.',
          tone: 'bad',
        });
        break;
      case 'own-lot':
        showSpotNotice({ text: 'Этот привет уже твой — перекупать нечего.', tone: 'bad' });
        break;
      case 'missing-lot':
        showSpotNotice({
          text: 'Лот ещё не переехал в общее хранилище — покупка не записана, Пивкойны целы.',
          tone: 'bad',
        });
        break;
      case 'price-cap':
        showSpotNotice({
          text: 'Цена упёрлась в потолок — дальше некуда, Пивкойны целы.',
          tone: 'bad',
        });
        break;
      case 'offline':
        showSpotNotice({
          text: 'Сеть упала: покупка не записана, Пивкойны целы. Попробуй ещё.',
          tone: 'bad',
        });
        break;
      default:
        showSpotNotice({
          text: 'Не записалось в общее хранилище — Пивкойны целы, попробуй ещё.',
          tone: 'bad',
        });
        break;
    }
  }

  /** Пауза видна честно: живой отсчёт на кнопке + «Подожди N с» в уведомлении. */
  function startPause(seconds: number): void {
    window.clearInterval(pauseTimer);
    render();
    showSpotNotice({
      text: `Подожди ${seconds} с — этот лот можно забрать повторно через ${seconds} с.`,
      tone: 'bad',
    });
    pauseTimer = window.setInterval(() => {
      applyEffects(core.dispatch({ type: 'tick' }));
      if (core.state().phase !== 'pause') {
        window.clearInterval(pauseTimer);
        pauseTimer = undefined;
      }
      render();
    }, 1000);
  }

  /** Кап окна: кнопка показывает лимит до закрытия модалки. */
  function showLimit(): void {
    window.clearInterval(pauseTimer);
    pauseTimer = undefined;
    render();
    showSpotNotice({
      text: 'Лимит: 10 покупок за 10 минут — приходи позже, Пивкойны целы.',
      tone: 'bad',
    });
  }

  /** Эффекты ядра — единственное место, где состояние превращается в DOM/сеть. */
  function applyEffects(effects: readonly BuyEffect[]): void {
    for (const effect of effects) {
      switch (effect.type) {
        case 'celebrate':
          celebrate(effect.paid);
          break;
        case 'close':
          buyModal?.close();
          break;
        case 'pauseTimer':
          startPause(effect.seconds);
          break;
        case 'limit':
          showLimit();
          break;
        case 'notice':
          showBuyNotice(effect.kind);
          break;
        case 'refreshPrice':
          void live.refreshLot(effect.slug);
          break;
      }
    }
  }

  /**
   * Проекция паузы из shared-истории: моя последняя покупка ЭТОГО лота.
   * Чужой выкуп сюда не попадает (фильтр по buyer_uid), так что таймер не трогает.
   * Страница истории — новые первыми (одна страница, а не вся история): пауза
   * короткая, поэтому моя последняя покупка почти всегда в первой же странице,
   * и первая моя строка — она. Дальше виденного сервер остаётся правдой в
   * последней инстанции (см. pauseTimer в applyEffects).
   */
  async function refreshPauseProjection(lotId: string): Promise<void> {
    const st = core.state();
    if (!st.intent || st.intent.slug !== lotId) return;
    if (st.phase === 'limit' || st.phase === 'pause' || st.phase === 'busy') return;
    try {
      const uid = live.uid();
      if (!uid) return;
      const history = await fetchSharedHistory(lotId);
      for (const entry of history) {
        if (entry.buyer_uid !== uid) continue;
        const current = core.state();
        if (!current.intent || current.intent.slug !== lotId) return;
        if (current.phase === 'limit' || current.phase === 'pause' || current.phase === 'busy') {
          return;
        }
        const remaining = pauseRemainingSec(Date.parse(entry.created_at), Date.now(), PAUSE_SEC);
        if (remaining > 0) {
          applyEffects(core.dispatch({ type: 'pause', seconds: remaining }));
        }
        return;
      }
    } catch {
      // проекция — best effort, правда придёт с сервера
    }
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest?.('[data-buy-intent]');
    if (!(btn instanceof HTMLElement)) return;
    if (btn instanceof HTMLButtonElement && btn.disabled) return;
    const intent = readBuyIntent(btn);
    if (!intent) return;
    // Разметка модалки статична; без неё открывать нечего (гард прежнего цикла).
    if (!(modal && modalText && modalTitle)) return;
    // Без сессии — не уводим принудительно: открываем ту же модалку в гостевом
    // режиме, где CTA — вход через Twitch. Лот запоминается внутри неё.
    let guest = false;
    const sb = getSupabase();
    if (sb) {
      const { data } = await sb.auth.getSession();
      guest = !data.session;
    }
    applyEffects(core.dispatch({ type: 'intent', intent, guest }));
    buyModal?.open(btn);
  });

  yesBtn?.addEventListener('click', async () => {
    const intent = core.state().intent;
    if (!intent) return;
    // Гостевой режим: кнопка — вход через Twitch. Запоминаем лот, чтобы после
    // возврата модалка открылась снова уже для подтверждения покупки.
    if (core.state().phase === 'guest') {
      stashPendingBuy(intent.slug);
      await signInWithTwitch(returnUrlForLot(intent.slug));
      return;
    }
    // Гейт «хватит/не хватит» — серверный: BEFORE ответит
    // `insufficient funds`, покажем честно. Без настроенного хранилища
    // покупать нечего — честная ошибка, деньги целы.
    if (!getSupabase()) {
      showSpotNotice({
        text: 'Хранилище не настроено — покупка не записана, Пивкойны целы.',
        tone: 'bad',
      });
      return;
    }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      showSpotNotice({
        text: 'Офлайн: покупка не записана, Пивкойны целы. Вернись с сетью.',
        tone: 'bad',
      });
      return;
    }
    // Сессия могла кончиться после открытия модалки — в гостевой режим, без
    // принудительного редиректа.
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data.session) {
      applyEffects(
        core.dispatch({
          type: 'result',
          result: { status: 'blocked', kind: 'unauthenticated', raw: 'no session' },
        })
      );
      render();
      return;
    }
    // Перекуп за одним швом (buyLot из lib/lots.ts): свежая N, INSERT,
    // маппинг ошибок — внутри. Здесь только транзит и передача итога в ядро.
    applyEffects(core.dispatch({ type: 'busy' }));
    render();
    let result: Awaited<ReturnType<typeof buyLot>>;
    try {
      result = await buyLot(intent.slug);
    } catch {
      applyEffects(
        core.dispatch({
          type: 'result',
          result: { status: 'blocked', kind: 'write-error', raw: 'supabase not configured' },
        })
      );
      render();
      return;
    }
    applyEffects(core.dispatch({ type: 'result', result }));
    render();
  });

  // Снапшот живых данных: свежий баланс для гейта и проекции открытого лота
  // (цена/владелец) — по событию каталога, без отдельного канала.
  live.subscribe((change) => {
    if (change.kind === 'balance') {
      applyEffects(core.dispatch({ type: 'refreshed', balance: change.balance }));
      render();
      return;
    }
    // Сессия доехала позже (возврат из логина): пауза могла не спроецироваться.
    const st = core.state();
    if (!st.intent) return;
    if (change.kind === 'uid') {
      void refreshPauseProjection(st.intent.slug);
      return;
    }
    if (change.kind === 'catalog' && change.changed.has(st.intent.slug)) {
      const lot = live.lot(st.intent.slug);
      if (!lot) return;
      // N неизвестна (вью отсутствует) — намерение несёт price: null: честный
      // «…» и никакого сравнения с балансом; итог всё равно посчитает сервер.
      applyEffects(
        core.dispatch({
          type: 'refreshed',
          price: lot.nextPrice,
          owner: lot.owner_login ?? undefined,
        })
      );
      render();
      void refreshPauseProjection(st.intent.slug);
    }
  });

  /** Ждать появления кнопки покупки Лота: витрина/страница рисуют карточку
   *  из БД после загрузки, кнопки в DOM сразу нет. Без этого возврат из логина
   *  терялся. Ищем по слоту намерения (lib/buy-intent.ts). */
  function waitForBuyButton(slug: string, timeoutMs: number): Promise<HTMLElement | null> {
    const immediate = findBuyButton(slug);
    if (immediate) return Promise.resolve(immediate);
    return new Promise((resolve) => {
      const started = Date.now();
      const poll = window.setInterval(() => {
        const el = findBuyButton(slug);
        if (el || Date.now() - started >= timeoutMs) {
          window.clearInterval(poll);
          resolve(el);
        }
      }, 150);
    });
  }

  // Возврат из логина: Чатерс залогинен — переоткрыть модалку того
  // же Лота. Лот не стираем, пока модалка не открылась, — иначе возврат теряется.
  void (async () => {
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data.session) return;
    const id = peekPendingBuy();
    if (!id) return;
    const btn = await waitForBuyButton(id, 8000);
    if (btn instanceof HTMLElement) {
      clearPendingBuy();
      btn.click();
      return;
    }
    // Карточки на странице может не быть вовсе (/deals/, 404): модалка живёт
    // в макете, поэтому открываем её по свежим данным лота, без кнопки-якоря.
    const st = await live.refreshLot(id);
    if (!st) return;
    const restored: BuyIntent = {
      slug: st.slug,
      title: st.title,
      price: st.nextPrice,
      owner: st.owner_login ?? '—',
      video: st.video_url,
    };
    clearPendingBuy();
    applyEffects(core.dispatch({ type: 'intent', intent: restored, guest: false }));
    buyModal?.open(null);
  })();
</script>
