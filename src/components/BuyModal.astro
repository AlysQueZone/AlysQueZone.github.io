---
// Общий компонент покупки (тикеты 10 «биржа» и 11 «карточка»):
// модалка «Потратить N Пивкойнов?» + confetti + уведомления в тоне канала.
//
// Использование: положить <BuyModal /> на страницу и вешать на кнопки
// data-buy-lot="<id>" data-lot-title="<title>" data-lot-price="<n>"
// data-lot-owner="<owner>" data-lot-video="<video_url>".
// При покупке играет видео лота со звуком (видимо, в уведомлении); без video_url — clap с S3.
// Клик по такой кнопке сам откроет модалку — скрипт ниже делегированный.
// После покупки кидается window CustomEvent('alysque:bought', { detail: { id } }).
import { ALYSQUE_CLAP_DARK } from '@/lib/emotes';
import { s3Sound } from '@/lib/media';

// UI-звуки — публичный бакет media (тикет 10, §3 спеки): абсолютный S3-URL без ${base}.
const clapSound = s3Sound('clap.mp3');
---

<div
  id="buy-modal"
  data-clap-sound={clapSound}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="buy-modal-title"
>
  <div class="card-pixel w-full max-w-sm p-5">
    <div class="flex items-center gap-3">
      <img
        src={ALYSQUE_CLAP_DARK}
        alt="alysqueCLAP"
        width="56"
        height="56"
        loading="lazy"
        class="h-14 w-14 shrink-0 border-2 border-milk object-contain"
      />
      <h3 id="buy-modal-title" class="font-display text-[11px] leading-relaxed uppercase">
        Купить привет?
      </h3>
    </div>
    <p id="buy-modal-text" class="mt-2 text-sm font-bold text-mist"></p>
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        id="buy-modal-yes"
        type="button"
        class="btn-arcade btn-arcade-primary px-4 py-2 text-sm"
      >
        Да, забираю
      </button>
      <button
        id="buy-modal-no"
        type="button"
        class="btn-arcade btn-arcade-ghost px-4 py-2 text-sm text-mist"
      >
        Не, пойду на стрим
      </button>
    </div>
  </div>
</div>

<div
  id="buy-notice"
  class="card-pixel fixed bottom-16 left-1/2 z-50 hidden max-w-[calc(100vw-2rem)] -translate-x-1/2 px-8 py-4 text-center text-xl font-black whitespace-nowrap"
  role="status"
></div>

<script>
  // Денег в клиенте нет: гейт «хватит/не хватит» — серверный (`insufficient
  // funds`), итог — price_paid сервера, N — из прайс-фида БД (тикет 11).
  // Локальный кошелёк удалён, фолбэка без настроенного хранилища нет:
  // подтверждать нечему — говорим честно.
  import { boom } from '@/lib/confetti';
  import { fetchLotPrice, fetchNextPrice } from '@/lib/prices';
  import {
    getSupabase,
    isSupabaseConfigured,
    signInWithTwitch,
    stashPendingBuy,
    takePendingBuy,
    returnUrlForLot,
    buyLotShared,
    mapBuyError,
    fetchSharedHistory,
    getSessionUid,
    subscribeSharedLots,
  } from '@/lib/supabase';

  const modal = document.getElementById('buy-modal');
  const modalText = document.getElementById('buy-modal-text');
  const modalTitle = document.getElementById('buy-modal-title');
  const yesBtn = document.getElementById('buy-modal-yes');
  const noBtn = document.getElementById('buy-modal-no');
  const notice = document.getElementById('buy-notice');

  let pending: { id: string; title: string; price: number; owner: string; video?: string } | null =
    null;
  let noticeTimer: number | undefined;
  let pauseTimer: number | undefined;
  /** Сколько секунд паузы осталось на кнопке (0 — кнопка свободна). */
  let pauseLeft = 0;
  /** Кап окна сработал: кнопка показывает лимит до закрытия модалки. */
  let limitHit = false;
  /** Живая подписка на лот открытой модалки (пауза + цена, снимается при закрытии). */
  let lotUnsub: (() => void) | null = null;

  // display-mirror, source of truth — DB (c_cooldown/c_max_per_window/c_window в enforce_purchase_rules).
  const PAUSE_SEC = 30;
  // display-mirror, source of truth — DB (см. выше).
  const LIMIT_LABEL = 'Лимит: 10 покупок за 10 минут';

  function buyLabel(price: number): string {
    return `Забрать за ${price} 🍺`;
  }

  function pauseLabel(left: number): string {
    return `Жди ${left} с`;
  }

  const CLAP_URL =
    'https://static-cdn.jtvnw.net/emoticons/v2/emotesv2_1075070639054e5d8cacb8a0ef4872d7/default/dark/3.0';

  function playClapFallback(): void {
    try {
      const src = modal?.dataset.clapSound;
      if (!src) return;
      const audio = new Audio(src);
      audio.volume = 0.8;
      const p = audio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      // graceful-fallback: без звука, покупка всё равно засчитана
    }
  }

  /** Успех: деньги списал сервер (дебет/кредит + леджер в AFTER-триггере),
   *  шапка подтянет новый баланс из БД по realtime-подписке.
   *  Итог — фактически уплаченная серверная цена + confetti + видео лота
   *  в уведомлении (без video_url — clap с S3). «Мои приветы» обновит
   *  витрина из shared по событию. */
  function celebrate(entry: {
    id: string;
    title: string;
    price: number;
    owner: string;
    video?: string;
  }): void {
    closeModal();
    boom();
    if (entry.video) {
      showNotice(
        `ЗАБРАЛ! Привет твой: ${entry.title} — ушло ${entry.price} Пивкойнов`,
        true,
        entry.video
      );
    } else {
      playClapFallback();
      showNotice(`ЗАБРАЛ! Привет твой: ${entry.title} — ушло ${entry.price} Пивкойнов`, true);
    }
    window.dispatchEvent(
      new CustomEvent('alysque:bought', { detail: { id: entry.id, price: entry.price } })
    );
  }

  function showNotice(text: string, ok: boolean, videoUrl?: string): void {
    if (!notice) return;
    notice.innerHTML = '';
    let videoEl: HTMLVideoElement | null = null;
    // Сброс варианта: текстовый — плашка снизу, с видео — большое окно по центру.
    notice.classList.remove(
      'whitespace-nowrap',
      'whitespace-normal',
      'max-w-lg',
      'flex-col',
      'items-start',
      'gap-2',
      'text-base',
      'text-lg',
      'top-1/2',
      '-translate-y-1/2'
    );
    notice.classList.add('bottom-16');
    const span = document.createElement('span');
    span.textContent = text;
    notice.appendChild(span);
    if (videoUrl) {
      // Видео-вариант: большое окно строго по центру экрана.
      notice.classList.remove('bottom-16');
      notice.classList.add(
        'whitespace-normal',
        'max-w-lg',
        'flex-col',
        'items-start',
        'gap-2',
        'text-lg',
        'top-1/2',
        '-translate-y-1/2'
      );
      const video = document.createElement('video');
      video.src = videoUrl;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.preload = 'auto';
      video.className = 'mt-1 w-full border-2 border-milk';
      notice.appendChild(video);
      try {
        const p = video.play();
        if (p && typeof p.catch === 'function') p.catch(() => playClapFallback());
      } catch {
        playClapFallback();
      }
      video.addEventListener('error', () => playClapFallback());
      // Окно живёт до конца видео и прячется сразу; 30с — страховка,
      // если 'ended' не выстрелит.
      video.addEventListener('ended', () => {
        window.clearTimeout(noticeTimer);
        notice.classList.add('hidden');
      });
      videoEl = video;
    } else if (ok) {
      const img = document.createElement('img');
      img.src = CLAP_URL;
      img.alt = 'alysqueCLAP';
      img.width = 28;
      img.height = 28;
      img.loading = 'eager';
      img.className = 'ml-2 inline h-7 w-7 object-contain';
      notice.appendChild(img);
      notice.classList.add('flex', 'items-center');
    } else {
      notice.classList.remove('flex', 'items-center');
    }
    notice.classList.remove('hidden', 'border-rind', 'border-melon');
    notice.classList.add(ok ? 'border-rind' : 'border-melon');
    window.clearTimeout(noticeTimer);
    // С видео окно не прячем через 2.6с — его закроет 'ended' (+2.5с); 30с — страховка.
    const ttl = videoEl ? 30000 : 2600;
    noticeTimer = window.setTimeout(() => notice.classList.add('hidden'), ttl);
  }

  function setBusy(busy: boolean): void {
    if (yesBtn instanceof HTMLButtonElement) yesBtn.disabled = busy;
    if (noBtn instanceof HTMLButtonElement) noBtn.disabled = busy;
  }

  /** Возвращает кнопку в свободное состояние (цена pending, без таймера). */
  function restoreBuyButton(): void {
    window.clearInterval(pauseTimer);
    pauseLeft = 0;
    limitHit = false;
    setBusy(false);
    if (yesBtn instanceof HTMLButtonElement) {
      yesBtn.textContent = pending ? buyLabel(pending.price) : 'Забрать';
    }
  }

  /** Пауза видна честно: живой отсчёт на кнопке + «Подожди N с» в уведомлении. */
  function startPause(sec: number): void {
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    window.clearInterval(pauseTimer);
    limitHit = false;
    let left = sec > 0 ? sec : PAUSE_SEC;
    pauseLeft = left;
    setBusy(true);
    yesBtn.textContent = pauseLabel(left);
    showNotice(`Подожди ${left} с — этот лот можно забрать повторно через ${left} с.`, false);
    pauseTimer = window.setInterval(() => {
      left -= 1;
      pauseLeft = left;
      if (!(yesBtn instanceof HTMLButtonElement)) {
        window.clearInterval(pauseTimer);
        return;
      }
      if (left <= 0) {
        restoreBuyButton();
        // Пауза отпустила — цена могла уйти: подтянуть живую N из БД.
        const id = pending?.id;
        if (id) void refreshPriceProjection(id);
      } else {
        yesBtn.textContent = pauseLabel(left);
      }
    }, 1000);
  }

  /** Кап окна: кнопка показывает лимит до закрытия модалки. */
  function showLimit(): void {
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    window.clearInterval(pauseTimer);
    pauseLeft = 0;
    limitHit = true;
    setBusy(true);
    yesBtn.textContent = LIMIT_LABEL;
  }

  function stopLotProjection(): void {
    if (lotUnsub) {
      try {
        lotUnsub();
      } catch {
        // отписка — best effort
      }
      lotUnsub = null;
    }
  }

  /**
   * Проекция паузы из shared-истории: моя последняя покупка ЭТОГО лота.
   * Чужой выкуп сюда не попадает (фильтр по buyer_uid), так что таймер не трогает.
   * Серверная ошибка — правда в последней инстанции (см. startPause в обработчике).
   */
  async function refreshPauseProjection(lotId: string): Promise<void> {
    if (!pending || pending.id !== lotId || limitHit || pauseLeft > 0) return;
    if (!isSupabaseConfigured()) return;
    try {
      const uid = await getSessionUid();
      if (!uid || !pending || pending.id !== lotId) return;
      const history = await fetchSharedHistory(lotId, pending.owner);
      for (let i = history.length - 1; i >= 0; i -= 1) {
        const entry = history[i];
        if (!entry || entry.buyer_uid !== uid) continue;
        const boughtAt = Date.parse(entry.created_at);
        if (!Number.isFinite(boughtAt)) return;
        const remaining = Math.ceil(PAUSE_SEC - (Date.now() - boughtAt) / 1000);
        if (remaining > 0 && pending && pending.id === lotId && pauseLeft <= 0 && !limitHit) {
          startPause(remaining);
        }
        return;
      }
    } catch {
      // проекция — best effort, правда придёт с сервера
    }
  }

  /**
   * Проекция цены из прайс-фида БД (тикет 11): лот перекупили при открытой
   * модалке — новая N видна до нажатия, отдельного ретрая нет.
   * Пауза/лимит владеют кнопкой — их не затираем; когда отпустят,
   * цена подтянется (см. конец startPause).
   */
  async function refreshPriceProjection(lotId: string): Promise<void> {
    if (!pending || pending.id !== lotId || limitHit || pauseLeft > 0) return;
    if (!isSupabaseConfigured()) return;
    try {
      const row = await fetchLotPrice(lotId);
      if (!row || !pending || pending.id !== lotId || limitHit || pauseLeft > 0) return;
      if (row.owner_login) pending.owner = row.owner_login;
      const next = row.nextPrice;
      // N неизвестна (вью отсутствует) — честный «…» вместо staged как N;
      // итог всё равно посчитает сервер.
      if (typeof next !== 'number' || !Number.isFinite(next) || next <= 0) {
        if (modalText) {
          modalText.textContent = `Потратить … Пивкойнов? Владелец: ${pending.owner}`;
        }
        if (yesBtn instanceof HTMLButtonElement && !yesBtn.disabled) {
          yesBtn.textContent = 'Забрать за … 🍺';
        }
        return;
      }
      if (next === pending.price) {
        if (modalText && row.owner_login) {
          modalText.textContent = `Потратить ${pending.price} Пивкойнов? Владелец: ${pending.owner}`;
        }
        return;
      }
      pending.price = next;
      if (modalText) {
        modalText.textContent = `Потратить ${next} Пивкойнов? Владелец: ${pending.owner}`;
      }
      if (yesBtn instanceof HTMLButtonElement && !yesBtn.disabled) {
        yesBtn.textContent = buyLabel(next);
      }
    } catch {
      // проекция — best effort, правда придёт с сервера
    }
  }

  function openModal(): void {
    if (!modal || !pending || !modalText || !modalTitle) return;
    modalTitle.textContent = pending.title;
    modalText.textContent = `Потратить ${pending.price} Пивкойнов? Владелец: ${pending.owner}`;
    stopLotProjection();
    restoreBuyButton();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    // Живые проекции: пауза (моя последняя покупка этого лота) + цена (N из БД).
    const lotId = pending.id;
    try {
      lotUnsub = subscribeSharedLots(() => {
        void refreshPauseProjection(lotId);
        void refreshPriceProjection(lotId);
      }, lotId);
    } catch {
      lotUnsub = null;
    }
    void refreshPauseProjection(lotId);
    void refreshPriceProjection(lotId);
  }

  function closeModal(): void {
    stopLotProjection();
    pending = null;
    restoreBuyButton();
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest?.('[data-buy-lot]');
    if (!(btn instanceof HTMLElement)) return;
    if (btn instanceof HTMLButtonElement && btn.disabled) return;
    const { buyLot: id, lotTitle, lotPrice, lotOwner, lotVideo } = btn.dataset;
    if (!id) return;
    // Без сессии — в логин через Twitch с возвратом к тому же Лоту (тикет 09).
    // Витрина открыта всем, модалка переоткроется после возврата.
    if (isSupabaseConfigured()) {
      const sb = getSupabase();
      const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
      if (!data.session) {
        stashPendingBuy(id);
        showNotice(
          'СТРИМ ВКЛЮЧИЛСЯ, А ТЫ? Сначала вход через Twitch — потом вернём к лоту.',
          false
        );
        await signInWithTwitch(returnUrlForLot(id));
        return;
      }
    }
    pending = {
      id,
      title: lotTitle ?? id,
      price: Number(lotPrice ?? 0),
      owner: lotOwner ?? '?',
      video: lotVideo,
    };
    openModal();
  });

  yesBtn?.addEventListener('click', async () => {
    if (!pending) return;
    const { id, title, owner, video } = pending;
    let price = pending.price;
    // Гейт «хватит/не хватит» — серверный (тикет 08): BEFORE ответит
    // `insufficient funds`, покажем честно. Без настроенного хранилища
    // покупать нечего — честная ошибка, деньги целы.
    if (!isSupabaseConfigured()) {
      showNotice('Хранилище не настроено — покупка не записана, Пивкойны целы.', false);
      return;
    }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      showNotice('Офлайн: покупка не записана, Пивкойны целы. Вернись с сетью.', false);
      return;
    }
    // Сессия могла кончиться после открытия модалки — в логин с возвратом к Лоту.
    const sb = getSupabase();
    const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
    if (!data.session) {
      stashPendingBuy(id);
      showNotice(
        'СТРИМ ВКЛЮЧИЛСЯ, А ТЫ? Сессия кончилась — войди через Twitch, потом вернём к лоту.',
        false
      );
      await signInWithTwitch(returnUrlForLot(id));
      return;
    }
    // Shared-покупка (тикет 10): свежий select N перед записью + INSERT
    // с ожиданием confirm сервера. Итог — фактически уплаченная цена.
    setBusy(true);
    if (yesBtn instanceof HTMLButtonElement) yesBtn.textContent = 'Ждём сервер…';
    try {
      const fresh = await fetchNextPrice(id);
      if (fresh !== null && Number.isFinite(fresh) && fresh > 0 && pending && pending.id === id) {
        price = fresh;
        pending.price = fresh;
      }
      const done = await buyLotShared(id);
      const paid =
        Number.isFinite(done.price_paid) && done.price_paid > 0 ? done.price_paid : price;
      celebrate({ id, title, price: paid, owner, video });
    } catch (err) {
      const info = mapBuyError(err);
      if (info.kind === 'cooldown') {
        startPause(info.retryAfterSec ?? PAUSE_SEC);
        return;
      }
      if (info.kind === 'rate-limit') {
        showLimit();
        showNotice('Лимит: 10 покупок за 10 минут — приходи позже, Пивкойны целы.', false);
        return;
      }
      restoreBuyButton();
      if (info.kind === 'insufficient-funds') {
        closeModal();
        showNotice(
          'Не хватает Пивкойнов — пойжем жоско в гамбу или забери Ежедневный вход, а этот привет подождёт.',
          false
        );
        return;
      }
      if (info.kind === 'unauthenticated') {
        stashPendingBuy(id);
        showNotice(
          'СТРИМ ВКЛЮЧИЛСЯ, А ТЫ? Сессия кончилась — войди через Twitch, потом вернём к лоту.',
          false
        );
        await signInWithTwitch(returnUrlForLot(id));
        return;
      }
      switch (info.kind) {
        case 'own-lot':
          showNotice('Этот привет уже твой — перекупать нечего.', false);
          break;
        case 'missing-lot':
          showNotice(
            'Лот ещё не переехал в общее хранилище — покупка не записана, Пивкойны целы.',
            false
          );
          break;
        case 'price-cap':
          showNotice('Цена упёрлась в потолок — дальше некуда, Пивкойны целы.', false);
          break;
        case 'offline':
          showNotice('Сеть упала: покупка не записана, Пивкойны целы. Попробуй ещё.', false);
          break;
        default:
          showNotice('Не записалось в общее хранилище — Пивкойны целы, попробуй ещё.', false);
          break;
      }
    }
  });

  noBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Возврат из логина (тикет 09): Чатерс залогинен — переоткрыть модалку того же Лота.
  void (async () => {
    if (!isSupabaseConfigured()) return;
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data.session) return;
    const id = takePendingBuy();
    if (!id) return;
    const sel = `[data-buy-lot="${typeof CSS !== 'undefined' && CSS.escape ? CSS.escape(id) : id}"]`;
    const btn = document.querySelector(sel);
    if (btn instanceof HTMLElement) {
      window.setTimeout(() => btn.click(), 350);
    }
  })();
</script>
