---
// Общий компонент покупки (тикеты 10 «биржа» и 11 «карточка»):
// модалка «Потратить N Пивкойнов?» + confetti + уведомления в тоне канала.
//
// Использование: положить <BuyModal /> на страницу; кнопки покупки носят
// намерение в слоте data-buy-intent (lib/buy-intent.ts, writeBuyIntent:
// slug/title/price/owner/video). Клик по кнопке с намерением сам откроет
// модалку — скрипт ниже делегированный.
// При покупке играет видео лота со звуком (видимо, в уведомлении); без video_url — clap с S3.
// Гость (нет сессии): модалка открывается в гостевом режиме — CTA «Войти через
// Twitch», без принудительного редиректа; после входа модалка вернётся к лоту.
// После покупки — announceBought({ id, price }) из lib/lots.ts
// (типизированный announce/listen; слушают витрина, страница лота, колокол).
// Цикл окна (Escape / клик по затемнению / фокус) — общий lib/modal.ts:
// показ и живые проекции — в onOpen, снятие состояния — в onClose.
import { ALYSQUE_CLAP_DARK } from '@/lib/emotes';
import { s3Sound } from '@/lib/media';

// UI-звуки — публичный бакет media (тикет 10, §3 спеки): абсолютный S3-URL без ${base}.
const clapSound = s3Sound('clap.mp3');
---

<div
  id="buy-modal"
  data-clap-sound={clapSound}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="buy-modal-title"
  tabindex="-1"
>
  <div class="card-pixel w-full max-w-sm p-5">
    <div class="flex items-center gap-3">
      <img
        src={ALYSQUE_CLAP_DARK}
        alt="alysqueCLAP"
        width="56"
        height="56"
        loading="lazy"
        class="h-14 w-14 shrink-0 border-2 border-milk object-contain"
      />
      <h3 id="buy-modal-title" class="font-display text-[11px] leading-relaxed uppercase">
        Купить привет?
      </h3>
    </div>
    <p id="buy-modal-text" class="mt-2 text-sm font-bold text-mist"></p>
    <p id="buy-note" class="mt-2 hidden text-xs font-bold text-mist">
      🔒 Войди через Twitch, чтобы забрать привет — вернёмся к нему после входа.
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        id="buy-modal-yes"
        type="button"
        class="btn-arcade btn-arcade-primary px-4 py-3 text-sm"
      >
        Да, забираю
      </button>
      <button
        id="buy-modal-no"
        type="button"
        data-modal-close
        class="btn-arcade btn-arcade-ghost px-4 py-3 text-sm text-mist"
      >
        Не, пойду на стрим
      </button>
    </div>
  </div>
</div>

<script>
  // Денег в клиенте нет: гейт «хватит/не хватит» — серверный (`insufficient
  // funds`), итог — price_paid сервера, N — из живого каталога БД (lots.ts).
  // Локальный кошелёк удалён, фолбэка без настроенного хранилища нет:
  // подтверждать нечему — говорим честно.
  import { boom } from '@/lib/confetti';
  import { ALYSQUE_CLAP_DARK } from '@/lib/emotes';
  import { createModal } from '@/lib/modal';
  import { fetchLotState, subscribeLots, buyLot, announceBought } from '@/lib/lots';
  import { fetchMyBalance, onBalance } from '@/lib/balance';
  import {
    buyAvailability,
    findBuyButton,
    formatStaged,
    readBuyIntent,
    type BuyIntent,
  } from '@/lib/buy-intent';
  import { showSpotNotice } from '@/lib/notice';
  import {
    getSupabase,
    isSupabaseConfigured,
    signInWithTwitch,
    stashPendingBuy,
    peekPendingBuy,
    clearPendingBuy,
    returnUrlForLot,
    fetchSharedHistory,
    getSessionUid,
  } from '@/lib/supabase';

  const modal = document.getElementById('buy-modal');
  const modalText = document.getElementById('buy-modal-text');
  const modalTitle = document.getElementById('buy-modal-title');
  const noteEl = document.getElementById('buy-note');
  const yesBtn = document.getElementById('buy-modal-yes');
  const noBtn = document.getElementById('buy-modal-no');

  let pending: BuyIntent | null = null;
  let pauseTimer: number | undefined;
  /** Сколько секунд паузы осталось на кнопке (0 — кнопка свободна). */
  let pauseLeft = 0;
  /** Кап окна сработал: кнопка показывает лимит до закрытия модалки. */
  let limitHit = false;
  /** Живая подписка на лот открытой модалки (пауза + цена, снимается при закрытии). */
  let lotUnsub: (() => void) | null = null;
  /** Баланс — зеркало серверного гейта; `busy` — транзитное «идёт покупка». */
  let balance: number | null = null;
  let busy = false;
  /** Гость: модалка открыта не для покупки, а для входа через Twitch.
   *  CTA — «▶ Войти через Twitch», цена показана справочно, без редиректа. */
  let guest = false;

  // display-mirror, source of truth — DB (c_cooldown/c_max_per_window/c_window в enforce_purchase_rules).
  const PAUSE_SEC = 30;
  // display-mirror, source of truth — DB (см. выше).
  const LIMIT_LABEL = 'Лимит: 10 покупок за 10 минут';

  function buyLabel(price: number | null): string {
    return `Забрать за ${formatStaged(price)} 🍺`;
  }

  /** Текст окна: у гостя — «Цена: …» справочно, у своих — приглашение потратить. */
  function modalTextFor(price: number | null, owner: string): string {
    const n = formatStaged(price);
    return guest
      ? `Цена: ${n} Пивкойнов. Владелец: ${owner}`
      : `Потратить ${n} Пивкойнов? Владелец: ${owner}`;
  }

  /** Оформление гостевого режима: твичевая CTA + пояснение про вход. */
  function applyGuestUi(): void {
    if (yesBtn instanceof HTMLButtonElement) {
      yesBtn.classList.toggle('btn-arcade-primary', !guest);
      yesBtn.classList.toggle('bg-twitch', guest);
      yesBtn.classList.toggle('text-white', guest);
    }
    noteEl?.classList.toggle('hidden', !guest);
  }

  /** Переключить уже открытую модалку в гостевой режим (нет сессии/кончилась). */
  function enterGuestMode(): void {
    guest = true;
    if (modalText && pending) modalText.textContent = modalTextFor(pending.price, pending.owner);
    restoreBuyButton();
    applyGuestUi();
  }

  function pauseLabel(left: number): string {
    return `Жди ${left} с`;
  }

  function playClapFallback(): void {
    try {
      const src = modal?.dataset.clapSound;
      if (!src) return;
      const audio = new Audio(src);
      audio.volume = 0.8;
      const p = audio.play();
      if (p && typeof p.catch === 'function') p.catch(() => {});
    } catch {
      // graceful-fallback: без звука, покупка всё равно засчитана
    }
  }

  /** Успех: деньги списал сервер (дебет/кредит + леджер в AFTER-триггере),
   *  шапка подтянет новый баланс из БД по realtime-подписке.
   *  Итог — фактически уплаченная серверная цена + confetti + видео лота
   *  в уведомлении (без video_url — clap с S3). «Мои приветы» обновит
   *  витрина из shared по событию. */
  function celebrate(entry: {
    id: string;
    title: string;
    price: number;
    owner: string;
    video: string | null;
  }): void {
    closeModal();
    boom();
    const text = `ЗАБРАЛ! Привет твой: ${entry.title} — ушло ${entry.price} Пивкойнов`;
    if (entry.video) {
      showSpotNotice({
        text,
        tone: 'ok',
        video: { src: entry.video, onError: playClapFallback },
        dismissOnOutside: true,
      });
    } else {
      playClapFallback();
      showSpotNotice({
        text,
        tone: 'ok',
        image: { src: ALYSQUE_CLAP_DARK, alt: 'alysqueCLAP' },
      });
    }
    announceBought({ id: entry.id, price: entry.price });
  }

  /** Единая точка правды для кнопки: транзит/лимит/пауза/нехватка/цена.
   *  Раньше метка ставилась в четырёх местах — рассинхрон ловился глазами. */
  function renderBuyButton(): void {
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    // Гость: кнопка — вход через Twitch, гейты цены/паузы не применяются.
    if (guest) {
      yesBtn.disabled = false;
      yesBtn.textContent = '▶ Войти через Twitch';
      return;
    }
    // Транзитные состояния владеют кнопкой: метку ставит вызвавший.
    if (busy) return;
    if (limitHit) {
      yesBtn.disabled = true;
      yesBtn.textContent = LIMIT_LABEL;
      return;
    }
    if (pauseLeft > 0) {
      yesBtn.disabled = true;
      yesBtn.textContent = pauseLabel(pauseLeft);
      return;
    }
    // Общее правило доступности (lib/buy-intent.ts): не хватает — кнопка
    // гаснет; N неизвестна — не гасим, сравнить не с чем (решает сервер).
    const availability = pending ? buyAvailability(pending, balance) : 'available';
    yesBtn.disabled = availability === 'short';
    yesBtn.textContent =
      availability === 'short'
        ? 'Не хватает Пивкойнов'
        : pending
          ? buyLabel(pending.price)
          : 'Забрать';
  }

  function setBusy(value: boolean): void {
    busy = value;
    if (yesBtn instanceof HTMLButtonElement) yesBtn.disabled = value;
    if (noBtn instanceof HTMLButtonElement) noBtn.disabled = value;
    renderBuyButton();
  }

  /** Возвращает кнопку в свободное состояние (цена pending, без таймера). */
  function restoreBuyButton(): void {
    window.clearInterval(pauseTimer);
    pauseLeft = 0;
    limitHit = false;
    setBusy(false);
  }

  /** Пауза видна честно: живой отсчёт на кнопке + «Подожди N с» в уведомлении. */
  function startPause(sec: number): void {
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    window.clearInterval(pauseTimer);
    limitHit = false;
    busy = false;
    let left = sec > 0 ? sec : PAUSE_SEC;
    pauseLeft = left;
    renderBuyButton();
    showSpotNotice({
      text: `Подожди ${left} с — этот лот можно забрать повторно через ${left} с.`,
      tone: 'bad',
    });
    pauseTimer = window.setInterval(() => {
      left -= 1;
      pauseLeft = left;
      if (!(yesBtn instanceof HTMLButtonElement)) {
        window.clearInterval(pauseTimer);
        return;
      }
      if (left <= 0) {
        restoreBuyButton();
        // Пауза отпустила — цена могла уйти: подтянуть живую N из БД.
        const id = pending?.slug;
        if (id) void refreshPriceProjection(id);
      } else {
        renderBuyButton();
      }
    }, 1000);
  }

  /** Кап окна: кнопка показывает лимит до закрытия модалки. */
  function showLimit(): void {
    if (!(yesBtn instanceof HTMLButtonElement)) return;
    window.clearInterval(pauseTimer);
    pauseLeft = 0;
    limitHit = true;
    busy = false;
    renderBuyButton();
  }

  function stopLotProjection(): void {
    if (lotUnsub) {
      try {
        lotUnsub();
      } catch {
        // отписка — best effort
      }
      lotUnsub = null;
    }
  }

  /**
   * Проекция паузы из shared-истории: моя последняя покупка ЭТОГО лота.
   * Чужой выкуп сюда не попадает (фильтр по buyer_uid), так что таймер не трогает.
   * Серверная ошибка — правда в последней инстанции (см. startPause в обработчике).
   */
  async function refreshPauseProjection(lotId: string): Promise<void> {
    if (!pending || pending.slug !== lotId || limitHit || pauseLeft > 0) return;
    if (!isSupabaseConfigured()) return;
    try {
      const uid = await getSessionUid();
      if (!uid || !pending || pending.slug !== lotId) return;
      const history = await fetchSharedHistory(lotId, pending.owner);
      for (let i = history.length - 1; i >= 0; i -= 1) {
        const entry = history[i];
        if (!entry || entry.buyer_uid !== uid) continue;
        const boughtAt = Date.parse(entry.created_at);
        if (!Number.isFinite(boughtAt)) return;
        const remaining = Math.ceil(PAUSE_SEC - (Date.now() - boughtAt) / 1000);
        if (remaining > 0 && pending && pending.slug === lotId && pauseLeft <= 0 && !limitHit) {
          startPause(remaining);
        }
        return;
      }
    } catch {
      // проекция — best effort, правда придёт с сервера
    }
  }

  /**
   * Проекция цены из живого каталога БД: лот перекупили при открытой
   * модалке — новая N видна до нажатия, отдельного ретрая нет.
   * Пауза/лимит владеют кнопкой — их не затираем; когда отпустят,
   * цена подтянется (см. конец startPause).
   */
  async function refreshPriceProjection(lotId: string): Promise<void> {
    if (!pending || pending.slug !== lotId || limitHit || pauseLeft > 0) return;
    if (!isSupabaseConfigured()) return;
    try {
      const row = await fetchLotState(lotId, null);
      if (!row || !pending || pending.slug !== lotId || limitHit || pauseLeft > 0) return;
      if (row.owner_login) pending.owner = row.owner_login;
      // N неизвестна (вью отсутствует) — намерение несёт price: null: честный
      // «…» и никакого сравнения с балансом; итог всё равно посчитает сервер.
      pending.price = row.nextPrice;
      if (modalText) modalText.textContent = modalTextFor(pending.price, pending.owner);
      renderBuyButton();
    } catch {
      // проекция — best effort, правда придёт с сервера
    }
  }

  // Цикл окна — общий модуль (Escape, клик-вне, фокус); здесь только показ
  // содержимого и живые проекции, а на закрытии — снятие своего состояния.
  const buyModal = createModal(modal, {
    onOpen() {
      if (!pending) return;
      if (modalTitle) modalTitle.textContent = pending.title;
      if (modalText) modalText.textContent = modalTextFor(pending.price, pending.owner);
      stopLotProjection();
      restoreBuyButton();
      applyGuestUi();
      // Баланс — зеркало серверного гейта: не хватает — «Да, забираю» гаснет.
      void (async () => {
        balance = await fetchMyBalance();
        renderBuyButton();
      })();
      // Живые проекции: пауза (моя последняя покупка этого лота) + цена (N из БД).
      const lotId = pending.slug;
      try {
        lotUnsub = subscribeLots(() => {
          void refreshPauseProjection(lotId);
          void refreshPriceProjection(lotId);
        }, lotId);
      } catch {
        lotUnsub = null;
      }
      void refreshPauseProjection(lotId);
      void refreshPriceProjection(lotId);
    },
    onClose() {
      stopLotProjection();
      pending = null;
      guest = false;
      restoreBuyButton();
      applyGuestUi();
    },
  });

  function openModal(): void {
    buyModal?.open();
  }

  function closeModal(): void {
    buyModal?.close();
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement | null;
    const btn = target?.closest?.('[data-buy-intent]');
    if (!(btn instanceof HTMLElement)) return;
    if (btn instanceof HTMLButtonElement && btn.disabled) return;
    const intent = readBuyIntent(btn);
    if (!intent) return;
    pending = intent;
    // Без сессии — не уводим принудительно: открываем ту же модалку в гостевом
    // режиме, где CTA — вход через Twitch. Лот запоминается внутри неё.
    if (isSupabaseConfigured()) {
      const sb = getSupabase();
      const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
      if (!data.session) {
        guest = true;
        openModal();
        return;
      }
    }
    guest = false;
    openModal();
  });

  yesBtn?.addEventListener('click', async () => {
    if (!pending) return;
    const { slug: id, title, owner, video } = pending;
    const price = pending.price;
    // Гостевой режим: кнопка — вход через Twitch. Запоминаем лот, чтобы после
    // возврата модалка открылась снова уже для подтверждения покупки.
    if (guest) {
      stashPendingBuy(id);
      await signInWithTwitch(returnUrlForLot(id));
      return;
    }
    // Гейт «хватит/не хватит» — серверный (тикет 08): BEFORE ответит
    // `insufficient funds`, покажем честно. Без настроенного хранилища
    // покупать нечего — честная ошибка, деньги целы.
    if (!isSupabaseConfigured()) {
      showSpotNotice({
        text: 'Хранилище не настроено — покупка не записана, Пивкойны целы.',
        tone: 'bad',
      });
      return;
    }
    if (typeof navigator !== 'undefined' && !navigator.onLine) {
      showSpotNotice({
        text: 'Офлайн: покупка не записана, Пивкойны целы. Вернись с сетью.',
        tone: 'bad',
      });
      return;
    }
    // Сессия могла кончиться после открытия модалки — в логин с возвратом к Лоту.
    const sb = getSupabase();
    const { data } = (await sb?.auth.getSession()) ?? { data: { session: null } };
    if (!data.session) {
      // Сессия кончилась при открытой модалке — переключаем её в гостевой
      // режим (вход по кнопке), без принудительного редиректа.
      enterGuestMode();
      return;
    }
    // Перекуп за одним швом (buyLot из lib/lots.ts): свежая N, INSERT,
    // маппинг ошибок — внутри; здесь только switch по итогу.
    // Итог — фактически уплаченная серверная цена.
    setBusy(true);
    if (yesBtn instanceof HTMLButtonElement) yesBtn.textContent = 'Ждём сервер…';
    let result: Awaited<ReturnType<typeof buyLot>>;
    try {
      result = await buyLot(id);
    } catch {
      restoreBuyButton();
      showSpotNotice({
        text: 'Не записалось в общее хранилище — Пивкойны целы, попробуй ещё.',
        tone: 'bad',
      });
      return;
    }
    if (result.status === 'ok') {
      const paid = result.paid > 0 ? result.paid : (price ?? 0);
      celebrate({ id, title, price: paid, owner, video });
      return;
    }
    if (result.kind === 'cooldown') {
      startPause(result.retryAfterSec ?? PAUSE_SEC);
      return;
    }
    if (result.kind === 'rate-limit') {
      showLimit();
      showSpotNotice({
        text: 'Лимит: 10 покупок за 10 минут — приходи позже, Пивкойны целы.',
        tone: 'bad',
      });
      return;
    }
    restoreBuyButton();
    if (result.kind === 'insufficient-funds') {
      closeModal();
      showSpotNotice({
        text: 'Не хватает Пивкойнов — пойжем жоско в гамбу или забери Ежедневный вход, а этот привет подождёт.',
        tone: 'bad',
      });
      return;
    }
    if (result.kind === 'unauthenticated') {
      // Сервер не увидел сессию — та же гостевая модалка, вход по кнопке.
      enterGuestMode();
      return;
    }
    switch (result.kind) {
      case 'own-lot':
        showSpotNotice({ text: 'Этот привет уже твой — перекупать нечего.', tone: 'bad' });
        break;
      case 'missing-lot':
        showSpotNotice({
          text: 'Лот ещё не переехал в общее хранилище — покупка не записана, Пивкойны целы.',
          tone: 'bad',
        });
        break;
      case 'price-cap':
        showSpotNotice({
          text: 'Цена упёрлась в потолок — дальше некуда, Пивкойны целы.',
          tone: 'bad',
        });
        break;
      case 'offline':
        showSpotNotice({
          text: 'Сеть упала: покупка не записана, Пивкойны целы. Попробуй ещё.',
          tone: 'bad',
        });
        break;
      default:
        showSpotNotice({
          text: 'Не записалось в общее хранилище — Пивкойны целы, попробуй ещё.',
          tone: 'bad',
        });
        break;
    }
  });

  // Живой баланс из BaseLayout: не хватает — кнопка гаснет/оттаивает.
  onBalance((value) => {
    balance = value;
    renderBuyButton();
  });

  /** Ждать появления кнопки покупки Лота: витрина/страница рисуют карточку
   *  из БД после загрузки, кнопки в DOM сразу нет. Без этого возврат из логина
   *  терялся. Ищем по слоту намерения (lib/buy-intent.ts). */
  function waitForBuyButton(slug: string, timeoutMs: number): Promise<HTMLElement | null> {
    const immediate = findBuyButton(slug);
    if (immediate) return Promise.resolve(immediate);
    return new Promise((resolve) => {
      const started = Date.now();
      const poll = window.setInterval(() => {
        const el = findBuyButton(slug);
        if (el || Date.now() - started >= timeoutMs) {
          window.clearInterval(poll);
          resolve(el);
        }
      }, 150);
    });
  }

  // Возврат из логина (тикет 09): Чатерс залогинен — переоткрыть модалку того
  // же Лота. Лот не стираем, пока кнопка не найдена, — иначе возврат теряется.
  void (async () => {
    if (!isSupabaseConfigured()) return;
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data.session) return;
    const id = peekPendingBuy();
    if (!id) return;
    const btn = await waitForBuyButton(id, 8000);
    if (!(btn instanceof HTMLElement)) return;
    clearPendingBuy();
    btn.click();
  })();
</script>
