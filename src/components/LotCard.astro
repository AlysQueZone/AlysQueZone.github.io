---
// Карточка лота для сетки биржи. Каталог — из БД (тикет 09, SSG через
// fetchCatalogLots из lib/lots.ts); shared-слой (владелец/цена) дотягивает
// скрипт витрины на lots/index.astro. Владелец NULL — бейджа нет,
// кнопка покупки активна (первый покупатель — первый владелец).
// Видео — общий V2-компонент LotVideo (прототип
// scratch/video-s3/prototype/inline-video.html).
// Кнопка покупки несёт data-lot-video (тикет 10): BuyModal играет его при покупке.
import type { Lot } from '@/lib/lots';
import LotVideo from './LotVideo.astro';

interface Props {
  lot: Lot;
}

const { lot } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article
  data-lot-card={lot.id}
  class="card-pixel flex flex-col gap-2 p-4 transition hover:-translate-y-0.5"
>
  <h3 class="text-base font-extrabold">
    <a href={`${base}lots/${lot.id}/`} class="hover:text-ember">
      {lot.title}
    </a>
  </h3>
  <LotVideo videoUrl={lot.video_url} title={lot.title} />
  <p class="text-sm text-mist/70">
    владелец: <span data-shared-owner>{lot.owner ?? '—'}</span>{' '}
    <span data-mine-badge class="hidden font-bold text-rind">
      · ТВОЙ
    </span>
  </p>
  <p data-shared-price class="text-xl font-black text-pivko">
    {lot.price} 🍺
  </p>
  <div class="mt-auto pt-2">
    <button
      type="button"
      class="btn-arcade btn-arcade-primary px-4 py-2 text-sm"
      data-buy-lot={lot.id}
      data-lot-title={lot.title}
      data-lot-price={lot.price}
      data-lot-owner={lot.owner ?? '—'}
      data-lot-video={lot.video_url ?? undefined}
    >
      ▶ Купить
    </button>
  </div>
</article>
