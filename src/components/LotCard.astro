---
// Разметка карточки лота для сетки биржи — шаблон: витрина целиком рисуется
// клиентом из БД (см. docs/adr/0002), полей-данных здесь нет. Скрипт витрины
// клонирует шаблон и заполняет data-слоты (заголовок/владелец/цена/бейдж/
// видео/кнопка). Владелец NULL — бейджа нет, кнопка активна (первый
// покупатель — первый владелец). Видео — общий компонент LotVideo.
import LotVideo from './LotVideo.astro';

const base = import.meta.env.BASE_URL;
---

<article data-lot-card class="card-pixel flex flex-col gap-2 p-4 transition hover:-translate-y-0.5">
  <h3 class="text-base font-extrabold">
    <a data-lot-link href={`${base}lots/`} class="hover:text-ember">
      <span data-lot-title></span>
    </a>
  </h3>
  <LotVideo videoUrl={null} title="" />
  <p class="text-sm text-mist/70">
    владелец: <span data-shared-owner>—</span>{' '}
    <span data-mine-badge class="hidden font-bold text-rind">
      {' '}
      · ТВОЙ{' '}
    </span>
  </p>
  <p data-shared-price class="text-xl font-black text-pivko">
    — 🍺
  </p>
  <div class="mt-auto pt-2">
    <button
      type="button"
      class="btn-arcade btn-arcade-primary px-4 py-2 text-sm"
      data-buy-lot
      disabled
    >
      ▶ Купить
    </button>
  </div>
</article>
