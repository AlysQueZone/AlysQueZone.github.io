---
// Карточка лота для сетки биржи (тикет 10). Переиспользует общий BuyModal:
// кнопка «Купить» несёт data-buy-lot/*, модалку открывает делегированный
// скрипт из BuyModal.astro.
import type { Lot } from '../lib/lots.ts';
import { lotEmote } from '../lib/emotes.ts';

interface Props {
  lot: Lot;
}

const { lot } = Astro.props;
const base = import.meta.env.BASE_URL;
const emote = lotEmote(lot.id);

const badgeClass =
  lot.rarity === 'legendary'
    ? 'bg-legend text-cream'
    : lot.rarity === 'rare'
      ? 'bg-terra text-cream'
      : 'bg-bar text-milk';

const rarityLabel =
  lot.rarity === 'legendary' ? 'ЛЕГЕНДА' : lot.rarity === 'rare' ? 'РЕДКИЙ' : 'ОБЫЧНЫЙ';
---

<article class="flex flex-col gap-2 rounded-2xl border border-card bg-panel p-4 hover:border-stream">
  <span class={`inline-block w-fit rounded-full px-2.5 py-0.5 text-xs font-bold ${badgeClass}`}>
    {rarityLabel}
  </span>
  <h3 class="text-base font-extrabold">
    <a href={`${base}lots/${lot.id}/`} class="hover:text-ember">{lot.title}</a>
  </h3>
  {lot.poster && <img src={`${base}${lot.poster}`} alt={lot.title} loading="lazy" class="h-36 w-full rounded-xl object-cover" />}
  {emote && <img src={emote.src} alt={emote.name} title={emote.name} loading="lazy" width="56" height="56" class="h-14 w-14 object-contain" />}
  {lot.audio && <button type="button" data-lot-listen={`${base}${lot.audio}`} class="w-fit cursor-pointer rounded-full border border-pivko/50 px-3 py-1 font-mono text-xs text-pivko hover:bg-pivko/10">▶ слушать</button>}
  <p class="text-sm text-mist/70">владелец: {lot.owner}</p>
  <p class="font-mono text-xl text-pivko">{lot.price} 🪙</p>
  {lot.meme && <p class="text-sm text-mist/80">{lot.meme}</p>}
  <div class="mt-auto pt-2">
    {
      lot.forSale ? (
        <button
          type="button"
          class="cursor-pointer rounded-xl bg-stream px-4 py-2 font-extrabold text-white hover:bg-ctahover"
          data-buy-lot={lot.id}
          data-lot-title={lot.title}
          data-lot-price={lot.price}
          data-lot-owner={lot.owner}
          data-lot-audio={lot.audio ? `${base}${lot.audio}` : undefined}
          data-for-sale="true"
        >
          Купить
        </button>
      ) : (
        <button
          type="button"
          disabled
          class="cursor-not-allowed rounded-xl bg-white/10 px-4 py-2 font-extrabold text-mist/50"
          title="ЛУК не продаётся. Хозяин не менялся."
        >
          НЕ ПРОДАЕТСЯ
        </button>
      )
    }
  </div>
</article>
