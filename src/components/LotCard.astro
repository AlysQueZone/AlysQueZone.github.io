---
// Карточка лота для сетки биржи. Каталог — из БД (тикет 09, SSG через
// fetchCatalogLots из lib/lots.ts); shared-слой (владелец/цена) дотягивает
// скрипт витрины на lots/index.astro. Владелец NULL — бейджа нет,
// кнопка покупки активна (первый покупатель — первый владелец).
// Видео — общий V2-компонент LotVideo (прототип
// .scratch/video-s3/prototype/inline-video.html).
// Кнопка покупки несёт data-lot-video (тикет 10): BuyModal играет его при покупке.
import type { Lot } from '../lib/lots.ts';
import { lotEmote } from '../lib/emotes.ts';
import LotVideo from './LotVideo.astro';

interface Props {
  lot: Lot;
}

const { lot } = Astro.props;
const base = import.meta.env.BASE_URL;
const emote = lotEmote(lot.id);

const badgeClass =
  lot.rarity === 'legendary'
    ? 'bg-legend text-cream'
    : lot.rarity === 'rare'
      ? 'bg-terra text-cream'
      : 'bg-bar text-milk';

const rarityLabel =
  lot.rarity === 'legendary' ? 'ЛЕГЕНДА' : lot.rarity === 'rare' ? 'РЕДКИЙ' : 'ОБЫЧНЫЙ';
---

<article data-lot-card={lot.id} class="flex flex-col gap-2 rounded-2xl border border-card bg-panel p-4 hover:border-stream">
  <span class={`inline-block w-fit rounded-full px-2.5 py-0.5 text-xs font-bold ${badgeClass}`}>
    {rarityLabel}
  </span>
  <h3 class="text-base font-extrabold">
    <a href={`${base}lots/${lot.id}/`} class="hover:text-ember">{lot.title}</a>
  </h3>
  <LotVideo videoUrl={lot.video_url} title={lot.title} />
  {emote && <img src={emote.src} alt={emote.name} title={emote.name} loading="lazy" width="56" height="56" class="h-14 w-14 object-contain" />}
  <p class="text-sm text-mist/70">владелец: <span data-shared-owner>{lot.owner ?? '—'}</span> <span data-mine-badge class="hidden font-bold text-rind">· ТВОЙ</span></p>
  <p data-shared-price class="font-mono text-xl text-pivko">{lot.price} 🍺</p>
  {lot.meme_text && !lot.video_url && <p class="text-sm text-mist/80">{lot.meme_text}</p>}
  <div class="mt-auto pt-2">
    <button
      type="button"
      class="cursor-pointer rounded-xl bg-stream px-4 py-2 font-extrabold text-white hover:bg-ctahover"
      data-buy-lot={lot.id}
      data-lot-title={lot.title}
      data-lot-price={lot.price}
      data-lot-owner={lot.owner ?? '—'}
      data-lot-video={lot.video_url ?? undefined}
    >
      Купить
    </button>
  </div>
</article>
