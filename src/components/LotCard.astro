---
// Разметка карточки лота для сетки биржи — раскладка A2 из прототипа
// scratch/lot-cards/prototype/lot-cards.html: название сверху, кадр в
// пропорции «телефонных» видео (77/136 ≈ 308×544, как kubic_lego.mp4),
// владелец — тёмный бейдж поверх кадра, цена — только в кнопке (у неактивной
// она остаётся в надписи). Шаблон: витрина целиком рисуется клиентом из БД
// (см. docs/adr/0002), полей-данных здесь нет. Скрипт витрины клонирует
// шаблон и заполняет data-слоты (заголовок/видео/кнопка); бейджи владельца —
// общий LotBadges (заполняет fillOwnerBadges). Владелец NULL — «свободен».
// Видео — общий компонент LotVideo (кадру задана портретная пропорция).
import LotVideo from './LotVideo.astro';
import LotBadges from './LotBadges.astro';
import { LOT_CARD_ASPECT } from '@/lib/lot-video';

const base = import.meta.env.BASE_URL;
---

<article
  data-lot-card
  class="card-pixel flex flex-col gap-2 p-4 transition hover:-translate-y-0.5 motion-reduce:hover:translate-y-0"
>
  <h3 class="text-base font-extrabold">
    <a data-lot-link href={`${base}lots/`} class="hover:text-ember">
      <span data-lot-title></span>
    </a>
  </h3>
  <LotVideo videoUrl={null} title="" aspect={LOT_CARD_ASPECT}>
    <LotBadges />
  </LotVideo>
  <div class="mt-auto pt-2">
    <button
      type="button"
      class="btn-arcade btn-arcade-primary w-full px-4 py-3 text-sm"
      data-buy-intent
      disabled
    >
      ▶ Забрать
    </button>
  </div>
</article>
