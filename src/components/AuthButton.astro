---
// Шапка-вход через Twitch:
// «Войти через Twitch» гостю / ник-ссылка в свой профиль Чатерсу.
// «Выйти» в шапке нет — оно в паспорте своего профиля (src/pages/profile).
// Сессия долгая (persist + авторефреш, см. src/lib/session.ts).
// Термины — из GLOSSARY.md, тон — как на сайте.
---

<div data-auth class="flex items-center gap-2">
  <button type="button" data-auth-login class="btn-arcade bg-twitch px-4 py-2 text-sm text-white">
    ▶ Войти через Twitch
  </button>
  <span data-auth-user-wrap class="hidden items-center gap-2">
    <a
      data-auth-user
      class="btn-arcade btn-arcade-ghost max-w-36 cursor-pointer truncate px-4 py-2 text-sm"
    ></a>
  </span>
  <p data-auth-hint class="hidden text-xs font-bold text-melon"></p>
</div>

<script>
  import { getSupabase, displayLogin, signInWithTwitch } from '@/lib/session';
  import { nickLink } from '@/lib/header';

  const root = document.querySelector('[data-auth]');
  const loginBtn = root?.querySelector('[data-auth-login]');
  const userWrap = root?.querySelector('[data-auth-user-wrap]');
  const userEl = root?.querySelector('[data-auth-user]');
  const hint = root?.querySelector('[data-auth-hint]');

  function showHint(text: string): void {
    if (!(hint instanceof HTMLElement)) return;
    hint.textContent = text;
    hint.classList.remove('hidden');
  }

  function render(login: string | null, uid: string | null): void {
    const nick = nickLink({ login, uid });
    loginBtn?.classList.toggle('hidden', nick.signedIn);
    userWrap?.classList.toggle('hidden', !nick.signedIn);
    userWrap?.classList.toggle('flex', nick.signedIn);
    if (!(userEl instanceof HTMLAnchorElement)) return;
    if (nick.signedIn) userEl.textContent = nick.text;
    // Выход убирает адрес: ник без uid ссылкой не становится.
    if (nick.href) userEl.setAttribute('href', nick.href);
    else userEl.removeAttribute('href');
  }

  async function refresh(): Promise<void> {
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    const user = data.session?.user ?? null;
    render(user ? displayLogin(user) : null, user?.id ?? null);
  }

  loginBtn?.addEventListener('click', async () => {
    if (!getSupabase()) {
      showHint('СТРИМ ВКЛЮЧИЛСЯ, А ТЫ? Вход пока спит — человек ещё не вбил ключи.');
      return;
    }
    await signInWithTwitch();
  });

  const sb = getSupabase();
  if (!sb) {
    loginBtn?.setAttribute('title', 'Вход спит: не вбиты PUBLIC_SUPABASE_* (см. .env.example)');
  } else {
    void refresh();
    sb.auth.onAuthStateChange((_event, session) => {
      const user = session?.user ?? null;
      render(user ? displayLogin(user) : null, user?.id ?? null);
    });
  }
</script>
