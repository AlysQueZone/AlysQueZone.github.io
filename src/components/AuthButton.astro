---
// Шапка-вход через Twitch (тикет 09, shared-state):
// «Войти через Twitch» гостю / логин + «Выйти» Чатерсу.
// Сессия долгая (persist + авторефреш, см. src/lib/supabase.ts).
// Термины — из CONTEXT.md, тон — как на сайте.
---

<div data-auth class="flex items-center gap-2">
  <button
    type="button"
    data-auth-login
    class="btn-arcade bg-twitch px-4 py-2 text-xs text-white"
  >
    ▶ Войти через Twitch
  </button>
  <span data-auth-user-wrap class="hidden items-center gap-2">
    <span
      data-auth-user
      class="btn-arcade btn-arcade-ghost max-w-36 cursor-default truncate px-4 py-2 text-xs normal-case"
      title="Ты на бирже, чатерс"
    ></span>
    <button
      type="button"
      data-auth-logout
      class="btn-arcade btn-arcade-ghost px-4 py-2 text-xs text-mist"
    >
      Выйти
    </button>
  </span>
  <p data-auth-hint class="hidden text-xs font-bold text-melon"></p>
</div>

<script>
  import {
    getSupabase,
    isSupabaseConfigured,
    displayLogin,
    signInWithTwitch,
    signOut,
  } from '../lib/supabase.ts';

  const root = document.querySelector('[data-auth]');
  const loginBtn = root?.querySelector('[data-auth-login]');
  const userWrap = root?.querySelector('[data-auth-user-wrap]');
  const userEl = root?.querySelector('[data-auth-user]');
  const logoutBtn = root?.querySelector('[data-auth-logout]');
  const hint = root?.querySelector('[data-auth-hint]');

  function showHint(text: string): void {
    if (!(hint instanceof HTMLElement)) return;
    hint.textContent = text;
    hint.classList.remove('hidden');
  }

  function render(login: string | null): void {
    const authed = login !== null;
    loginBtn?.classList.toggle('hidden', authed);
    userWrap?.classList.toggle('hidden', !authed);
    userWrap?.classList.toggle('flex', authed);
    if (authed && userEl) userEl.textContent = `@${login}`;
  }

  async function refresh(): Promise<void> {
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    render(data.session ? displayLogin(data.session.user) : null);
  }

  loginBtn?.addEventListener('click', async () => {
    if (!isSupabaseConfigured()) {
      showHint('СТРИМ ВКЛЮЧИЛСЯ, А ТЫ? Вход пока спит — человек ещё не вбил ключи.');
      return;
    }
    await signInWithTwitch();
  });

  logoutBtn?.addEventListener('click', async () => {
    await signOut();
    render(null);
  });

  if (!isSupabaseConfigured()) {
    loginBtn?.setAttribute('title', 'Вход спит: не вбиты PUBLIC_SUPABASE_* (см. .env.example)');
  } else {
    void refresh();
    getSupabase()?.auth.onAuthStateChange((_event, session) => {
      render(session ? displayLogin(session.user) : null);
    });
  }
</script>

<style>
  .bg-twitch {
    background-color: #9146ff;
  }
</style>
