---
// Ежедневный вход (тикет 13, pivkoiny-backend): автовыдача без кнопок.
// При первом заходе залогиненного Чатерса в новый UTC-день клиент сам
// вызывает claim_daily (см. src/lib/daily.ts) — один раз в день: сначала
// сверка со статусом/датой последнего клейма, лишних вызовов нет. Факт
// выдачи показывает окно ежедневного входа «+N, день M (из 7)» с confetti:
// кнопка «Ок» + крестик + клик вне + Escape, без автотаймера.
// Гость без сессии ничего не получает и не видит. Серверный claim_daily
// не меняется.
//
// Использование: положить <DailyLogin /> в шапку (видимого места не занимает).
---

<div id="daily-notice-root" aria-live="polite"></div>

<script>
  import { getSupabase, isSupabaseConfigured } from '@/lib/supabase';
  import {
    claimDaily,
    dayNumForStreak,
    fetchDailyStatus,
    markAutoDailyDay,
    readAutoDailyDay,
    todayUtcDate,
  } from '@/lib/daily';
  import { boom } from '@/lib/confetti';

  function paintBalance(balance: number): void {
    document.querySelectorAll('[data-wallet-balance]').forEach((el) => {
      el.textContent = String(balance);
    });
  }

  /** Окно ежедневного входа: по центру, карточка стиля C, confetti при успехе.
   *  Закрытие: «Ок» / крестик / клик по затемнению / Escape. Без автотаймера,
   *  ширина ограничена вьюпортом — целиком видно на 360px и 1440px.
   *  Оверлей кладём в body: <DailyLogin /> живёт в шапке с backdrop-blur,
   *  а он ломает fixed-позиционирование потомков (окно прилипало к верху). */
  function showDailyWindow(text: string, withConfetti: boolean): void {
    document.querySelectorAll('[data-daily-notice]').forEach((n) => n.remove());
    const overlay = document.createElement('div');
    overlay.dataset.dailyNotice = '1';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.setAttribute('aria-label', 'Ежедневный вход');
    overlay.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4';
    const box = document.createElement('div');
    box.className = 'card-pixel w-full max-w-sm p-5 text-center';
    const headRow = document.createElement('div');
    headRow.className = 'flex items-start justify-between gap-3';
    const title = document.createElement('h3');
    title.className = 'font-display text-[11px] leading-relaxed uppercase';
    title.textContent = 'Ежедневный вход';
    const cross = document.createElement('button');
    cross.type = 'button';
    cross.setAttribute('aria-label', 'Закрыть');
    cross.className = 'btn-arcade btn-arcade-ghost shrink-0 px-3 py-1 text-sm';
    cross.textContent = '✕';
    headRow.append(title, cross);
    const body = document.createElement('p');
    body.className = 'mt-3 text-lg font-black break-words whitespace-normal';
    body.textContent = text;
    const ok = document.createElement('button');
    ok.type = 'button';
    ok.className = 'btn-arcade btn-arcade-primary mt-4 px-8 py-2 text-sm';
    ok.textContent = 'Ок';
    box.append(headRow, body, ok);
    overlay.appendChild(box);
    document.body.appendChild(overlay);
    function detach(): void {
      document.removeEventListener('click', onOutside, true);
      document.removeEventListener('keydown', onKey);
      overlay.remove();
    }
    function onOutside(e: MouseEvent): void {
      if (e.target === overlay) detach();
    }
    function onKey(e: KeyboardEvent): void {
      if (e.key === 'Escape') detach();
    }
    cross.addEventListener('click', detach);
    ok.addEventListener('click', detach);
    // Отложка на тик: текущий клик (если он и запустил флоу) не должен
    // тут же закрыть окно через onOutside.
    window.setTimeout(() => {
      if (overlay.isConnected) {
        document.addEventListener('click', onOutside, true);
        document.addEventListener('keydown', onKey);
      }
    }, 0);
    if (withConfetti) boom();
    ok.focus();
  }

  let busy = false;

  /** Автоклейм: один раз в день при первом заходе залогиненного. */
  async function maybeAutoClaim(): Promise<void> {
    if (busy || typeof window === 'undefined') return;
    if (!isSupabaseConfigured()) return;
    if (typeof navigator !== 'undefined' && !navigator.onLine) return;
    // Быстрая локальная сверка: сегодня уже отработали — вызовов в сеть нет.
    if (readAutoDailyDay() === todayUtcDate()) return;
    const sb = getSupabase();
    if (!sb) return;
    const { data } = await sb.auth.getSession();
    if (!data.session) return; // гость — ничего не получает и не видит
    busy = true;
    try {
      // Сверка со статусом дня: забрано — клейм не вызываем вообще.
      const status = await fetchDailyStatus();
      if (!status) return; // офлайн/сбой — деньги целы, молча
      if (status.claimedToday) {
        markAutoDailyDay();
        return;
      }
      const done = await claimDaily();
      markAutoDailyDay();
      if (done.balance !== null) paintBalance(done.balance);
      // Окно — только о факте новой выдачи; повторный (already)
      // ответ сервера молча гасим, чтобы не спамить дублями.
      if (!done.already) {
        showDailyWindow(`+${done.amount}, день ${dayNumForStreak(done.streak)} (из 7)`, true);
      }
    } catch (err) {
      // Понятная серверная ошибка «no account» (счёта нет): показать тем же
      // окном без confetti; день НЕ отмечаем — повтор при следующем
      // заходе. Остальные ошибки — как раньше молча (деньги целы).
      const raw =
        err instanceof Error
          ? err.message
          : typeof err === 'object' && err !== null && 'message' in err
            ? String((err as { message: unknown }).message)
            : String(err);
      if (raw.toLowerCase().includes('no account')) {
        showDailyWindow(raw, false);
      }
    } finally {
      busy = false;
    }
  }

  // Один раз за страницу; вход посреди сессии (без перезагрузки) ловим
  // по смене сессии (INITIAL_SESSION отфильтрован — первичный заход выше).
  if (!document.documentElement.dataset.dailyAutoInit) {
    document.documentElement.dataset.dailyAutoInit = '1';
    void maybeAutoClaim();
    getSupabase()?.auth.onAuthStateChange((event) => {
      if (event === 'SIGNED_IN') void maybeAutoClaim();
    });
  }
</script>
