---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ALYSQUE_THINK } from '@/lib/emotes';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="AlysQueZone — ТУТ ПУСТО, ЧАТ В ШОКЕ">
  <section class="mx-auto max-w-xl py-10 text-center">
    <p class="font-display animate-blink text-4xl text-melon" aria-hidden="true">
      GAME OVER
    </p>
    <div class="mt-4 flex justify-center">
      <img
        src={ALYSQUE_THINK}
        alt=""
        width="72"
        height="72"
        loading="eager"
        class="h-[72px] w-[72px] object-contain"
      />
    </div>
    <h1 class="font-display mt-4 text-sm leading-loose uppercase">404. Привет не найден</h1>
    <p class="mt-4 text-mist">Такой страницы нет — Пойжем обратно на биржу</p>
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a href={`${base}lots/`} class="btn-arcade btn-arcade-primary px-6 py-3">
        ▶ На биржу
      </a>
      <a href={`${base}`} class="btn-arcade btn-arcade-ghost px-6 py-3 text-mist">
        На главную
      </a>
    </div>
  </section>
</BaseLayout>
