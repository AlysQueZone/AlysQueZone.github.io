---
import BaseLayout from '@/layouts/BaseLayout.astro';

// «Лог сделок» — статический каркас, данные рисует клиент из БД (docs/adr/0002).
// Страница держит три вещи: листание по курсору (lib/trade-history.ts), живое
// событие `deals` модуля живых данных (docs/adr/0003) и фильтр «Все / Мои
// покупки» (`?mine=1`, uid — только через live.ts). Отбор строк и деление на
// дни — чистое ядро; здесь состояния, URL, разметка и перерисовка.
---

<BaseLayout title="Лог сделок — AlysQueZone">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-display text-xl uppercase sm:text-2xl">Лог сделок</h1>
      <p class="mt-2 max-w-xl text-sm font-bold text-mist">
        Кто, когда, что и за сколько забрал. Новые сверху.
      </p>
    </div>
    <div data-log-filter class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-log-mine="0"
        aria-pressed="true"
        class="btn-arcade btn-arcade-primary px-4 py-2 text-sm"
      >
        Все
      </button>
      <button
        type="button"
        data-log-mine="1"
        aria-pressed="false"
        class="btn-arcade btn-arcade-ghost px-4 py-2 text-sm"
      >
        Мои покупки
      </button>
    </div>
  </div>

  <p data-log-status class="sr-only" role="status">
    Загружаю лог сделок…
  </p>

  <!-- Скелетон до первого ответа БД: та же геометрия, что у таблицы на десктопе
       и карточек на телефоне, поэтому загрузка не прыгает. -->
  <div data-log-skeleton class="mt-6 flex flex-col gap-5" aria-hidden="true">
    <div class="hidden flex-col gap-2 md:flex">
      <div class="border-2 border-milk bg-pivko px-3 py-2">
        <div class="skeleton-block skeleton-block-cream h-3 w-48"></div>
      </div>
      <div class="card-pixel overflow-hidden">
        <div class="border-b-2 border-milk/15 bg-bar px-3 py-2">
          <div class="skeleton-block h-3 w-64"></div>
        </div>
        {Array.from({ length: 5 }, () => (
          <div class="flex items-center gap-3 border-b-2 border-milk/15 px-3 py-2 last:border-b-0">
            <div class="skeleton-block h-3 w-16"></div>
            <div class="skeleton-block aspect-[77/136] w-10"></div>
            <div class="skeleton-block h-4 flex-1"></div>
            <div class="skeleton-block h-3 w-20"></div>
            <div class="skeleton-block h-3 w-20"></div>
            <div class="skeleton-block h-3 w-12"></div>
          </div>
        ))}
      </div>
    </div>
    <div class="flex flex-col gap-2 md:hidden">
      <div class="border-2 border-milk bg-pivko px-3 py-2">
        <div class="skeleton-block skeleton-block-cream h-3 w-40"></div>
      </div>
      {Array.from({ length: 4 }, () => (
        <div class="flex gap-3 border-2 border-milk bg-void px-3 py-2">
          <div class="skeleton-block aspect-[77/136] w-16 shrink-0"></div>
          <div class="flex flex-1 flex-col gap-2 py-1">
            <div class="skeleton-block h-4 w-2/3"></div>
            <div class="skeleton-block h-3 w-1/2"></div>
            <div class="skeleton-block h-3 w-24"></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div data-log-error class="card-pixel mt-6 hidden p-5 sm:p-6">
    <p class="text-sm font-bold text-mist">Лог не загрузился — проверь связь и обнови страницу.</p>
    <button type="button" data-log-retry class="btn-arcade btn-arcade-ghost mt-3 px-5 py-2 text-sm">
      Обновить
    </button>
  </div>

  <p data-log-empty class="card-pixel mt-6 hidden p-5 text-sm font-bold text-mist sm:p-6">
    Сделок пока нет — забери первый привет
  </p>

  <!-- «Мои покупки» без входа: подсказка вместо пустого лога. -->
  <p data-log-guest class="card-pixel mt-6 hidden p-5 text-sm font-bold text-mist sm:p-6">
    Войди через Twitch — тут будут твои покупки
  </p>

  <div data-log-body class="mt-6 hidden"></div>

  <!-- Запасной путь пагинации: автоподгрузку сторожит этот же блок. -->
  <div data-log-more class="mt-6 hidden">
    <div class="flex justify-center">
      <button
        type="button"
        data-log-load-more
        class="btn-arcade btn-arcade-ghost px-6 py-3 text-sm"
      >
        Показать ещё
      </button>
    </div>
  </div>

  <!-- Новые сделки при прокрутке копятся здесь, а не прыгают в список. -->
  <button
    type="button"
    data-log-new
    class="fixed left-1/2 z-[65] hidden -translate-x-1/2 border-[3px] border-milk bg-stream px-4 py-2 text-sm font-black text-cream shadow-[4px_4px_0_var(--color-milk)]"
    style="top: var(--deals-sticky-top, 6rem)"
  >
    ↑ 0 новых сделок
  </button>
</BaseLayout>

<style is:global>
  /* Карточка телефона целиком — ссылка на привет: заголовок растянут на всю
     карточку (`::after`), поэтому клик по миниатюре и пустому месту тоже
     открывает лот. Кольцо фокуса — вокруг карточки, а не текста заголовка. */
  [data-deal-card] a[data-deal-link]::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  [data-deal-card] a[data-deal-link]:focus-visible {
    outline: none;
  }

  [data-deal-card]:has(a[data-deal-link]:focus-visible) {
    outline: 3px solid var(--color-blush);
    outline-offset: 2px;
  }
</style>

<script>
  // Страница рисует срез лога: запрос — lib/supabase.ts, отбор и деление на дни —
  // lib/trade-history.ts. Здесь состояния, фильтр «Все / Мои» и его URL, разметка
  // и перерисовка; uid и сессию знает только live.ts (docs/adr/0003).
  import { fetchDealLog } from '@/lib/supabase';
  import { live } from '@/lib/live';
  import { videoSources } from '@/lib/lot-video';
  import {
    appendHistory,
    DEAL_PAGE_SIZE,
    formatRelativeTime,
    groupDealDays,
    historyCursor,
    mergeHistory,
    type DealDay,
    type DealEntry,
  } from '@/lib/trade-history';

  const base = import.meta.env.BASE_URL;

  const skeleton = document.querySelector('[data-log-skeleton]');
  const body = document.querySelector('[data-log-body]');
  const empty = document.querySelector('[data-log-empty]');
  const guest = document.querySelector('[data-log-guest]');
  const error = document.querySelector('[data-log-error]');
  const retry = document.querySelector('[data-log-retry]');
  const status = document.querySelector('[data-log-status]');
  const more = document.querySelector('[data-log-more]');
  const moreButton = document.querySelector('[data-log-load-more]');
  const pill = document.querySelector('[data-log-new]');
  const filterButtons = document.querySelectorAll('[data-log-mine]');

  /** Показанные записи: новые сверху; дни считает ядро при каждой перерисовке. */
  let entries: DealEntry[] = [];
  /** Свежие сделки, придержанные, пока пользователь прокручен ниже верха лога. */
  let pending: DealEntry[] = [];
  let loaded = false;
  let loadingFirst = false;
  let loadingMore = false;
  let refreshing = false;
  /** Событие пришло во время чтения: один повтор после ответа, без параллели. */
  let refreshQueued = false;
  let hasMore = false;
  let observer: IntersectionObserver | null = null;

  /** «Мои покупки» (`?mine=1`); состояние фильтра живёт в URL. */
  let mine = new URL(window.location.href).searchParams.get('mine') === '1';
  /** uid прочитан хотя бы раз: до этого гостевую подсказку не показываем. */
  let uidReady = false;
  /** Последний uid из снапшота — смена перезагружает «Мои покупки». */
  let seenUid: string | null = null;
  /**
   * Поколение списка: смена фильтра или uid отменяет ответы прошлых запросов.
   * Иначе медленный «Все» перезаписал бы уже показанные «Мои».
   */
  let generation = 0;

  function toggle(el: Element | null, show: boolean): void {
    if (el instanceof HTMLElement) el.classList.toggle('hidden', !show);
  }

  function announce(text: string): void {
    if (status) status.textContent = text;
  }

  /** Фильтр запроса: «Мои» — uid сессии; «Все» — без фильтра. */
  function buyerUid(): string | null {
    return mine ? live.uid() : null;
  }

  function syncFilterUi(): void {
    for (const node of filterButtons) {
      if (!(node instanceof HTMLElement)) continue;
      const active = node.dataset.logMine === '1' ? mine : !mine;
      node.classList.toggle('btn-arcade-primary', active);
      node.classList.toggle('btn-arcade-ghost', !active);
      node.setAttribute('aria-pressed', String(active));
    }
  }

  /** Состояние фильтра в URL: `?mine=1` — «Мои», без параметра — «Все». */
  function writeMineToUrl(): void {
    const url = new URL(window.location.href);
    if (mine) url.searchParams.set('mine', '1');
    else url.searchParams.delete('mine');
    window.history.replaceState(null, '', url.toString());
  }

  /** Сброс списка при смене фильтра или uid: курсор, плашка и ответы прошлых запросов. */
  function resetList(): void {
    generation += 1;
    loadingFirst = false;
    loadingMore = false;
    refreshing = false;
    refreshQueued = false;
    loaded = false;
    entries = [];
    pending = [];
    hasMore = false;
    observer?.disconnect();
    observer = null;
    if (moreButton instanceof HTMLButtonElement) moreButton.disabled = false;
    renderPill();
    toggle(error, false);
    toggle(empty, false);
    toggle(guest, false);
    toggle(body, false);
    toggle(more, false);
    toggle(skeleton, true);
  }

  /** «Мои покупки» без входа — подсказка вместо пустого лога. */
  function showGuest(): void {
    toggle(skeleton, false);
    toggle(body, false);
    toggle(empty, false);
    toggle(more, false);
    toggle(error, false);
    toggle(guest, true);
    announce('Войди через Twitch — тут будут твои покупки');
  }

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className = '',
    text?: string
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function money(value: number): string {
    return value.toLocaleString('ru-RU');
  }

  function plural(n: number, one: string, few: string, many: string): string {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return one;
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) return few;
    return many;
  }

  function lotHref(entry: DealEntry): string {
    return `${base}lot/?id=${encodeURIComponent(entry.slug)}`;
  }

  /** Миниатюра кадра из `video_url`; без постера — честная заглушка-🍺. */
  function thumb(entry: DealEntry, sizeClass: string): HTMLElement {
    const frame = el('span', `lot-media-frame block shrink-0 overflow-hidden ${sizeClass}`);
    const poster = videoSources(entry.video_url).poster;
    if (poster) {
      const img = el('img', 'h-full w-full object-cover');
      img.src = poster;
      img.alt = '';
      img.loading = 'lazy';
      frame.append(img);
    } else {
      frame.append(
        el('span', 'flex h-full w-full items-center justify-center bg-card text-base', '🍺')
      );
    }
    return frame;
  }

  /** Пометка «ТВОЙ» только на своей покупке: uid из снапшота живых данных. */
  function mineMark(entry: DealEntry): HTMLElement | null {
    const uid = live.uid();
    if (!uid || entry.buyer_uid === '' || entry.buyer_uid !== uid) return null;
    return el('span', 'badge-pixel ml-1 bg-pivko text-cream', 'ТВОЙ');
  }

  function priceEl(price: number): HTMLElement {
    return el('span', 'font-black whitespace-nowrap text-pivko', `${money(price)} 🍺`);
  }

  function whoLine(entry: DealEntry): HTMLElement {
    const line = el('div', 'flex flex-wrap items-baseline gap-x-1.5');
    line.append(
      el('b', 'break-all', entry.seller),
      el('span', 'text-mist', '→'),
      el('b', 'break-all', entry.buyer)
    );
    const mark = mineMark(entry);
    if (mark) line.append(mark);
    return line;
  }

  function tableHead(): HTMLTableSectionElement {
    const head = el('thead', 'bg-bar');
    const row = el('tr');
    const headers: ReadonlyArray<[string, string]> = [
      ['Когда', 'w-28 text-left'],
      ['Привет', 'text-left'],
      ['Продал', 'w-40 text-left'],
      ['Купил', 'w-40 text-left'],
      ['Цена', 'w-28 text-right'],
    ];
    for (const [title, width] of headers) {
      const th = el('th', `px-3 py-2 font-display text-[9px] uppercase ${width}`, title);
      th.scope = 'col';
      row.append(th);
    }
    head.append(row);
    return head;
  }

  /** Строка десктопной таблицы: миниатюра и название — одна ссылка на привет. */
  function dealRow(entry: DealEntry): HTMLTableRowElement {
    const tr = el('tr', 'border-t-2 border-milk/15 hover:bg-void/50');
    tr.append(
      el('td', 'px-3 py-2 whitespace-nowrap text-mist', formatRelativeTime(entry.created_at))
    );

    const lotCell = el('td', 'px-3 py-2');
    const lotLink = el('a', 'flex items-center gap-2 hover:text-ember');
    lotLink.href = lotHref(entry);
    lotLink.append(
      thumb(entry, 'aspect-[77/136] w-10'),
      el('span', 'font-extrabold break-words', entry.title)
    );
    lotCell.append(lotLink);

    const buyerCell = el('td', 'px-3 py-2 break-all');
    buyerCell.append(el('b', '', entry.buyer));
    const mark = mineMark(entry);
    if (mark) buyerCell.append(mark);

    const priceCell = el('td', 'px-3 py-2 text-right whitespace-nowrap');
    priceCell.append(priceEl(entry.price));

    tr.append(lotCell, el('td', 'px-3 py-2 break-all', entry.seller), buyerCell, priceCell);
    return tr;
  }

  /** Карточка телефона: вся площадь кликабельна через растяжку ссылки. */
  function dealCard(entry: DealEntry): HTMLLIElement {
    const li = el(
      'li',
      'relative border-2 border-milk bg-void px-3 py-2 text-sm font-bold shadow-[3px_3px_0_var(--color-milk)]'
    );
    li.dataset.dealCard = 'true';

    const row = el('div', 'flex gap-3');
    row.append(thumb(entry, 'aspect-[77/136] w-16'));

    const main = el('div', 'min-w-0 flex-1');
    const top = el('div', 'flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1');
    const lotLink = el('a', 'font-extrabold break-words hover:text-ember', entry.title);
    lotLink.href = lotHref(entry);
    lotLink.dataset.dealLink = 'true';
    top.append(lotLink, priceEl(entry.price));
    main.append(
      top,
      whoLine(entry),
      el('div', 'mt-0.5 text-xs font-bold text-mist', formatRelativeTime(entry.created_at))
    );
    row.append(main);
    li.append(row);
    return li;
  }

  function dayHead(day: DealDay): HTMLElement {
    const head = el(
      'h2',
      'sticky z-[5] flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-2 border-milk bg-pivko px-3 py-2 font-display text-[9px] uppercase text-cream'
    );
    // Липнет ровно под шапкой сайта: высоту меряет скрипт ниже.
    head.style.top = 'var(--deals-sticky-top, 6rem)';
    head.append(
      el('span', '', day.label),
      el(
        'span',
        'font-sans text-xs font-bold normal-case text-cream',
        `${day.count} ${plural(day.count, 'сделка', 'сделки', 'сделок')} · ${money(day.total)} 🍺`
      )
    );
    return head;
  }

  function daySection(day: DealDay): HTMLElement {
    const section = el('section', 'flex flex-col');

    const tableWrap = el('div', 'card-pixel mt-2 hidden overflow-hidden md:block');
    const table = el('table', 'w-full border-collapse text-sm');
    table.append(el('caption', 'sr-only', `${day.label}: сделки, новые сверху`), tableHead());
    const tbody = el('tbody');
    for (const entry of day.entries) tbody.append(dealRow(entry));
    table.append(tbody);
    tableWrap.append(table);

    const cards = el('ul', 'mt-2 flex flex-col gap-2 md:hidden');
    for (const entry of day.entries) cards.append(dealCard(entry));

    section.append(dayHead(day), tableWrap, cards);
    return section;
  }

  function dealsLabel(count: number): string {
    return `${count} ${plural(count, 'сделка', 'сделки', 'сделок')}`;
  }

  function newDealsLabel(count: number): string {
    return `${count} ${plural(count, 'новая сделка', 'новые сделки', 'новых сделок')}`;
  }

  function render(): void {
    if (!body) return;
    toggle(skeleton, false);
    toggle(error, false);
    toggle(guest, false);
    body.replaceChildren();
    const shown = entries.length > 0;
    toggle(body, shown);
    toggle(empty, loaded && !shown);
    toggle(more, shown && hasMore);
    if (shown) {
      const wrap = el('div', 'flex flex-col gap-5');
      for (const day of groupDealDays(entries)) wrap.append(daySection(day));
      body.append(wrap);
    }
    syncObserver();
  }

  function showError(): void {
    toggle(skeleton, false);
    toggle(body, false);
    toggle(empty, false);
    toggle(guest, false);
    toggle(more, false);
    toggle(error, true);
    announce('Лог не загрузился');
  }

  function renderPill(): void {
    if (!(pill instanceof HTMLElement)) return;
    if (pending.length === 0) {
      pill.classList.add('hidden');
      return;
    }
    pill.textContent = `↑ ${newDealsLabel(pending.length)}`;
    pill.classList.remove('hidden');
  }

  /**
   * Автоподгрузка сторожит блок кнопки с запасом в 240 px. Пересоздаём
   * наблюдатель после каждой перерисовки: иначе блок, оставшийся в зоне
   * видимости, не даст нового события и список не дочитается без клика.
   */
  function syncObserver(): void {
    observer?.disconnect();
    observer = null;
    if (!hasMore || loadingFirst || !more || !('IntersectionObserver' in window)) return;
    observer = new IntersectionObserver(
      (records) => {
        if (records.some((record) => record.isIntersecting)) void loadMore();
      },
      { rootMargin: '240px' }
    );
    observer.observe(more);
  }

  /** Верх лога виден, если его начало не уехало под липкую шапку. */
  function logTopVisible(): boolean {
    // Пустой лог показывать нечему — первая же сделка сразу встаёт на место.
    if (entries.length === 0 || !(body instanceof HTMLElement)) return true;
    const header = document.querySelector('header');
    const sticky = header instanceof HTMLElement ? header.offsetHeight : 0;
    return body.getBoundingClientRect().top >= sticky;
  }

  /** Первая страница: скелетон → записи, пусто или ошибка. */
  async function load(): Promise<void> {
    if (loadingFirst) return;
    // «Мои» без входа — подсказка, а не запрос без фильтра (он показал бы чужие).
    if (mine && !live.uid()) {
      showGuest();
      return;
    }
    const token = generation;
    loadingFirst = true;
    loaded = false;
    entries = [];
    pending = [];
    hasMore = false;
    renderPill();
    toggle(error, false);
    toggle(empty, false);
    toggle(guest, false);
    toggle(body, false);
    toggle(more, false);
    toggle(skeleton, true);
    announce('Загружаю лог сделок…');
    const page = await fetchDealLog(DEAL_PAGE_SIZE, null, buyerUid());
    // Пока читали, фильтр или сессия сменились — ответ устарел, состоянием владеет новый сброс.
    if (token !== generation) return;
    loadingFirst = false;
    if (!page.ok) {
      showError();
      return;
    }
    entries = page.entries;
    hasMore = page.entries.length === DEAL_PAGE_SIZE;
    loaded = true;
    render();
    announce(
      entries.length === 0
        ? 'Сделок пока нет'
        : hasMore
          ? `Загружено ${dealsLabel(entries.length)}`
          : `Лог дочитан — всего ${dealsLabel(entries.length)}`
    );
    if (refreshQueued) {
      refreshQueued = false;
      void refresh();
    }
  }

  /** Следующая (более старая) страница по курсору показанного. */
  async function loadMore(): Promise<void> {
    if (!hasMore || loadingFirst || loadingMore) return;
    const cursor = historyCursor(entries);
    if (!cursor) {
      hasMore = false;
      render();
      return;
    }
    const token = generation;
    loadingMore = true;
    if (moreButton instanceof HTMLButtonElement) moreButton.disabled = true;
    const page = await fetchDealLog(DEAL_PAGE_SIZE, cursor, buyerUid());
    if (token !== generation) return;
    loadingMore = false;
    if (moreButton instanceof HTMLButtonElement) moreButton.disabled = false;
    if (!page.ok) {
      announce('Не получилось подгрузить — попробуй ещё');
      return;
    }
    const next = appendHistory(entries, page.entries);
    const grew = next.length > entries.length;
    entries = next;
    // Полная страница без единой новой строки — дальше курсор не сдвинется.
    hasMore = page.entries.length === DEAL_PAGE_SIZE && grew;
    render();
    announce(
      hasMore
        ? `Показано ${dealsLabel(entries.length)}`
        : `Лог дочитан — всего ${dealsLabel(entries.length)}`
    );
  }

  /**
   * Живое событие `deals`: перечитываем только первую страницу с текущим
   * фильтром — в «Моих» чужие покупки так не приезжают, даже если событие
   * пришло по чужой сделке. Верх виден — вставляем новые строки сверху;
   * прокручено ниже — копим в плашке, чтобы список не прыгал под пальцем.
   */
  async function refresh(): Promise<void> {
    if (mine && !live.uid()) return;
    if (!loaded || refreshing) {
      refreshQueued = true;
      return;
    }
    const token = generation;
    refreshing = true;
    const page = await fetchDealLog(DEAL_PAGE_SIZE, null, buyerUid());
    if (token !== generation) return;
    refreshing = false;
    if (page.ok) {
      const known = new Set([...entries, ...pending].map((entry) => entry.id));
      const fresh = page.entries.filter((entry) => !known.has(entry.id));
      if (fresh.length > 0) {
        if (logTopVisible()) {
          entries = mergeHistory(entries, [...fresh, ...pending]);
          pending = [];
          renderPill();
          render();
        } else {
          pending = mergeHistory(pending, fresh);
          renderPill();
        }
        announce(`${newDealsLabel(fresh.length)}: в логе`);
      }
    }
    if (refreshQueued) {
      refreshQueued = false;
      void refresh();
    }
  }

  /** Переключить фильтр: URL, оформление и список начинаются заново. */
  function setMine(next: boolean): void {
    if (mine === next) return;
    mine = next;
    writeMineToUrl();
    syncFilterUi();
    resetList();
    if (!mine) {
      void load();
      return;
    }
    // uid ещё не прочитан — не показываем гостевую подсказку зря:
    // первый uid-событие подписки само решит «список или вход».
    if (!uidReady) return;
    if (live.uid()) void load();
    else showGuest();
  }

  /** uid снапшота: «ТВОЙ» в «Все», перезагрузка списка в «Моих», подсказка гостю. */
  function onUid(uid: string | null): void {
    const changed = !uidReady || uid !== seenUid;
    uidReady = true;
    seenUid = uid;
    if (!changed) return;
    if (mine) {
      resetList();
      if (uid) void load();
      else showGuest();
    } else if (loaded) {
      render();
    }
  }

  /** Липкая полоса дня встаёт под фактической высотой шапки, а не под догадкой. */
  function measureHeader(): void {
    const header = document.querySelector('header');
    if (header instanceof HTMLElement) {
      document.documentElement.style.setProperty('--deals-sticky-top', `${header.offsetHeight}px`);
    }
  }

  retry?.addEventListener('click', () => void load());
  moreButton?.addEventListener('click', () => void loadMore());
  for (const node of filterButtons) {
    node.addEventListener('click', () => {
      if (!(node instanceof HTMLElement)) return;
      setMine(node.dataset.logMine === '1');
    });
  }

  pill?.addEventListener('click', () => {
    if (pending.length === 0) return;
    const count = pending.length;
    entries = mergeHistory(entries, pending);
    pending = [];
    renderPill();
    render();
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    announce(`${newDealsLabel(count)}: в логе`);
  });

  // Сессия: «ТВОЙ» и «Мои покупки» зависят от uid; `deals` — свежая страница.
  live.subscribe((change) => {
    if (change.kind === 'uid') onUid(change.uid);
    if (change.kind === 'deals') void refresh();
  });

  measureHeader();
  window.addEventListener('resize', measureHeader);
  // Press Start 2P меняет высоту шапки после загрузки шрифта.
  void document.fonts?.ready.then(measureHeader);

  // Подписка уже могла отдать прочитанный uid (prime в live.subscribe);
  // в «Моих» без него список ждёт первого uid-события.
  syncFilterUi();
  if (!mine) void load();
  else if (uidReady && live.uid()) void load();
  else if (uidReady) showGuest();
</script>
