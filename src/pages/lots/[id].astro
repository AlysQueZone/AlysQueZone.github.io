---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyModal from '../../components/BuyModal.astro';
import { lots, type Lot } from '../../lib/lots.ts';

export function getStaticPaths() {
  return lots.map((lot) => ({ params: { id: lot.id }, props: { lot } }));
}

interface Props {
  lot: Lot;
}

const { lot } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const badgeClass =
  lot.rarity === 'legendary'
    ? 'bg-legend text-cream'
    : lot.rarity === 'rare'
      ? 'bg-terra text-cream'
      : 'bg-bar text-milk';

const rarityLabel =
  lot.rarity === 'legendary' ? 'ЛЕГЕНДА' : lot.rarity === 'rare' ? 'РЕДКИЙ' : 'ОБЫЧНЫЙ';

// Каталог для клиентского скрипта BuyModal (рендер «Моих приветов»).
const catalog = lots.map((l) => ({ id: l.id, title: l.title, price: l.price }));
---

<BaseLayout title={`${lot.title} — AlysQueZone`}>
  <a href={`${base}lots/`} class="text-sm font-bold text-stream hover:underline">← Назад на биржу</a>

  <article class="mt-4 rounded-2xl border border-card bg-panel p-5 sm:p-8">
    <span class={`inline-block w-fit rounded-full px-2.5 py-0.5 text-xs font-bold ${badgeClass}`}>
      {rarityLabel}
    </span>
    <h1 class="mt-3 text-2xl font-black uppercase sm:text-3xl">{lot.title}</h1>
    {lot.poster && <img src={`${base}${lot.poster}`} alt={lot.title} loading="lazy" class="mt-4 w-full max-w-md rounded-2xl object-cover" />}
    {lot.audio && <button type="button" data-lot-listen={`${base}${lot.audio}`} class="mt-3 w-fit cursor-pointer rounded-full border border-pivko/50 px-4 py-1.5 font-mono text-sm text-pivko hover:bg-pivko/10">▶ слушать</button>}
    <p class="mt-2 text-sm text-mist/70">
      владелец: <b data-lot-owner class="text-mist">{lot.owner}</b>
    </p>
    <p class="mt-3 font-mono text-2xl font-bold text-pivko">{lot.price} 🪙</p>
    {lot.meme && <p class="mt-3 rounded-xl bg-white/5 px-4 py-3 text-sm text-mist/80">{lot.meme}</p>}

    <div class="mt-5">
      {
        lot.forSale ? (
          <button
            type="button"
            class="cursor-pointer rounded-xl bg-stream px-6 py-3 font-extrabold text-white uppercase hover:bg-ctahover"
            data-buy-lot={lot.id}
            data-lot-title={lot.title}
            data-lot-price={lot.price}
            data-lot-owner={lot.owner}
            data-lot-audio={lot.audio ? `${base}${lot.audio}` : undefined}
            data-for-sale="true"
          >
            Купить за {lot.price} Пивкойнов
          </button>
        ) : (
          <button
            type="button"
            disabled
            class="cursor-not-allowed rounded-xl bg-white/10 px-6 py-3 font-extrabold text-mist/50 uppercase"
            title="ЛУК не продаётся. Хозяин не менялся."
          >
            НЕ ПРОДАЕТСЯ
          </button>
        )
      }
    </div>
  </article>

  <section aria-label="История перепродаж" class="mt-6 rounded-2xl border border-card bg-panel p-5 sm:p-8" data-lot-history data-lot-id={lot.id} data-lot-owner={lot.owner}>
    <h2 class="text-xl font-black uppercase">История перепродаж</h2>
    {
      lot.history.length === 0 && (
        <p data-history-empty class="mt-3 font-mono text-sm text-mist/60">
          Хозяин не менялся. ЛУК — легенда, пойжем жоско.
        </p>
      )
    }
    <ul data-history-list class="mt-3 flex flex-col gap-2 font-mono text-sm">
      {
        lot.history.map((h) => (
          <li class="rounded-xl border border-card bg-void px-3 py-2">
            {h.from} → {h.to} <span class="text-pivko">· {h.price} 🪙</span>
          </li>
        ))
      }
    </ul>
  </section>

  <span data-lots-catalog class="hidden" set:html={JSON.stringify(catalog)} />
  <BuyModal />
</BaseLayout>

<script>
  import { getLocalHistory, owns } from '../../lib/wallet.ts';

  const section = document.querySelector('[data-lot-history]');
  const lotId = section instanceof HTMLElement ? (section.dataset.lotId ?? '') : '';
  const lotOwner = section instanceof HTMLElement ? (section.dataset.lotOwner ?? '') : '';
  const list = document.querySelector('[data-history-list]');
  const emptyNote = document.querySelector('[data-history-empty]');
  const ownerEl = document.querySelector('b[data-lot-owner]');

  function renderLocalHistory() {
    if (!list) return;
    const local = getLocalHistory(lotId);
    list.querySelectorAll('[data-local-entry]').forEach((el) => el.remove());
    for (const h of local) {
      const li = document.createElement('li');
      li.setAttribute('data-local-entry', 'true');
      li.className = 'rounded-xl border border-rind/40 bg-void px-3 py-2';
      li.textContent = `${h.from} → ${h.to} · ${h.price} 🪙`;
      list.appendChild(li);
    }
    if (emptyNote) {
      emptyNote.style.display = list.children.length > 0 ? 'none' : '';
    }
    if (ownerEl && owns(lotId)) {
      ownerEl.textContent = `ты (был: ${lotOwner})`;
    }
  }

  renderLocalHistory();
  window.addEventListener('alysque:bought', (e) => {
    if ((e as CustomEvent).detail?.id === lotId) renderLocalHistory();
  });
</script>
