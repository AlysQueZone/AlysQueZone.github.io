---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyModal from '../../components/BuyModal.astro';
import LotVideo from '../../components/LotVideo.astro';
import { fetchCatalogLots, type Lot } from '../../lib/lots.ts';

// SSG из БД на билде (тикет 09): без PUBLIC_SUPABASE_* билд падает явно,
// статического фолбэка нет.
export async function getStaticPaths() {
  const catalog = await fetchCatalogLots();
  return catalog.map((lot) => ({ params: { id: lot.id }, props: { lot } }));
}

interface Props {
  lot: Lot;
}

const { lot } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const badgeClass =
  lot.rarity === 'legendary'
    ? 'bg-legend text-cream'
    : lot.rarity === 'rare'
      ? 'bg-terra text-cream'
      : 'bg-bar text-milk';

const rarityLabel =
  lot.rarity === 'legendary' ? 'ЛЕГЕНДА' : lot.rarity === 'rare' ? 'РЕДКИЙ' : 'ОБЫЧНЫЙ';

// Каталог для клиентского скрипта BuyModal (рендер «Моих приветов»).
const catalog = (await fetchCatalogLots()).map((l) => ({ id: l.id, title: l.title, price: l.price }));
---

<BaseLayout title={`${lot.title} — AlysQueZone`}>
  <a href={`${base}lots/`} class="text-sm font-bold text-stream hover:underline">← Назад на биржу</a>

  <article class="mt-4 rounded-2xl border border-card bg-panel p-5 sm:p-8">
    <span class={`inline-block w-fit rounded-full px-2.5 py-0.5 text-xs font-bold ${badgeClass}`}>
      {rarityLabel}
    </span>
    <h1 class="mt-3 text-2xl font-black uppercase sm:text-3xl">{lot.title}</h1>
    <div class="mt-4 w-full max-w-md">
      <LotVideo videoUrl={lot.video_url} title={lot.title} />
    </div>
    <p class="mt-2 text-sm text-mist/70">
      владелец: <b data-lot-owner data-shared-owner class="text-mist">{lot.owner ?? '—'}</b> <span data-mine-badge class="hidden font-bold text-rind">· ТВОЙ</span>
    </p>
    <p data-shared-price class="mt-3 font-mono text-2xl font-bold text-pivko">{lot.price} 🍺</p>
    {lot.meme_text && <p class="mt-3 rounded-xl bg-white/5 px-4 py-3 text-sm text-mist/80">{lot.meme_text}</p>}

    <div class="mt-5">
      <button
        type="button"
        class="cursor-pointer rounded-xl bg-stream px-6 py-3 font-extrabold text-white uppercase hover:bg-ctahover"
        data-buy-lot={lot.id}
        data-lot-title={lot.title}
        data-lot-price={lot.price}
        data-lot-owner={lot.owner ?? '—'}
        data-lot-video={lot.video_url ?? undefined}
      >
        Купить за {lot.price} Пивкойнов
      </button>
    </div>
  </article>

  <section aria-label="История перепродаж" class="mt-6 rounded-2xl border border-card bg-panel p-5 sm:p-8" data-lot-history data-lot-id={lot.id} data-lot-owner={lot.owner ?? '—'}>
    <h2 class="text-xl font-black uppercase">История перепродаж</h2>
    <p data-history-empty class="mt-3 font-mono text-sm text-mist/60">
      Пока никто не забирал — стань первым
    </p>
    <ul data-history-list class="mt-3 flex flex-col gap-2 font-mono text-sm">
    </ul>
  </section>

  <span data-lots-catalog class="hidden" set:html={JSON.stringify(catalog)} />
  <BuyModal />
</BaseLayout>

<script>
  import {
    getSupabase,
    isSupabaseConfigured,
    fetchSharedLots,
    fetchSharedHistory,
    getSessionUid,
    subscribeSharedLots,
  } from '../../lib/supabase.ts';

  const section = document.querySelector('[data-lot-history]');
  const lotId = section instanceof HTMLElement ? (section.dataset.lotId ?? '') : '';
  const lotOwner = section instanceof HTMLElement ? (section.dataset.lotOwner ?? '') : '';
  const list = document.querySelector('[data-history-list]');
  const emptyNote = document.querySelector('[data-history-empty]');
  const ownerEl = document.querySelector('b[data-lot-owner]');
  const priceEl = document.querySelector('[data-shared-price]');
  const mineBadge = document.querySelector('[data-mine-badge]');
  const buyBtn = document.querySelector('[data-buy-lot]');

  function renderSharedHistory(
    entries: { from: string; to: string; price: number; buyer_uid: string }[],
    uid: string | null,
  ): void {
    if (!list) return;
    list.querySelectorAll('[data-shared-entry]').forEach((el) => el.remove());
    const frag = document.createDocumentFragment();
    for (const h of entries) {
      const li = document.createElement('li');
      li.setAttribute('data-shared-entry', 'true');
      li.className = 'rounded-xl border border-stream/40 bg-void px-3 py-2';
      const mine = uid !== null && h.buyer_uid !== '' && h.buyer_uid === uid;
      li.textContent = `${h.from} → ${h.to} · ${h.price} 🍺${mine ? ' · ТВОЙ' : ''}`;
      frag.appendChild(li);
    }
    list.appendChild(frag);
    if (emptyNote) {
      emptyNote.style.display = list.children.length > 0 ? 'none' : '';
    }
  }

  let refreshing = false;
  async function refreshShared(): Promise<void> {
    if (refreshing || !isSupabaseConfigured()) return;
    refreshing = true;
    try {
      const [states, uid, tail] = await Promise.all([
        fetchSharedLots(),
        getSessionUid(),
        fetchSharedHistory(lotId, lotOwner),
      ]);
      const shared = states.get(lotId);
      if (shared && Number.isFinite(shared.price)) {
        if (ownerEl) ownerEl.textContent = shared.owner_login ?? ownerEl.textContent;
        if (priceEl) priceEl.textContent = `${shared.price} 🍺`;
        if (mineBadge instanceof HTMLElement) {
          const mine = uid !== null && shared.owner_uid !== null && shared.owner_uid === uid;
          mineBadge.classList.toggle('hidden', !mine);
        }
        if (buyBtn instanceof HTMLElement) {
          if (buyBtn.dataset.lotOwner !== undefined && shared.owner_login) {
            buyBtn.dataset.lotOwner = shared.owner_login;
          }
          if (buyBtn.dataset.lotPrice !== undefined) {
            buyBtn.dataset.lotPrice = String(shared.price);
          }
          buyBtn.textContent = `Купить за ${shared.price} Пивкойнов`;
        }
      }
      renderSharedHistory(tail, uid);
    } finally {
      refreshing = false;
    }
  }

  // Перерисовка — только от shared/Realtime; локальный инвентарь не читаем.
  window.addEventListener('alysque:bought', (e) => {
    if ((e as CustomEvent).detail?.id === lotId) {
      void refreshShared();
    }
  });

  if (isSupabaseConfigured()) {
    void refreshShared();
    subscribeSharedLots(() => void refreshShared(), lotId);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refreshShared();
    });
    window.addEventListener('focus', () => void refreshShared());
    getSupabase()?.auth.onAuthStateChange(() => void refreshShared());
  }
</script>
