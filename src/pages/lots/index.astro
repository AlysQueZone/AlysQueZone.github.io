---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LotCard from '@/components/LotCard.astro';
import LotCardSkeleton from '@/components/LotCardSkeleton.astro';
import BuyModal from '@/components/BuyModal.astro';
import SuggestGreeting from '@/components/SuggestGreeting.astro';
import BrandHeadline from '@/components/BrandHeadline.astro';
import { CATALOG_PAGE_SIZE } from '@/lib/catalog-page';

// Витрина — каркас: карточек в HTML нет, сетку целиком рисует клиент из БД
// (см. docs/adr/0002). Шаблон карточки — единственный источник разметки.
// Скелетонов — ровно на первую страницу: столько же карточек вернёт первый
// запрос, поэтому загрузка не прыгает.
---

<BaseLayout
  title="AlysQueZone — БИРЖА ПРИВЕТОВ"
  description="Все лоты биржи приветов alysque: цены, владельцы и покупка за Пивкойны."
>
  <BrandHeadline class="font-display text-sm leading-loose uppercase sm:text-lg sm:leading-loose">
    <span class="text-ember">Стрим включился, а ты?</span>
  </BrandHeadline>
  <p class="mt-3 text-mist">Выбирай лот, жми «купить» и забирай, пока чат не разобрал</p>

  <section aria-label="Мои приветы" class="mt-8">
    <h2 class="font-display text-xs uppercase">
      Мои приветы{' '}
      <span data-my-privety-count class="text-pivko">
        —
      </span>
    </h2>
    <div data-my-privety class="mt-3 flex flex-col gap-2">
      <div
        data-my-privety-skeleton
        class="border-2 border-milk bg-panel px-3 py-2"
        aria-hidden="true"
      >
        <div class="skeleton-block h-4 w-1/2"></div>
      </div>
    </div>
  </section>

  <section aria-label="Все лоты" class="mt-8">
    <h2 class="font-display text-xs uppercase">Все лоты</h2>
    <p data-lots-state class="mt-3 hidden text-sm font-bold text-mist"></p>
    <p data-lots-status class="sr-only" role="status">
      Загружаю лоты…
    </p>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-lot-grid>
      {Array.from({ length: CATALOG_PAGE_SIZE }, () => (
        <LotCardSkeleton />
      ))}
    </div>

    <div data-lots-more class="mt-4 hidden">
      <div class="flex flex-col items-center gap-2">
        <button
          type="button"
          class="btn-arcade btn-arcade-ghost px-5 py-2 text-sm"
          data-lots-more-btn
        >
          Показать ещё
        </button>
        <p data-lots-more-status class="text-sm font-bold text-mist" role="status"></p>
      </div>
    </div>
    <p data-lots-end class="mt-4 hidden text-center text-sm font-bold text-mist">
      Это все приветы
    </p>

    <SuggestGreeting />
  </section>

  <BuyModal />

  <template data-lot-card-template>
    <LotCard />
  </template>
  <template data-lot-skeleton-template>
    <LotCardSkeleton />
  </template>
</BaseLayout>

<script>
  // Витрина — окно каталога: страницы по CATALOG_PAGE_SIZE (lib/catalog-page.ts),
  // их догружает скролл к кнопке «Показать ещё» (она же фолбэк без
  // IntersectionObserver). «Мои приветы» — отдельный полный список владельца
  // (live.trackMyLots), а не фильтр загруженных страниц: лот с дальней страницы
  // не должен пропадать. Карточки, слоты и раскладку кадра заполняет
  // lib/lot-view.ts (fillLot), как на главной и странице лота.
  import { live, type LotState } from '@/lib/live';
  import { fillLot, lotUrl } from '@/lib/lot-view';
  import { CATALOG_PAGE_SIZE } from '@/lib/catalog-page';
  import { peekPendingBuy } from '@/lib/supabase';

  const GUEST_TEXT = 'Войди через Twitch — тут будут твои приветы';
  const EMPTY_TEXT = 'Пока пусто — забери первый привет ниже';
  const GRID_EMPTY_TEXT = 'Пока лотов нет — скоро появятся';
  const FAIL_TEXT = 'Лоты не загрузились. Проверь связь и обнови страницу';
  const MORE_FAIL_TEXT = 'Не получилось подгрузить — попробуй ещё';
  /** Баланс — зеркало гейта: не хватает — кнопки гаснут. */
  let myBalance: number | null = null;
  /** Состояние подгрузки: ошибка блокирует авто-повтор до клика по кнопке. */
  let moreState: 'idle' | 'loading' | 'error' = 'idle';

  // Срез витрины — страницы; режим фиксируется до первого чтения.
  live.useCatalogPages(CATALOG_PAGE_SIZE);
  live.trackMyLots();

  // Возврат к покупке после логина: лот мог быть на дальней странице — без его
  // карточки модалка не найдёт кнопку и возврат потеряется.
  const pendingBuy = peekPendingBuy();
  if (pendingBuy) void live.ensureCatalogLot(pendingBuy);

  const moreWrap = document.querySelector('[data-lots-more]');
  const moreBtn = document.querySelector('[data-lots-more-btn]');
  const moreStatus = document.querySelector('[data-lots-more-status]');
  const endNote = document.querySelector('[data-lots-end]');
  const skeletonTpl = document.querySelector('[data-lot-skeleton-template]');
  // Скелетон «Моих приветов» — тот же, что в серверной разметке; держим копию,
  // чтобы при смене сессии вернуть его без второй копии разметки в скрипте.
  const myPrivetySkeleton =
    document.querySelector('[data-my-privety-skeleton]')?.cloneNode(true) ?? null;

  function toggle(el: Element | null, show: boolean): void {
    if (el instanceof HTMLElement) el.classList.toggle('hidden', !show);
  }

  function showMyNote(text: string, count: number): void {
    const slot = document.querySelector('[data-my-privety]');
    const counter = document.querySelector('[data-my-privety-count]');
    if (counter) counter.textContent = String(count);
    if (!slot) return;
    slot.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'text-sm font-bold text-mist';
    p.textContent = text;
    slot.appendChild(p);
  }

  /** Пока список владельца едет — тот же скелетон, что на первой загрузке. */
  function showMySkeleton(): void {
    const slot = document.querySelector('[data-my-privety]');
    const counter = document.querySelector('[data-my-privety-count]');
    if (counter) counter.textContent = '—';
    if (!slot) return;
    slot.replaceChildren(...(myPrivetySkeleton ? [myPrivetySkeleton.cloneNode(true)] : []));
  }

  function setGridNote(text: string | null): void {
    const note = document.querySelector('[data-lots-state]');
    if (!(note instanceof HTMLElement)) return;
    note.classList.toggle('hidden', text === null);
    note.textContent = text ?? '';
  }

  /** Скринридеру: «Загружаю…» живёт только до первого ответа БД. */
  function setStatus(text: string): void {
    const status = document.querySelector('[data-lots-status]');
    if (status instanceof HTMLElement) status.textContent = text;
  }

  /** Скелетоны — только на первую загрузку: дальше сетку держит Realtime. */
  function clearSkeletons(): void {
    document.querySelectorAll('[data-lot-skeleton]').forEach((el) => el.remove());
  }

  function renderMyGreetings(uid: string | null): void {
    const slot = document.querySelector('[data-my-privety]');
    const counter = document.querySelector('[data-my-privety-count]');
    if (!slot) return;
    if (uid === null) {
      showMyNote(GUEST_TEXT, 0);
      return;
    }
    // Ответа по «Моим приветам» ещё нет — скелетон честнее пустоты и чужого
    // списка, который мог остаться после смены сессии.
    if (!live.myLotsKnown()) {
      showMySkeleton();
      return;
    }
    const mine = live.myLots();
    if (counter) counter.textContent = String(mine.length);
    if (mine.length === 0) {
      showMyNote(EMPTY_TEXT, 0);
      return;
    }
    slot.innerHTML = '';
    for (const s of mine) {
      const price = Number.isFinite(s.price) ? s.price : 0;
      const row = document.createElement('div');
      row.className =
        'border-2 border-milk bg-panel px-3 py-2 text-sm shadow-[3px_3px_0_var(--color-milk)]';
      const link = document.createElement('a');
      link.href = lotUrl(s.slug);
      link.className = 'font-bold hover:underline';
      link.textContent = s.title;
      row.appendChild(link);
      const priceSpan = document.createElement('span');
      priceSpan.className = 'text-pivko';
      priceSpan.textContent = ` ${price} 🍺`;
      row.appendChild(priceSpan);
      slot.appendChild(row);
    }
  }

  /** Заполнить карточку состоянием Лота: слоты и раскладку кадра ведёт
   *  общий lib/lot-view.ts (fillLot); здесь — только ключ reconcile. */
  function fillCard(card: HTMLElement, st: LotState): void {
    card.dataset.lotCard = st.slug;
    fillLot(card, st, { balance: myBalance });
  }

  // slug → узел карточки: reconcile набора (создать/снести/обновить).
  const rendered = new Map<string, HTMLElement>();

  function reconcile(states: readonly LotState[]): void {
    const grid = document.querySelector('[data-lot-grid]');
    const tpl = document.querySelector('[data-lot-card-template]');
    if (!(grid instanceof HTMLElement) || !(tpl instanceof HTMLTemplateElement)) return;

    const bySlug = new Map(states.map((st) => [st.slug, st]));
    for (const [slug, el] of [...rendered]) {
      if (!bySlug.has(slug)) {
        el.remove();
        rendered.delete(slug);
      }
    }

    for (const st of states) {
      if (!Number.isFinite(st.price)) continue;
      const card = rendered.get(st.slug);
      if (card) {
        fillCard(card, st);
        continue;
      }
      const fresh = tpl.content.firstElementChild;
      if (!(fresh instanceof HTMLElement)) return;
      const created = fresh.cloneNode(true) as HTMLElement;
      rendered.set(st.slug, created);
      fillCard(created, st);
      insertSorted(grid, created, bySlug);
    }
  }

  // Витрина — от дешёвых к дорогим (новичок первым делом видит доступные лоты).
  // Новую карточку ставим по цене, уже нарисованные не двигаем: живой ресорт
  // не делаем, чтобы карточка не уезжала из-под курсора.
  function insertSorted(
    grid: HTMLElement,
    card: HTMLElement,
    states: ReadonlyMap<string, LotState>
  ): void {
    const price = states.get(card.dataset.lotCard ?? '')?.price ?? 0;
    const before = [...grid.querySelectorAll<HTMLElement>('[data-lot-card]')].find(
      (node) => node !== card && (states.get(node.dataset.lotCard ?? '')?.price ?? 0) > price
    );
    grid.insertBefore(card, before ?? null);
  }

  /** Подгрузка идёт скелетонами — не текстом-заглушкой (AGENTS.md). */
  function addLoadingSkeletons(): void {
    const grid = document.querySelector('[data-lot-grid]');
    if (!(grid instanceof HTMLElement) || !(skeletonTpl instanceof HTMLTemplateElement)) return;
    for (let i = 0; i < 3; i++) {
      const fresh = skeletonTpl.content.firstElementChild;
      if (!(fresh instanceof HTMLElement)) return;
      const clone = fresh.cloneNode(true) as HTMLElement;
      // Маркер загрузки свой: живой тик зовёт clearSkeletons и не должен
      // сносить скелетоны подгрузки до ответа страницы.
      clone.removeAttribute('data-lot-skeleton');
      clone.dataset.lotsLoading = '1';
      grid.appendChild(clone);
    }
  }

  function removeLoadingSkeletons(): void {
    document.querySelectorAll('[data-lots-loading]').forEach((el) => el.remove());
  }

  function updateMoreUi(): void {
    const known = live.catalogKnown();
    const hasMore = live.catalogHasMore();
    const count = live.catalogWindow().length;
    toggle(moreWrap, known && hasMore);
    toggle(endNote, known && !hasMore && count > 0);
    if (moreBtn instanceof HTMLButtonElement) {
      moreBtn.disabled = moreState === 'loading';
      moreBtn.textContent =
        moreState === 'loading'
          ? 'Загружаю ещё…'
          : moreState === 'error'
            ? 'Повторить'
            : 'Показать ещё';
    }
    if (moreStatus instanceof HTMLElement) {
      moreStatus.textContent = moreState === 'error' ? MORE_FAIL_TEXT : '';
    }
  }

  /** Сентинел в зоне подгрузки: высокий вьюпорт/короткая страница — догружаем. */
  function sentinelNear(): boolean {
    if (!(moreWrap instanceof HTMLElement) || moreWrap.classList.contains('hidden')) return false;
    return moreWrap.getBoundingClientRect().top <= window.innerHeight + 600;
  }

  /** Догрузить страницу; `manual` — клик по кнопке, он же снимает блок ошибки. */
  async function loadMore(manual: boolean): Promise<void> {
    if (moreState === 'loading' || !live.catalogHasMore()) return;
    if (moreState === 'error' && !manual) return;
    moreState = 'loading';
    updateMoreUi();
    addLoadingSkeletons();
    try {
      const result = await live.loadCatalogPage();
      moreState = result === 'error' ? 'error' : 'idle';
    } finally {
      removeLoadingSkeletons();
      updateMoreUi();
      render();
    }
    // Пересечение уже было, нового колбэка не будет: если сентинел всё ещё
    // в зоне загрузки (страница не заполнила экран) — тянем следующую.
    if (moreState === 'idle' && live.catalogHasMore() && sentinelNear()) void loadMore(false);
  }

  /** Полная перерисовка окна: карточки, «мои приветы» и заметки. */
  function render(): void {
    const uid = live.uid();
    myBalance = live.balance();
    renderMyGreetings(uid);
    // Ответа БД ещё не было — скелетоны честнее «пусто» и «не загрузилось».
    if (live.catalogKnown()) {
      const states = live.catalogWindow();
      reconcile(states);
      const empty = states.length === 0;
      // Пусто ≠ не загрузилось: заметка честная, последнее хорошее не трём.
      const gridMsg = !live.catalogOk() && empty ? FAIL_TEXT : empty ? GRID_EMPTY_TEXT : null;
      setGridNote(gridMsg);
      setStatus(gridMsg ?? '');
      clearSkeletons();
    }
    updateMoreUi();
  }

  /** Баланс пришёл — перекрасить кнопки, не перезапрашивая каталог. */
  function repaintCards(): void {
    for (const [slug, el] of rendered) {
      const st = live.lot(slug);
      if (st) fillCard(el, st);
    }
  }

  // Подгрузка — скроллом к сентинелу; кнопка остаётся для клавиатуры и как
  // повтор после ошибки. rootMargin — чтобы страница начинала грузиться заранее.
  if (moreWrap && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) void loadMore(false);
      },
      { rootMargin: '600px 0px' }
    );
    observer.observe(moreWrap);
  }
  moreBtn?.addEventListener('click', () => void loadMore(true));

  // Снапшот живых данных — единственный источник: окно каталога, uid и баланс.
  live.subscribe((change) => {
    if (change.kind === 'catalog' || change.kind === 'uid' || change.kind === 'myLots') render();
    if (change.kind === 'balance') {
      myBalance = change.balance;
      repaintCards();
    }
  });
</script>
