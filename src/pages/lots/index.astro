---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LotCard from '../../components/LotCard.astro';
import BuyModal from '../../components/BuyModal.astro';
import { fetchCatalogLots } from '../../lib/lots.ts';

// Каталог — из БД на билде (тикет 09): без PUBLIC_SUPABASE_* билд падает явно.
const lots = await fetchCatalogLots();

// Каталог для клиентского рендера «Моих приветов» (читает скрипт витрины).
const catalog = lots.map((lot) => ({ id: lot.id, title: lot.title, price: lot.price }));
---

<BaseLayout title="AlysQueZone — БИРЖА ПРИВЕТОВ">
  <h1 class="text-3xl font-black uppercase">
    Биржа приветов. <span class="text-ember">Стрим включился, а ты?</span>
  </h1>
  <p class="mt-2 text-mist/80">
    Выбирай лот, жми «купить», кайфуем жоско + мощно. Жду тебя 🙂🙂🙂
  </p>

  <section aria-label="Мои приветы" class="mt-8">
    <h2 class="text-xl font-black uppercase">
      Мои приветы <span data-my-privety-count class="font-mono text-pivko">0</span>
    </h2>
    <div data-my-privety class="mt-3 flex flex-col gap-2"></div>
  </section>

  <section aria-label="Все лоты" class="mt-8">
    <h2 class="text-xl font-black uppercase">Все лоты</h2>
    <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {lots.map((lot) => <LotCard lot={lot} />)}
    </div>
  </section>

  <span data-lots-catalog class="hidden" set:html={JSON.stringify(catalog)} />
  <BuyModal />
</BaseLayout>

<script>
  // Живая витрина (тикет 09): shared-Владелец/цена поверх каталога из БД.
  // Названия, Редкость, мем-тексты и видео запечены на билде из БД —
  // скрипт дотягивает только владельца, цену, свежие данные кнопки «Купить»
  // и бейдж «ТВОЙ» (owner_uid == сессия). Владелец NULL — бейдж скрыт.
  // «Мои приветы» — только из БД: лоты, где owner_uid == uid сессии.
  // Локальный инвентарь не читаем; перерисовка — от shared/Realtime.
  // Без PUBLIC_SUPABASE_* — честная деградация: остаётся запечённый каталог.
  import {
    getSupabase,
    isSupabaseConfigured,
    fetchSharedLots,
    getSessionUid,
    subscribeSharedLots,
  } from '../../lib/supabase.ts';
  import type { SharedLotState } from '../../lib/supabase.ts';

  const GUEST_TEXT = 'Войди через Twitch — тут будут твои приветы';
  const EMPTY_TEXT = 'Пока пусто — забери первый привет ниже';

  function readCatalog(): { id: string; title: string; price: number }[] {
    const tag = document.querySelector('[data-lots-catalog]');
    if (!tag) return [];
    try {
      const parsed: unknown = JSON.parse(tag.textContent ?? '[]');
      return Array.isArray(parsed) ? (parsed as { id: string; title: string; price: number }[]) : [];
    } catch {
      return [];
    }
  }

  function showMyNote(text: string, count: number): void {
    const slot = document.querySelector('[data-my-privety]');
    const counter = document.querySelector('[data-my-privety-count]');
    if (counter) counter.textContent = String(count);
    if (!slot) return;
    slot.innerHTML = '';
    const p = document.createElement('p');
    p.className = 'font-mono text-sm text-mist/60';
    p.textContent = text;
    slot.appendChild(p);
  }

  function renderMyGreetings(states: Map<string, SharedLotState>, uid: string | null): void {
    const slot = document.querySelector('[data-my-privety]');
    const counter = document.querySelector('[data-my-privety-count]');
    if (!slot) return;
    if (uid === null) {
      showMyNote(GUEST_TEXT, 0);
      return;
    }
    const catalog = readCatalog();
    const byId = new Map(catalog.map((l) => [l.id, l]));
    const mine = [...states.entries()].filter(([, s]) => s.owner_uid !== null && s.owner_uid === uid);
    if (counter) counter.textContent = String(mine.length);
    if (mine.length === 0) {
      showMyNote(EMPTY_TEXT, 0);
      return;
    }
    slot.innerHTML = '';
    for (const [id, s] of mine) {
      const known = byId.get(id);
      const title = known ? known.title : id;
      const price = Number.isFinite(s.price) ? s.price : (known?.price ?? 0);
      const row = document.createElement('div');
      row.className = 'rounded-xl border border-rind/40 bg-panel px-3 py-2 text-sm';
      const link = document.createElement('a');
      link.href = `./${encodeURIComponent(id)}/`;
      link.className = 'font-bold hover:underline';
      link.textContent = title;
      row.appendChild(link);
      const priceSpan = document.createElement('span');
      priceSpan.className = 'text-pivko';
      priceSpan.textContent = ` ${price} 🍺`;
      row.appendChild(priceSpan);
      const badge = document.createElement('span');
      badge.className = 'text-rind';
      badge.textContent = ' · ТВОЙ';
      row.appendChild(badge);
      slot.appendChild(row);
    }
  }

  if (isSupabaseConfigured()) {
    const applyCard = (
      card: HTMLElement,
      owner: string,
      price: number,
      mine: boolean,
    ): void => {
      const ownerEl = card.querySelector('[data-shared-owner]');
      if (ownerEl) ownerEl.textContent = owner;
      const priceEl = card.querySelector('[data-shared-price]');
      if (priceEl) priceEl.textContent = `${price} 🍺`;
      const badge = card.querySelector('[data-mine-badge]');
      if (badge) badge.classList.toggle('hidden', !mine);
      const buyBtn = card.querySelector('[data-buy-lot]');
      if (buyBtn instanceof HTMLButtonElement) {
        if (buyBtn.dataset.lotOwner !== undefined) buyBtn.dataset.lotOwner = owner;
        if (buyBtn.dataset.lotPrice !== undefined) buyBtn.dataset.lotPrice = String(price);
        // Свой лот купить нельзя (перекуп у себя бессмыслен): кнопка гаснет.
        buyBtn.disabled = mine;
        buyBtn.textContent = mine ? 'Твой привет' : 'Купить';
        buyBtn.classList.toggle('opacity-50', mine);
      }
    };

    let refreshing = false;
    async function refresh(): Promise<void> {
      if (refreshing) return;
      refreshing = true;
      try {
        const [states, uid] = await Promise.all([fetchSharedLots(), getSessionUid()]);
        document.querySelectorAll('[data-lot-card]').forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          const id = node.dataset.lotCard ?? '';
          const shared = states.get(id);
          if (!shared || !Number.isFinite(shared.price)) return;
          applyCard(
            node,
            shared.owner_login ?? node.querySelector('[data-shared-owner]')?.textContent ?? '—',
            shared.price,
            uid !== null && shared.owner_uid !== null && shared.owner_uid === uid,
          );
        });
        renderMyGreetings(states, uid);
      } finally {
        refreshing = false;
      }
    }

    void refresh();
    subscribeSharedLots(() => void refresh());
    // Свежесть при возврате на вкладку (Realtime мог пропустить): перезапрос.
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) void refresh();
    });
    window.addEventListener('focus', () => void refresh());
    // Своя покупка — перезапрос shared (локальные данные события не используем).
    window.addEventListener('alysque:bought', () => void refresh());
    // Вход/выход меняет только бейдж «ТВОЙ» и секцию «Мои приветы».
    getSupabase()?.auth.onAuthStateChange(() => void refresh());
  } else {
    showMyNote(GUEST_TEXT, 0);
  }
</script>
