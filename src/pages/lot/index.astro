---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BuyModal from '@/components/BuyModal.astro';
import LotVideo from '@/components/LotVideo.astro';
import LotBadges from '@/components/LotBadges.astro';
import { LOT_DETAIL_ASPECT } from '@/lib/lot-video';

// Страница Лота — один маршрут `/lot/?id=<slug>`: каркас без данных, поля
// заполняет клиент из БД (см. docs/adr/0002). Работает для лота, которого
// не было на сборке. Старые адреса `/lots/<slug>/` не поддерживаются.
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="AlysQueZone — ЛОТ">
  <a href={`${base}lots/`} class="text-sm font-bold text-stream hover:underline">
    ← Назад на биржу
  </a>

  <p data-lot-status class="sr-only" role="status">
    Загружаю лот…
  </p>

  <!-- Скелетон до первого ответа БД: каркас как у data-lot-view — название →
       кадр → кнопка (владелец и цена теперь в бейдже и кнопке, отдельных строк
       нет). Кадр — «телефонной» ширины-плейсхолдера, как до загрузки постера. -->
  <article data-lot-skeleton class="card-pixel mt-4 p-5 sm:p-8" aria-hidden="true">
    <div class="skeleton-block mt-4 h-8 w-2/3"></div>
    <div class="skeleton-block mt-4 aspect-square w-full max-w-md"></div>
    <div class="skeleton-block mt-5 h-11 w-32"></div>
  </article>

  <article class="card-pixel mt-4 hidden p-5 sm:p-8" data-lot-view>
    <h1 class="mt-4 text-2xl font-black sm:text-3xl" data-lot-title></h1>
    <div class="mt-4 w-full">
      <LotVideo videoUrl={null} title="" aspect={LOT_DETAIL_ASPECT}>
        <LotBadges />
      </LotVideo>
    </div>
    <p data-lot-suggested class="mt-2 hidden text-sm text-mist">
      Привет добавил:{' '}
      <b data-lot-suggested-login class="text-mist">
        {' '}
        —{' '}
      </b>
    </p>

    <div class="mt-5">
      <button
        type="button"
        class="btn-arcade btn-arcade-primary px-6 py-3"
        data-buy-intent
        disabled
      >
        Забрать
      </button>
    </div>
  </article>

  <section
    aria-label="История перепродаж"
    class="card-pixel mt-6 hidden p-5 sm:p-8"
    data-lot-history
  >
    <h2 class="font-display text-xs uppercase">История перепродаж</h2>
    <p data-history-empty class="mt-3 text-sm font-bold text-mist">
      Пока никто не забирал — стань первым
    </p>
    <ul data-history-list class="mt-3 flex flex-col gap-2 text-sm font-bold"></ul>
  </section>

  <p data-lot-missing class="card-pixel mt-4 hidden p-5 text-sm font-bold text-mist sm:p-8">
    Такого лота нет — возможно, привет уже увёл другой чатерс. Вернись на биржу.
  </p>

  <p data-lot-error class="card-pixel mt-4 hidden p-5 text-sm font-bold text-mist sm:p-8">
    Не получилось загрузить лот — проверь связь и обнови страницу.
  </p>

  <BuyModal />
</BaseLayout>

<script>
  // Страница лота: slug — из query (`?id=`), состояние — снапшот живых данных
  // (lib/live.ts), хвост перепродаж — из БД (lib/supabase.ts). Перерисовка —
  // от событий снапшота: тик, фокус/возврат и смена сессии — его триггеры.
  import { fetchSharedHistory, type SharedHistoryEntry } from '@/lib/supabase';
  import { live, type LotState } from '@/lib/live';
  import { fillLot } from '@/lib/lot-view';

  const slug = (new URLSearchParams(window.location.search).get('id') ?? '').trim();

  const view = document.querySelector('[data-lot-view]');
  const missing = document.querySelector('[data-lot-missing]');
  const errorNote = document.querySelector('[data-lot-error]');
  const history = document.querySelector('[data-lot-history]');
  const suggestedEl = document.querySelector('[data-lot-suggested]');
  const suggestedLoginEl = document.querySelector('[data-lot-suggested-login]');
  const skeleton = document.querySelector('[data-lot-skeleton]');
  const statusEl = document.querySelector('[data-lot-status]');
  const list = document.querySelector('[data-history-list]');
  const emptyNote = document.querySelector('[data-history-empty]');
  /** `lastState` — для перекраски по балансу; `lastEntries` — перерисовка по uid. */
  let lastState: LotState | null = null;
  let lastEntries: SharedHistoryEntry[] = [];

  function toggle(el: Element | null, show: boolean): void {
    if (el instanceof HTMLElement) el.classList.toggle('hidden', !show);
  }

  /** Скелетон и его объявление живут только до первого ответа БД. */
  function hideSkeleton(): void {
    toggle(skeleton, false);
    if (statusEl) statusEl.textContent = '';
  }

  /** Лота нет (строки в БД нет) — не путать с недоступной БД. */
  function showMissing(): void {
    toggle(view, false);
    toggle(history, false);
    toggle(missing, true);
    toggle(errorNote, false);
    hideSkeleton();
    document.title = 'Лот не найден — AlysQueZone';
  }

  /** БД недоступна — не выдаём за «лота нет». */
  function showError(): void {
    toggle(view, false);
    toggle(history, false);
    toggle(missing, false);
    toggle(errorNote, true);
    hideSkeleton();
    document.title = 'Лот не загрузился — AlysQueZone';
  }

  function fillDetail(st: LotState): void {
    toggle(view, true);
    toggle(missing, false);
    toggle(errorNote, false);
    toggle(history, true);
    hideSkeleton();
    document.title = `${st.title} — AlysQueZone`;
    // Слоты Лота (заголовок с эмоутами, видео с раскладкой кадра, бейджи,
    // кнопка) — общий lib/lot-view.ts; раскладку кадра страницы лота
    // (широкое — во всю ширину, портрет/квадрат — «телефонная») читает
    // global.css по data-media-orientation.
    fillLot(view, st, { balance: live.balance() });
    // Автор привета — только в подробностях лота, в списках подписи нет.
    if (suggestedEl instanceof HTMLElement) {
      suggestedEl.classList.toggle('hidden', !st.suggested_by_login);
      if (suggestedLoginEl) suggestedLoginEl.textContent = st.suggested_by_login ?? '—';
    }
    lastState = st;
  }

  function renderSharedHistory(entries: SharedHistoryEntry[], uid: string | null): void {
    if (!list) return;
    list.querySelectorAll('[data-shared-entry]').forEach((el) => el.remove());
    const frag = document.createDocumentFragment();
    for (const h of entries) {
      const li = document.createElement('li');
      li.setAttribute('data-shared-entry', 'true');
      li.className =
        'border-2 border-stream bg-void px-3 py-2 shadow-[3px_3px_0_var(--color-milk)]';
      const mine = uid !== null && h.buyer_uid !== '' && h.buyer_uid === uid;
      li.textContent = `${h.from} → ${h.to} · ${h.price} 🍺${mine ? ' · ТВОЙ' : ''}`;
      frag.appendChild(li);
    }
    list.appendChild(frag);
    if (emptyNote instanceof HTMLElement) {
      emptyNote.classList.toggle('hidden', list.children.length > 0);
    }
  }

  let refreshing = false;
  /** Полная перерисовка деталей из снапшота + хвост перепродаж из БД. */
  async function refreshDetail(): Promise<void> {
    if (refreshing) return;
    refreshing = true;
    try {
      if (slug.length === 0) {
        showMissing();
        return;
      }
      const st = live.lot(slug);
      // Ответа БД ещё не было — не гадаем: держим скелетон.
      if (!st && !live.catalogKnown()) return;
      // Снапшот без ответа БД — не выдаём за «лота нет».
      if (!st && !live.catalogOk()) {
        showError();
        return;
      }
      if (!st) {
        showMissing();
        return;
      }
      fillDetail(st);
      lastEntries = await fetchSharedHistory(slug, st.owner_login);
      renderSharedHistory(lastEntries, live.uid());
    } finally {
      refreshing = false;
    }
  }

  // Снапшот живых данных — единственный источник: лот, uid и баланс.
  live.subscribe((change) => {
    if (change.kind === 'catalog' && (change.changed.has(slug) || lastState === null)) {
      void refreshDetail();
    }
    if (change.kind === 'uid') renderSharedHistory(lastEntries, change.uid);
    if (change.kind === 'balance' && lastState) {
      fillLot(view, lastState, { balance: change.balance });
    }
  });
</script>
