---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RulesModal from '@/components/RulesModal.astro';
import { ALYSQUE_WAUW } from '@/lib/emotes';

const base = import.meta.env.BASE_URL;
// Случайные приветы — 4 лота наугад из живого каталога БД, выбор в браузере
// (ребаланс: витрина не приедается, «топа» больше нет — дорогие лоты не
// караулят вход). Не хардкод.
---

<BaseLayout title="AlysQueZone — БИРЖА ПРИВЕТОВ">
  <!-- HERO (стиль C: пиксельный заголовок, INSERT COIN-бейдж, аркадные кнопки) -->
  <section class="card-pixel card-pixel-accent p-6 sm:p-10">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <p class="badge-pixel animate-blink bg-stream text-cream">▶ стрим включился, а ты?</p>
        <h1 class="font-display mt-5 text-base leading-loose uppercase sm:text-2xl sm:leading-loose">
          Биржа приветов.
          <br />
          Стрим включился, <span class="text-ember">а ты?</span>
        </h1>
        <p class="mt-4 max-w-xl text-base text-mist sm:text-lg">
          Привет стримера — это ценность. Выбирай лот, жми «купить» и забирай, пока чат не разобрал
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={`${base}lots/`} class="btn-arcade btn-arcade-primary px-6 py-3">
            ▶ К бирже
          </a>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            +1000 на старте
          </button>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            Ежедневный вход: до 500🍺
          </button>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            📜 Правила биржи
          </button>
        </div>
      </div>
      <!-- Вывеска «продам привет»: эмоут канала вместо чемодана. -->
      <div class="card-pixel w-full max-w-xs shrink-0 -rotate-1 bg-panel p-6 text-center">
        <div class="flex justify-center">
          <img
            src={ALYSQUE_WAUW}
            alt=""
            width="64"
            height="64"
            loading="eager"
            class="h-16 w-16 object-contain"
          />
        </div>
        <p class="badge-pixel mt-3 -rotate-3 bg-stream text-sm text-cream">
          продам привет
          <br />
          недорого
        </p>
      </div>
    </div>
  </section>

  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="mt-10">
    <h2 class="font-display text-xs uppercase sm:text-sm">Как это работает</h2>
    <ol class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-stream">01</p>
        <p class="mt-2 font-black uppercase">Выбираешь привет</p>
        <p class="mt-1 text-sm text-mist">Случайные лоты ниже — бери, пока чат не разобрал.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-ember">02</p>
        <p class="mt-2 font-black uppercase">Жмёшь «купить за Пивкойны»</p>
        <p class="mt-1 text-sm text-mist">Баланс в шапке, старт — 1000 Пивкойнов.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-pivko">03</p>
        <p class="mt-2 font-black uppercase">Привет твой</p>
        <p class="mt-1 text-sm text-mist">Чат в шоке!</p>
      </li>
    </ol>
  </section>

  <!-- СЛУЧАЙНЫЕ ПРИВЕТЫ -->
  <section class="mt-10">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-xs uppercase sm:text-sm">Случайные приветы</h2>
      <a href={`${base}lots/`} class="shrink-0 text-sm font-bold text-stream hover:underline">
        Все лоты →
      </a>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-random-lots></div>
    <p data-random-state class="mt-3 text-sm font-bold text-mist">
      Загружаю приветы…
    </p>
    <div class="card-pixel card-pixel-accent mt-8 p-6 text-center sm:p-8">
      <p class="font-display text-xs uppercase sm:text-sm">Готов забрать свой привет?</p>
      <a href={`${base}lots/`} class="btn-arcade btn-arcade-primary mt-4 px-8 py-3">
        ▶ На биржу
      </a>
    </div>
  </section>
  <RulesModal />
</BaseLayout>

<script>
  // Случайные приветы — из живого каталога БД, выбор в браузере (не на билде).
  import { getSessionUid, isSupabaseConfigured } from '@/lib/supabase';
  import { fetchLotCatalogResult } from '@/lib/lots';

  const slot = document.querySelector('[data-random-lots]');
  const note = document.querySelector('[data-random-state]');
  const PICK = 4;

  function setNote(text: string | null): void {
    if (!(note instanceof HTMLElement)) return;
    note.textContent = text ?? '';
    note.classList.toggle('hidden', text === null);
  }

  function miniCard(slug: string, title: string, owner: string | null, price: number): HTMLElement {
    const card = document.createElement('article');
    card.className =
      'card-pixel flex min-w-0 flex-col p-5 transition hover:-translate-y-0.5 motion-reduce:hover:translate-y-0';
    const h = document.createElement('h3');
    h.className = 'mt-3 font-extrabold break-words';
    // Карточка ведёт на страницу лота, как карточки витрины: иначе случайный
    // привет — тупик, открыть его нечем.
    const a = document.createElement('a');
    a.href = `${import.meta.env.BASE_URL}lot/?id=${encodeURIComponent(slug)}`;
    a.className = 'hover:text-ember';
    a.textContent = title;
    h.appendChild(a);
    card.appendChild(h);
    const ownerP = document.createElement('p');
    ownerP.className = 'mt-1 truncate text-sm text-mist';
    ownerP.textContent = `владелец: ${owner ?? '—'}`;
    card.appendChild(ownerP);
    const priceP = document.createElement('p');
    priceP.className = 'mt-3 text-xl font-black text-pivko';
    priceP.textContent = `${price} 🍺`;
    card.appendChild(priceP);
    return card;
  }

  async function renderRandom(): Promise<void> {
    if (!(slot instanceof HTMLElement)) return;
    const uid = await getSessionUid();
    const { ok, states } = await fetchLotCatalogResult(uid);
    const pool = [...states.values()];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j] as (typeof pool)[number], pool[i] as (typeof pool)[number]];
    }
    const pick = pool.slice(0, PICK);
    slot.replaceChildren(
      ...pick.map((st) => miniCard(st.slug, st.title, st.owner_login, st.price))
    );
    if (pick.length > 0) setNote(null);
    else setNote(ok ? 'Пока пусто — зайди на биржу' : 'Приветы не загрузились — проверь связь');
  }

  if (isSupabaseConfigured()) void renderRandom();
  else setNote('Приветы не загрузились — проверь связь');
</script>
