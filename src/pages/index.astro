---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RulesModal from '@/components/RulesModal.astro';
import BuyModal from '@/components/BuyModal.astro';
import LotCard from '@/components/LotCard.astro';
import LotCardSkeleton from '@/components/LotCardSkeleton.astro';
import BrandHeadline from '@/components/BrandHeadline.astro';
import { ALYSQUE_WAUW } from '@/lib/emotes';

const base = import.meta.env.BASE_URL;
// Случайные приветы — 4 лота наугад из живого каталога БД, выбор в браузере
// (ребаланс: витрина не приедается, «топа» больше нет — дорогие лоты не
// караулят вход). Не хардкод.
---

<BaseLayout title="AlysQueZone — БИРЖА ПРИВЕТОВ">
  <!-- HERO (стиль C: пиксельный заголовок, INSERT COIN-бейдж, аркадные кнопки) -->
  <section class="card-pixel card-pixel-accent p-6 sm:p-10">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <p class="badge-pixel animate-blink bg-stream text-cream">▶ стрим включился, а ты?</p>
        <BrandHeadline class="font-display mt-5 text-base leading-loose uppercase sm:text-2xl sm:leading-loose">
          Стрим включился, <span class="text-ember">а ты?</span>
        </BrandHeadline>
        <p class="mt-4 max-w-xl text-base text-mist sm:text-lg">
          Привет стримера — это ценность. Выбирай лот, жми «купить» и забирай, пока чат не разобрал
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href={`${base}lots/`} class="btn-arcade btn-arcade-primary px-6 py-3">
            ▶ К бирже
          </a>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            +1000 на старте
          </button>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            Ежедневный вход: до 500🍺
          </button>
          <button type="button" data-rules-button class="btn-arcade btn-arcade-ghost px-6 py-3">
            📜 Правила биржи
          </button>
        </div>
      </div>
      <!-- Вывеска «продам привет»: эмоут канала вместо чемодана. -->
      <div class="card-pixel w-full max-w-xs shrink-0 -rotate-1 bg-panel p-6 text-center">
        <div class="flex justify-center">
          <img
            src={ALYSQUE_WAUW}
            alt=""
            width="64"
            height="64"
            loading="eager"
            class="h-16 w-16 object-contain"
          />
        </div>
        <p class="badge-pixel mt-3 -rotate-3 bg-stream text-sm text-cream">
          продам привет
          <br />
          недорого
        </p>
      </div>
    </div>
  </section>

  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="mt-10">
    <h2 class="font-display text-xs uppercase sm:text-sm">Как это работает</h2>
    <ol class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-stream">01</p>
        <p class="mt-2 font-black uppercase">Выбираешь привет</p>
        <p class="mt-1 text-sm text-mist">Случайные лоты ниже — бери, пока чат не разобрал.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-ember">02</p>
        <p class="mt-2 font-black uppercase">Жмёшь «купить за Пивкойны»</p>
        <p class="mt-1 text-sm text-mist">Баланс в шапке, старт — 1000 Пивкойнов.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-pivko">03</p>
        <p class="mt-2 font-black uppercase">Привет твой</p>
        <p class="mt-1 text-sm text-mist">Чат в шоке!</p>
      </li>
    </ol>
  </section>

  <!-- СЛУЧАЙНЫЕ ПРИВЕТЫ -->
  <section class="mt-10">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-xs uppercase sm:text-sm">Случайные приветы</h2>
      <a href={`${base}lots/`} class="shrink-0 text-sm font-bold text-stream hover:underline">
        Все лоты →
      </a>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" data-random-lots>
      {Array.from({ length: 4 }, () => (
        <LotCardSkeleton />
      ))}
    </div>
    <p data-random-state class="mt-3 hidden text-sm font-bold text-mist"></p>
    <p data-random-status class="sr-only" role="status">
      Загружаю приветы…
    </p>
    <div class="card-pixel card-pixel-accent mt-8 p-6 text-center sm:p-8">
      <p class="font-display text-xs uppercase sm:text-sm">Готов забрать свой привет?</p>
      <a href={`${base}lots/`} class="btn-arcade btn-arcade-primary mt-4 px-8 py-3">
        ▶ На биржу
      </a>
    </div>
  </section>
  <RulesModal />
  <BuyModal />
  <!-- Шаблон случайной карточки: тот же LotCard, что на витрине (одно
       представление Лота), заполняет lib/lot-view.ts. -->
  <template data-lot-card-template>
    <LotCard />
  </template>
</BaseLayout>

<script>
  // Случайные приветы — из живого каталога БД, выбор в браузере (не на билде).
  // Карточки — каноничный LotCard (шаблон в разметке): слоты Лота и раскладку
  // кадра заполняет lib/lot-view.ts, как на витрине; цена и покупка — в кнопке,
  // модалка покупки на странице (BuyModal). Свой ручной miniCard удалён —
  // одно представление Лота на всех поверхностях (docs/adr/0009).
  import { getSessionUid, isSupabaseConfigured } from '@/lib/supabase';
  import { fetchLotCatalogResult, onBought, type LotState } from '@/lib/lots';
  import { fillLot } from '@/lib/lot-view';
  import { initLotVideos } from '@/lib/lot-video';
  import { fetchMyBalance, onBalance } from '@/lib/balance';

  const slot = document.querySelector('[data-random-lots]');
  const tpl = document.querySelector('[data-lot-card-template]');
  const note = document.querySelector('[data-random-state]');
  const status = document.querySelector('[data-random-status]');
  const PICK = 4;

  /** Баланс — зеркало гейта: не хватает — кнопки карточек гаснут. */
  let myBalance: number | null = null;
  /** Показанные карточки и их состояния — для перекраски без нового выбора. */
  let rendered = new Map<string, HTMLElement>();
  let lastStates = new Map<string, LotState>();

  function setNote(text: string | null): void {
    if (!(note instanceof HTMLElement)) return;
    note.textContent = text ?? '';
    note.classList.toggle('hidden', text === null);
  }

  /** Скринридеру: «Загружаю…» живёт только до первого ответа БД. */
  function setStatus(text: string): void {
    if (status instanceof HTMLElement) status.textContent = text;
  }

  /** Скелетоны — только на первую загрузку. */
  function clearSkeletons(): void {
    slot?.querySelectorAll('[data-lot-skeleton]').forEach((el) => el.remove());
  }

  /** Перекрасить уже показанные карточки из последнего снапшота. */
  function refill(): void {
    for (const [slug, card] of rendered) {
      const st = lastStates.get(slug);
      if (st) fillLot(card, st, { balance: myBalance });
    }
  }

  /** Выбрать случайные лоты и нарисовать их карточками LotCard. */
  function paintCards(states: Map<string, LotState>): void {
    if (!(slot instanceof HTMLElement) || !(tpl instanceof HTMLTemplateElement)) return;
    const pool = [...states.values()];
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j] as (typeof pool)[number], pool[i] as (typeof pool)[number]];
    }
    const cards: HTMLElement[] = [];
    rendered = new Map();
    for (const st of pool.slice(0, PICK)) {
      if (!Number.isFinite(st.price)) continue;
      const fresh = tpl.content.firstElementChild;
      if (!(fresh instanceof HTMLElement)) break;
      const card = fresh.cloneNode(true) as HTMLElement;
      fillLot(card, st, { balance: myBalance });
      rendered.set(st.slug, card);
      cards.push(card);
    }
    slot.replaceChildren(...cards);
    initLotVideos(slot);
  }

  async function renderRandom(): Promise<void> {
    if (!(slot instanceof HTMLElement)) return;
    const uid = await getSessionUid();
    myBalance = await fetchMyBalance();
    const { ok, states } = await fetchLotCatalogResult(uid);
    lastStates = states;
    clearSkeletons();
    paintCards(states);
    const msg =
      rendered.size > 0
        ? null
        : ok
          ? 'Пока пусто — зайди на биржу'
          : 'Приветы не загрузились — проверь связь';
    setNote(msg);
    setStatus(msg ?? '');
  }

  /** После своей покупки — свежий снапшот и перекраска тех же карточек. */
  async function refreshCards(): Promise<void> {
    if (!isSupabaseConfigured()) return;
    const uid = await getSessionUid();
    myBalance = await fetchMyBalance();
    const { states } = await fetchLotCatalogResult(uid);
    lastStates = states;
    refill();
  }

  if (isSupabaseConfigured()) {
    void renderRandom();
    onBought(() => void refreshCards());
    onBalance((value) => {
      myBalance = value;
      refill();
    });
  } else {
    const msg = 'Приветы не загрузились — проверь связь';
    clearSkeletons();
    setNote(msg);
    setStatus(msg);
  }
</script>
