---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchCatalogLots } from '../lib/lots.ts';

const base = import.meta.env.BASE_URL;
// Топ приветов — первые 4 лота каталога из БД на билде (тикет 09),
// без PUBLIC_SUPABASE_* билд падает явно. Не хардкод.
const topLots = (await fetchCatalogLots()).slice(0, 4);
---

<BaseLayout title="AlysQueZone — БИРЖА ПРИВЕТОВ">
  <!-- HERO (стиль C: пиксельный заголовок, INSERT COIN-бейдж, аркадные кнопки) -->
  <section class="card-pixel card-pixel-accent p-6 sm:p-10">
    <div class="flex flex-col items-start gap-8 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <p class="badge-pixel animate-blink bg-melon text-white">
          ▶ стрим включился, а ты?
        </p>
        <h1 class="font-display mt-5 text-base leading-loose uppercase sm:text-2xl sm:leading-loose">
          Биржа приветов.<br />Стрим включился, <span class="text-ember">а ты?</span>
        </h1>
        <p class="mt-4 max-w-xl text-base text-mist/80 sm:text-lg">
          Привет стримера — это ценность. Выбирай лот, жми «купить» и кайфуем жоско + мощно.
          Жду тебя 🙂🙂🙂
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href={`${base}lots/`}
            class="btn-arcade btn-arcade-primary px-6 py-3"
          >
            ▶ К бирже
          </a>
          <span class="btn-arcade btn-arcade-ghost px-6 py-3 text-mist/70">
            +1000 на старте
          </span>
          <span class="btn-arcade btn-arcade-ghost px-6 py-3 text-mist/70">
            Ежедневный вход: до 500🍺
          </span>
        </div>
        <p class="mt-3 text-sm text-mist/70">заходи каждый день — пропуск streak не сбрасывает</p>
      </div>
      <!-- Чемодан «продам привет» -->
      <div class="card-pixel w-full max-w-xs shrink-0 -rotate-1 bg-panel p-6 text-center">
        <div class="text-6xl" aria-hidden="true">🧳</div>
        <p class="badge-pixel mt-3 -rotate-3 bg-melon text-sm text-white">
          продам привет
        </p>
        <p class="mt-3 text-sm font-bold text-pivko">первый покупатель — первый владелец</p>
      </div>
    </div>
  </section>

  <!-- КАК ЭТО РАБОТАЕТ -->
  <section class="mt-10">
    <h2 class="font-display text-xs uppercase sm:text-sm">Как это работает</h2>
    <ol class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-stream">01</p>
        <p class="mt-2 font-black uppercase">Выбираешь привет</p>
        <p class="mt-1 text-sm text-mist/70">Топ лотов ниже — бери, пока чат не разобрал.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-ember">02</p>
        <p class="mt-2 font-black uppercase">Жмёшь «купить за Пивкойны»</p>
        <p class="mt-1 text-sm text-mist/70">Баланс в шапке, старт — 1000 Пивкойнов.</p>
      </li>
      <li class="card-pixel p-5">
        <p class="font-display text-[10px] text-pivko">03</p>
        <p class="mt-2 font-black uppercase">Привет твой</p>
        <p class="mt-1 text-sm text-mist/70">Чат в шоке, догон чатика обеспечен. Пойжем жоско!</p>
      </li>
    </ol>
  </section>

  <!-- ТОП ПРИВЕТОВ -->
  <section class="mt-10">
    <div class="flex items-end justify-between gap-4">
      <h2 class="font-display text-xs uppercase sm:text-sm">Топ приветов</h2>
      <a href={`${base}lots/`} class="shrink-0 text-sm font-bold text-stream hover:underline">
        Все лоты →
      </a>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        topLots.map((lot) => (
          <article class="card-pixel flex min-w-0 flex-col p-5 transition hover:-translate-y-0.5">
            <span
              class:list={[
                'badge-pixel w-fit',
                lot.rarity === 'rare' && 'bg-terra text-cream',
                lot.rarity === 'legendary' && 'bg-legend text-cream',
                lot.rarity === 'common' && 'bg-bar text-milk',
              ]}
            >
              {lot.rarity}
            </span>
            <h3 class="mt-3 font-extrabold break-words">{lot.title}</h3>
            <p class="mt-1 truncate text-sm text-mist/60">владелец: {lot.owner ?? '—'}</p>
            <p class="mt-3 text-xl font-black text-pivko">{lot.price} 🍺</p>
          </article>
        ))
      }
    </div>
    <div class="card-pixel card-pixel-accent mt-8 p-6 text-center sm:p-8">
      <p class="font-display text-xs uppercase sm:text-sm">Готов забрать свой привет?</p>
      <p class="mt-3 text-sm text-mist/70">Жду тебя 🙂🙂🙂 Пойжем жоско на стрим.</p>
      <a
        href={`${base}lots/`}
        class="btn-arcade btn-arcade-primary mt-4 px-8 py-3"
      >
        ▶ На биржу
      </a>
    </div>
  </section>
</BaseLayout>
